{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PGHOST": "127.0.0.1",
    "PGUSER": "postgres"
  },
  "permissions": {
    "allow": [
      "Edit(./src/**)",
      "Edit(./netlify/**)",
      "Edit(./test/**)",
      "Edit(./supabase/**)",
      "Edit(./scripts/**)",
      "Edit(./docs/**)",
      "Edit(./CLAUDE.md)",

      "Bash(node test/*)",
      "Bash(npm run build)",
      "Bash(npm ci)",
      "Bash(npm ls *)",
      "Bash(npx @11ty/eleventy *)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git stash list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git merge *)",

      "Bash(service postgresql start)",
      "Bash(service postgresql status)",
      "Bash(pg_lsclusters)",
      "Bash(psql -h 127.0.0.1 *)",
      "Bash(psql -h localhost *)",

      "Bash(sha256sum *)",
      "Bash(md5sum *)",
      "Bash(tail *)",

      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:docs.netlify.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:www.homecareproviderservices.org)",

      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__tabs_close_mcp",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",

      "mcp__memory__memory_list",
      "mcp__memory__memory_read",
      "mcp__Claude_Docs__read",
      "mcp__Claude_Docs__query",
      "mcp__Claude_Docs__guide",
      "mcp__claude-code-remote__list_repos",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude_ai__current_time"
    ],
    "ask": [
      "Bash(psql postgres://*)",
      "Bash(psql postgresql://*)",
      "Bash(gh pr merge *)",
      "Bash(netlify deploy *)",
      "Bash(netlify env:set *)",
      "Bash(netlify env:unset *)",
      "Bash(supabase db push *)",
      "Bash(supabase db reset *)",
      "Bash(supabase migration up *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.session_ingress_token)",
      "Edit(./src/_data/documents.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
