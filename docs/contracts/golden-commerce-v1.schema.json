{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "golden-commerce-v1.schema.json",
  "title": "Golden Commerce API v1 — wire schemas (routes built through batch B3 (configurator 1.3.0))",
  "contract_version": "1.3.0",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "envelope": {
      "type": "object",
      "required": [
        "contract_version",
        "tenant",
        "request_id"
      ],
      "properties": {
        "contract_version": {
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0"
          ]
        },
        "tenant": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "pattern": "^req_"
        }
      }
    },
    "error": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "see_prices",
        "order",
        "history"
      ],
      "properties": {
        "see_prices": {
          "type": "boolean"
        },
        "order": {
          "type": "boolean"
        },
        "history": {
          "type": "boolean"
        }
      }
    },
    "delegation": {
      "type": "object",
      "required": [
        "sub_dealer",
        "role",
        "aud",
        "iat",
        "exp"
      ],
      "properties": {
        "sub_dealer": {
          "$ref": "#/$defs/uuid"
        },
        "sub_branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "type": "string",
          "maxLength": 128
        },
        "role": {
          "enum": [
            "dealer",
            "dealer_admin",
            "branch_user",
            "staff_preview",
            "hcps_staff"
          ]
        },
        "aud": {
          "const": "golden-commerce-v1"
        },
        "iat": {
          "type": "integer"
        },
        "exp": {
          "type": "integer"
        }
      }
    },
    "health_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "status",
        "capabilities"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "capabilities": {
          "type": "object",
          "required": [
            "eligibility",
            "identity_assign",
            "catalog",
            "quote",
            "orders",
            "history"
          ],
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "eligibility_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "state",
        "capabilities"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "browse_only",
            "account"
          ]
        },
        "reason": {
          "enum": [
            "no_verified_link",
            "golden_account_inactive"
          ]
        },
        "link_id": {
          "$ref": "#/$defs/uuid"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "order_route": {
          "enum": [
            null,
            "direct",
            "review"
          ]
        },
        "multi_location": {
          "type": "boolean"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "customer_no"
            ]
          },
          {
            "required": [
              "terms"
            ]
          },
          {
            "required": [
              "email"
            ]
          },
          {
            "required": [
              "golden_dealer_id"
            ]
          }
        ]
      }
    },
    "identity_assign_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "golden_dealer_id",
        "hcps_dealer_id",
        "evidence"
      ],
      "properties": {
        "golden_dealer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
        },
        "hcps_dealer_id": {
          "$ref": "#/$defs/uuid"
        },
        "customer_no": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "enum": [
                "account_number",
                "federation_event",
                "manual"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            }
          }
        }
      }
    },
    "identity_assign_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "result",
        "link_id",
        "status"
      ],
      "properties": {
        "result": {
          "enum": [
            "proposed",
            "unchanged"
          ]
        },
        "link_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": [
            "proposed",
            "verified"
          ]
        }
      }
    },
    "catalog_product": {
      "type": "object",
      "required": [
        "sku",
        "family",
        "family_name",
        "name",
        "category",
        "subcategory",
        "specs",
        "class_ii",
        "badges",
        "action",
        "image",
        "msrp",
        "emap",
        "sort"
      ],
      "properties": {
        "sku": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "family_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "Lift Chairs",
            "Scooters",
            "Power Wheelchairs",
            "Beds"
          ]
        },
        "subcategory": {
          "type": "string"
        },
        "size_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zones": {
          "type": [
            "string",
            "null"
          ]
        },
        "class_ii": {
          "type": "boolean"
        },
        "ribbon": {
          "type": [
            "string",
            "null"
          ]
        },
        "color_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "badges": {
          "type": "object",
          "required": [
            "is_new",
            "is_featured",
            "is_best_seller",
            "top_new"
          ],
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "brochure_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "action": {
          "enum": [
            "configure",
            "add",
            "none"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "msrp": {
          "type": [
            "number",
            "null"
          ]
        },
        "emap": {
          "type": [
            "number",
            "null"
          ]
        },
        "dealer_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "price_source": {
          "enum": [
            "promo",
            "account",
            "standard",
            null
          ]
        },
        "sort": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "catalog_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "as_of",
        "etag",
        "catalog_version",
        "prices_visible",
        "linked",
        "products"
      ],
      "properties": {
        "as_of": {
          "type": "string"
        },
        "etag": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "catalog_version": {
          "type": "string"
        },
        "prices_visible": {
          "type": "boolean"
        },
        "linked": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalog_product"
          }
        }
      }
    },
    "inventory_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "as_of",
        "stale",
        "low_stock_threshold",
        "items"
      ],
      "properties": {
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "low_stock_threshold": {
          "type": "integer"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sku",
              "status",
              "qty"
            ],
            "additionalProperties": false,
            "properties": {
              "sku": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "in",
                  "low",
                  "out",
                  "on_request"
                ]
              },
              "qty": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "family_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "as_of",
        "etag",
        "enrichment_as_of",
        "prices_visible",
        "linked",
        "family"
      ],
      "properties": {
        "as_of": {
          "type": "string"
        },
        "etag": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "enrichment_as_of": {
          "type": "string"
        },
        "prices_visible": {
          "type": "boolean"
        },
        "linked": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": "object",
          "required": [
            "family",
            "name",
            "category",
            "skus",
            "gallery",
            "specs",
            "features",
            "documents",
            "videos",
            "fabrics",
            "related",
            "enriched"
          ],
          "properties": {
            "family": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "subcategory": {
              "type": [
                "string",
                "null"
              ]
            },
            "skus": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/catalog_product"
              }
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sell_sheet_description": {
              "type": [
                "string",
                "null"
              ]
            },
            "gallery": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "url",
                  "role",
                  "skus",
                  "primary"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "role": {
                    "type": "string"
                  },
                  "skus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "primary": {
                    "type": "boolean"
                  },
                  "shared": {
                    "type": "boolean"
                  },
                  "w": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "h": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "quality": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "specs": {
              "type": "object",
              "required": [
                "columns",
                "rows"
              ],
              "properties": {
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "values"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "values": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "key": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "basis": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "compare": {
              "type": "object"
            },
            "features": {
              "type": "object",
              "required": [
                "standard",
                "optional",
                "none_published"
              ],
              "properties": {
                "standard": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "optional": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "none_published": {
                  "type": "boolean"
                }
              }
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "title",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "sell_sheet",
                      "accessories_sheet",
                      "brochure",
                      "owners_manual",
                      "quick_start",
                      "option_manual",
                      "warranty",
                      "setup_instructions",
                      "document"
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://"
                  },
                  "language": {
                    "type": "string"
                  },
                  "pages": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "videos": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "youtube_id",
                  "embed"
                ],
                "properties": {
                  "youtube_id": {
                    "type": "string",
                    "pattern": "^[\\w-]{11}$"
                  },
                  "embed": {
                    "type": "string",
                    "pattern": "^https://www\\.youtube-nocookie\\.com/embed/"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "fabrics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "code",
                  "name"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "swatch": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^https://"
                  }
                }
              }
            },
            "related": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "enriched": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "config_200": {
      "allOf": [
        {
          "$ref": "#/$defs/envelope"
        }
      ],
      "type": "object",
      "required": [
        "as_of",
        "etag",
        "engine",
        "prices_visible",
        "linked",
        "config"
      ],
      "properties": {
        "as_of": {
          "type": "string"
        },
        "etag": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "engine": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "prices_visible": {
          "type": "boolean"
        },
        "linked": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "rules_type",
            "sku",
            "tier",
            "sizes",
            "tabs",
            "tiers",
            "footrest",
            "low_stock_threshold"
          ],
          "properties": {
            "model": {
              "type": "string"
            },
            "rules_type": {
              "enum": [
                "configurable",
                "prebuilt",
                "limited"
              ]
            },
            "sku": {
              "type": "string"
            },
            "tier": {
              "enum": [
                "standard",
                "irheat",
                "hvib",
                "nirvana"
              ]
            },
            "low_stock_threshold": {
              "type": "integer"
            },
            "sizes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sku",
                  "code",
                  "label"
                ],
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "msrp": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "status": {
                    "enum": [
                      "in",
                      "out",
                      null
                    ]
                  },
                  "qty": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "dealer_price": {
                    "type": "number"
                  }
                }
              }
            },
            "tabs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "label",
                  "colors"
                ],
                "properties": {
                  "key": {
                    "enum": [
                      "std",
                      "xover",
                      "brisa"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "upcharge": {
                    "type": "number"
                  },
                  "colors": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "name",
                        "status"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[A-Z0-9]{3}$"
                        },
                        "name": {
                          "type": "string"
                        },
                        "hex": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "swatch": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "status": {
                          "enum": [
                            "in",
                            "low",
                            "out"
                          ]
                        },
                        "qty": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            },
            "tiers": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "included",
                "options"
              ],
              "properties": {
                "included": {
                  "type": "boolean"
                },
                "included_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "prebuilt_status"
                    ],
                    "properties": {
                      "key": {
                        "enum": [
                          "standard",
                          "irheat",
                          "hvib",
                          "nirvana"
                        ]
                      },
                      "msrp": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "prebuilt_status": {
                        "enum": [
                          "in",
                          "none"
                        ]
                      },
                      "prebuilt": {
                        "type": "integer"
                      },
                      "upcharge": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            "footrest": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eligible"
              ],
              "properties": {
                "eligible": {
                  "type": "boolean"
                },
                "part": {
                  "type": "string"
                },
                "upcharge": {
                  "type": "number"
                }
              }
            },
            "quote": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ok"
              ],
              "properties": {
                "ok": {
                  "const": true
                },
                "sku": {
                  "type": "string"
                },
                "fabric": {
                  "enum": [
                    "std",
                    "xover",
                    "brisa"
                  ]
                },
                "color": {
                  "type": "string"
                },
                "color_name": {
                  "type": "string"
                },
                "tier": {
                  "type": "string"
                },
                "footrest": {
                  "type": "boolean"
                },
                "lead_note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "in_stock": {
                  "type": "boolean"
