<!-- CONTACT FORM -->
<section class="co-sec alt" id="contact-form">
  <div class="container">
    <div class="co-head">
      <p class="co-kicker">Send us a message</p>
      <h2 class="co-h2">Tell us what you need</h2>
      <p class="co-sub">Choose a reason so we can route your message to the right team and follow up quickly.</p>
    </div>

    <div class="co-form-wrap">
      <form id="hcps-contact" class="co-form" novalidate>
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
        <input type="hidden" name="route" id="c-route" value="">
        <div>
          <label for="c-interest">Reason for contact *</label>
          <select id="c-interest" name="interest">
            <option value="">Select a reason…</option>
            <option value="Dealer Support">Dealer Support</option>
            <option value="Product or Pricing Selection Requested">Product or Pricing Selection Requested</option>
            <option value="Online Ordering Support">Online Ordering Support</option>
            <option value="Schedule an In-Service">Schedule an In-Service</option>
            <option value="Showroom Consultation">Showroom Consultation</option>
            <option value="Become a Dealer">Become a Dealer</option>
            <option value="Become a Manufacturing Partner">Become a Manufacturing Partner</option>
            <option value="Business Development">Business Development</option>
            <option value="General Question">General Question</option>
          </select>
        </div>
        <div class="form-row">
          <div><label for="c-company">Company / Organization *</label><input id="c-company" name="company" type="text" required></div>
          <div><label for="c-name">Contact name *</label><input id="c-name" name="name" type="text" required></div>
        </div>
        <div class="form-row">
          <div><label for="c-email">Email *</label><input id="c-email" name="email" type="email" required></div>
          <div><label for="c-phone">Phone</label><input id="c-phone" name="phone" type="tel"></div>
        </div>
        <div class="form-row">
          <div><label for="c-state">State</label><input id="c-state" name="state" type="text" maxlength="24" placeholder="e.g. OH"></div>
          <div><label for="c-manu">Manufacturer (if applicable)</label>
            <select id="c-manu" name="manufacturer">
              <option value="">All / not sure</option>
              {% for m in activeManufacturers %}<option value="{{ m.name }}">{{ m.name }}</option>{% endfor %}
            </select>
          </div>
        </div>
        <div>
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" placeholder="Tell us what you're looking for — products, pricing, representation, showroom support, training, or ordering access."></textarea>
        </div>
        <div>
          <button type="submit" class="btn-primary" id="c-submit">Send Message</button>
          <p class="form-status" id="c-status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="co-aside">
        <h3>Reach us directly</h3>
        <p>Prefer a call or email? Our team is standing by during business hours.</p>
        <div class="co-contact-line"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1A19.5 19.5 0 0 1 5 12.8 19.8 19.8 0 0 1 1.9 4.2 2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.1a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg><a href="tel:{{ site.contact.phone_href }}">{{ site.contact.phone_display }}</a></div>
        <div class="co-contact-line"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></div>
        <div class="co-quick">
          <a href="?reason=Schedule%20an%20In-Service#contact-form">Schedule an In-Service <span>&rarr;</span></a>
          <a href="?reason=Showroom%20Consultation#contact-form">Request a Showroom Consultation <span>&rarr;</span></a>
          <a href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Access HCPS Partner 360 <span>&rarr;</span></a>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- FOOTER BAND -->
<section class="co-sec">
  <div class="container">
    <div class="co-band">
      <div>
        <h3>Dealers, manufacturers, and everything in between.</h3>
        <p>HCPS is your connection point for sales growth, marketing, training, showroom development, and business development — one team, ready to help you find the right solution.</p>
      </div>
      <div class="co-band-cta">
        <a class="co-btn primary" href="/become-a-dealer/">Become an HCPS Dealer &rarr;</a>
        <a class="co-btn ghost" style="border-color:rgba(255,255,255,.3);color:#fff;" href="/become-a-manufacturer-partner/">Become a Manufacturing Partner</a>
      </div>
    </div>
  </div>
</section>

{% set relatedPages = [
  { href: "/dealer-hub/", label: "Dealer Hub", blurb: "Book services, pricing & ordering access." },
  { href: "/become-a-dealer/", label: "Become a Dealer", blurb: "Join the HCPS dealer network." },
  { href: "/manufacturers/", label: "Manufacturers", blurb: "Browse the HME & DME lines we represent." }
] %}
{% include "related.njk" %}

<script>
(function () {
  var form = document.getElementById("hcps-contact");
  var status = document.getElementById("c-status");
  var submit = document.getElementById("c-submit");
  var interest = document.getElementById("c-interest");
  var routeField = document.getElementById("c-route");

  // Map the reason to a CRM audience/route hint so the inquiry can be segmented downstream.
  var ROUTE = {
    "Dealer Support":"Dealer", "Product or Pricing Selection Requested":"Dealer", "Online Ordering Support":"Dealer",
    "Schedule an In-Service":"Dealer", "Showroom Consultation":"Dealer", "Business Development":"Dealer",
    "Become a Dealer":"Prospect", "Become a Manufacturing Partner":"Manufacturer", "General Question":"General"
  };
  function setRoute(){ routeField.value = ROUTE[interest.value] || ""; }
  interest.addEventListener("change", setRoute);

  function selectReason(val){
    for (var i = 0; i < interest.options.length; i++) {
      if (interest.options[i].value === val) { interest.selectedIndex = i; break; }
    }
    setRoute();
  }

  // Reason cards pre-select the reason and scroll to the form.
  document.querySelectorAll(".co-jump").forEach(function (btn) {
    btn.addEventListener("click", function () {
      selectReason(btn.getAttribute("data-interest"));
      document.getElementById("contact-form").scrollIntoView({ behavior: "smooth" });
      setTimeout(function () { var f=document.getElementById("c-company"); if(f) f.focus(); }, 420);
    });
  });

  // Pre-select via ?reason= or ?topic= (from other pages / quick links).
  var params = new URLSearchParams(location.search);
  var pre = params.get("reason") || params.get("topic");
  if (pre) {
    var lc = pre.toLowerCase();
    for (var i = 0; i < interest.options.length; i++) {
      if (interest.options[i].value.toLowerCase().indexOf(lc) !== -1) { interest.selectedIndex = i; break; }
    }
    setRoute();
  }

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    status.textContent = "";
    var data = Object.fromEntries(new FormData(form).entries());
    if (!data.name || !data.company || !data.email) {
      status.className = "form-status error";
      status.textContent = "Please fill in company, contact name, and email.";
      return;
    }
    submit.disabled = true;
    var original = submit.textContent;
    submit.textContent = "Sending…";
    try {
      var res = await fetch("/.netlify/functions/contact", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data)
      });
      var out = await res.json();
      if (res.ok && out.ok) {
        form.reset(); setRoute();
        status.className = "form-status ok";
        status.textContent = "Thank you — your message has been sent. We'll route it to the right team and be in touch shortly.";
      } else {
        status.className = "form-status error";
        status.textContent = out.error || "Something went wrong. Please email info@homecareproviderservices.us.";
      }
    } catch (err) {
      status.className = "form-status error";
      status.textContent = "Network error. Please email info@homecareproviderservices.us.";
    } finally {
      submit.disabled = false;
      submit.textContent = original;
    }
  });
})();
</script>
