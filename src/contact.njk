        <ul class="co-list">
          <li>Showroom consulting</li>
          <li>Product mix optimization</li>
          <li>Sales growth strategies</li>
          <li>Marketing support</li>
          <li>Website &amp; digital business development</li>
          <li>Dealer growth planning</li>
        </ul>
        <div class="co-card-cta">
          <button type="button" class="go co-jump" data-interest="Business Development">Request Business Development &rarr;</button>
          <a class="txt" href="/consulting/">Consulting</a>
        </div>
      </article>

      <!-- Become a Dealer -->
      <article class="co-card">
        <div class="co-ico-top"><img src="/assets/contact/become-a-dealer.png" alt="" loading="lazy"></div>
        <h3>Become a Dealer</h3>
        <p class="blurb">Join the HCPS dealer network and start ordering premium HME &amp; DME lines.</p>
        <ul class="co-list">
          <li>New dealer account requests</li>
          <li>Manufacturer account setup</li>
          <li>Credit applications</li>
          <li>Pricing access</li>
          <li>Online ordering access</li>
        </ul>
        <div class="co-card-cta">
          <a class="go" href="/become-a-dealer/" style="text-decoration:none;display:inline-flex;align-items:center;">Become an HCPS Dealer &rarr;</a>
          <button type="button" class="txt co-jump" style="background:none;border:none;cursor:pointer;" data-interest="Become a Dealer">Ask a question</button>
        </div>
