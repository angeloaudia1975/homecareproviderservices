---
layout: layouts/base.njk
title: Contact Us
permalink: /contact/
description: "Get in touch with HomeCare Provider Services for manufacturer-specific questions, dealer support, business development needs, or information about becoming a manufacturing partner. Whether you are part of our dealer network or a manufacturer looking to expand your reach, our team is here to help you grow, strengthen your business, and find the right solutions."
---
<style>
  .co-hero{position:relative;overflow:hidden;background:linear-gradient(150deg,#0c2740 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:48px 0 50px;perspective:1500px;}
  .co-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.26),transparent 62%);pointer-events:none;}
  .co-hero .container{position:relative;z-index:1;}
  .co-eyebrow{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:7px 15px;font-family:'Archivo',sans-serif;font-weight:800;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 15px;}
  .co-hero h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(30px,4.4vw,50px);line-height:1.05;margin:0 0 14px;max-width:18ch;}
  .co-hero .co-lead{font-size:clamp(15.5px,1.4vw,18px);line-height:1.55;color:rgba(255,255,255,.9);max-width:74ch;margin:0 0 24px;}
  .co-cta-row{display:flex;gap:11px;flex-wrap:wrap;align-items:center;}
  .co-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:14.5px;text-decoration:none;border-radius:11px;padding:13px 22px;transition:transform .12s,box-shadow .12s;border:1px solid transparent;cursor:pointer;}
  .co-btn:hover{transform:translateY(-1px);}
  .co-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .co-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.28);}
  .co-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .co-btn.blue{background:var(--hcps-blue,#1681c2);color:#fff;}
  .co-btn.sm{padding:10px 16px;font-size:13px;}

  .co-sec{padding:52px 0;}
  .co-sec.alt{background:var(--paper,#f6f7f5);}
  .co-head{max-width:66ch;margin:0 0 30px;}
  .co-kicker{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hcps-blue,#1681c2);margin:0 0 9px;}
  .co-h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(23px,2.9vw,34px);line-height:1.1;color:var(--ink);margin:0 0 11px;}
  .co-sub{font-size:15.5px;line-height:1.55;color:#48525c;margin:0;}

  .co-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  @media(max-width:820px){.co-grid{grid-template-columns:1fr;}}
  .co-card{background:#fff;border:1px solid #e5e9ee;border-radius:18px;padding:28px 26px;box-shadow:0 10px 30px rgba(12,39,64,.05);display:flex;flex-direction:column;transition:transform .14s,box-shadow .14s,border-color .14s;}
  .co-card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(12,39,64,.1);border-color:#cfe0ef;}
  /* Big icon on top — full card width (matches Dealer Services category cards) */
  .co-ico-top{width:100%;margin:2px 0 12px;}
  .co-ico-top img{display:block;width:82%;max-width:210px;margin:0 auto;aspect-ratio:1/1;object-fit:contain;filter:drop-shadow(0 10px 18px rgba(12,39,64,.14));transition:transform .18s ease;}
  .co-card:hover .co-ico-top img{transform:translateY(-4px) scale(1.04);}
  .co-ico-top::after{content:"";display:block;height:4px;width:60px;margin:12px auto 0;border-radius:3px;background:var(--hcps-blue,#1681c2);}
  .co-card.o .co-ico-top::after{background:var(--hcps-orange,#ef6325);}
  .co-card h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:20px;color:var(--ink);margin:0 0 6px;line-height:1.12;text-align:center;}
  .co-card p.blurb{font-size:14.5px;line-height:1.55;color:#55606a;margin:0 0 16px;text-align:center;}
  .co-list{list-style:none;padding:0;margin:0 0 20px;display:grid;gap:9px;}
  .co-list li{position:relative;padding-left:27px;font-size:14px;line-height:1.4;color:#33404b;}
  .co-list li::before{content:"";position:absolute;left:0;top:1px;width:17px;height:17px;border-radius:50%;background:var(--hcps-blue,#1681c2) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>") center/10px no-repeat;}
  .co-card.o .co-list li::before{background-color:var(--hcps-orange,#ef6325);}
  .co-card-cta{margin-top:auto;display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
  .co-card-cta .go{font-family:'Archivo',sans-serif;font-weight:800;font-size:13.5px;text-decoration:none;padding:10px 16px;border-radius:9px;background:var(--hcps-blue,#1681c2);color:#fff;border:none;cursor:pointer;}
  .co-card.o .co-card-cta .go{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;}
  .co-card-cta a.txt{font-family:'Archivo',sans-serif;font-weight:800;font-size:13.5px;color:var(--hcps-orange,#ef6325);text-decoration:none;}
  .co-card-cta a.txt:hover{text-decoration:underline;}

  .co-form-wrap{display:grid;grid-template-columns:1.4fr .9fr;gap:26px;align-items:start;}
  @media(max-width:900px){.co-form-wrap{grid-template-columns:1fr;}}
  .co-form{background:#fff;border-radius:20px;padding:30px;box-shadow:0 20px 50px rgba(12,39,64,.1);border:1px solid #e5e9ee;}
  .co-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media(max-width:560px){.co-form .form-row{grid-template-columns:1fr;}}
  .co-form label{display:block;font-family:'Archivo',sans-serif;font-weight:700;font-size:13px;color:var(--ink);margin:14px 0 6px;}
  .co-form input,.co-form select,.co-form textarea{width:100%;box-sizing:border-box;padding:12px 13px;border:1px solid #d7dde3;border-radius:10px;font-size:15px;font-family:'Inter',sans-serif;color:var(--ink);background:#fff;}
  .co-form textarea{min-height:110px;resize:vertical;}
  .co-form input:focus,.co-form select:focus,.co-form textarea:focus{outline:none;border-color:var(--hcps-blue,#1681c2);box-shadow:0 0 0 3px rgba(22,129,194,.15);}
  .co-form .form-status{margin:12px 0 0;font-size:14px;font-weight:600;}
  .co-form .form-status.ok{color:#166b45;}
  .co-form .form-status.error{color:#b42323;}
  .co-form .btn-primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;font-family:'Archivo',sans-serif;font-weight:800;font-size:15px;border:none;border-radius:11px;padding:14px 24px;cursor:pointer;margin-top:16px;box-shadow:0 12px 26px -12px rgba(239,99,37,.7);}
  .co-aside{background:linear-gradient(150deg,#0c2740,#0f5c8f);color:#fff;border-radius:20px;padding:28px;}
  .co-aside h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:17px;margin:0 0 6px;color:#fff;}
  .co-aside p{font-size:14px;color:rgba(255,255,255,.85);margin:0 0 18px;line-height:1.5;}
  .co-contact-line{display:flex;align-items:center;gap:10px;margin:0 0 12px;font-size:14.5px;}
  .co-contact-line a{color:#fcb21e;font-weight:800;text-decoration:none;}
  .co-contact-line svg{width:18px;height:18px;flex:none;color:#fcb21e;}
  .co-aside .co-quick{margin-top:20px;border-top:1px solid rgba(255,255,255,.14);padding-top:16px;display:grid;gap:9px;}
  .co-aside .co-quick a{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#fff;text-decoration:none;font-weight:700;font-size:13.5px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:11px 14px;transition:.13s;}
  .co-aside .co-quick a:hover{background:rgba(255,255,255,.13);}

  .co-band{background:linear-gradient(150deg,#12181d,#243746);color:#fff;border-radius:20px;padding:34px 38px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;box-shadow:0 20px 50px rgba(12,39,64,.14);}
  .co-band h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(19px,2.3vw,26px);margin:0 0 6px;color:#fff;}
  .co-band p{margin:0;color:rgba(255,255,255,.85);font-size:14.5px;max-width:60ch;}
  .co-band-cta{display:flex;gap:10px;flex-wrap:wrap;}

  /* Depth hero: banner (interactive 3D tilt) -> headline -> CTAs */
  .co-hero-img{max-width:1000px;margin:0 auto;border-radius:18px;overflow:hidden;aspect-ratio:1672/941;background:url("/assets/contact/hero-banner.jpg") center/cover;box-shadow:0 45px 85px -22px rgba(0,0,0,.6);transform-style:preserve-3d;transition:transform .18s ease-out;will-change:transform;position:relative;}
  .co-hero-glare{position:absolute;inset:0;pointer-events:none;background:radial-gradient(300px 300px at var(--mx,50%) var(--my,30%),rgba(255,255,255,.28),transparent 60%);mix-blend-mode:screen;opacity:0;transition:opacity .2s;}
  .co-hero-copy{max-width:1040px;margin:28px auto 0;text-align:center;}
  .co-hero-copy h1{white-space:nowrap;max-width:none;font-size:clamp(20px,3vw,34px);margin:0 0 12px;}
  .co-hero-copy .co-lead{margin:0 auto 22px;max-width:80ch;}
  .co-hero .co-cta-row{justify-content:center;}
  .co-ico-img{flex:none;width:58px;height:58px;object-fit:contain;}
  @media(max-width:600px){.co-hero-copy h1{white-space:normal;}}
  @media(prefers-reduced-motion:reduce){.co-hero-img{transition:none;}}
</style>

<!-- HERO -->
<section class="co-hero">
  <div class="container">
    <div class="co-hero-img" id="co-heroimg" role="img" aria-label="Contact HomeCare Provider Services — HME &amp; DME Representation. Your Partner. Your Success. Dealer support, manufacturer partnerships, business development, and a dedicated team here to help. Call (270) 991-1403 or email info@homecareproviderservices.org."><span class="co-hero-glare"></span></div>
    <div class="co-hero-copy">
      <h1>Let's find the right solution for you.</h1>
      <p class="co-lead">Get in touch for manufacturer-specific questions, dealer support, business development, or becoming a manufacturing partner. Whether you're part of our dealer network or a manufacturer looking to expand your reach, our team is here to help you grow, strengthen your business, and find the right solutions.</p>
      <div class="co-cta-row">
        <a class="co-btn primary" href="#contact-form">Contact Dealer Support &rarr;</a>
        <a class="co-btn ghost" href="/become-a-dealer/">Become an HCPS Dealer</a>
        <a class="co-btn ghost" href="/become-a-manufacturer-partner/">Become a Manufacturing Partner</a>
      </div>
    </div>
  </div>
</section>
<script>
(function () {
  var img = document.getElementById("co-heroimg"); if (!img) return;
  var band = img.closest(".co-hero") || img.parentElement;
  var glare = img.querySelector(".co-hero-glare");
  var reduce = false; try { reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}
  if (reduce) return;
  band.addEventListener("mousemove", function (e) {
    var r = img.getBoundingClientRect();
    var px = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
    var py = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));
    var ry = (px - 0.5) * 14, rx = (0.5 - py) * 10;
    img.style.transform = "perspective(1500px) rotateY(" + ry + "deg) rotateX(" + rx + "deg) translateZ(20px)";
    if (glare) { glare.style.setProperty("--mx", (px * 100) + "%"); glare.style.setProperty("--my", (py * 100) + "%"); glare.style.opacity = "1"; }
  });
  band.addEventListener("mouseleave", function () {
    img.style.transform = "perspective(1500px) rotateY(0) rotateX(0)";
    if (glare) glare.style.opacity = "0";
  });
})();
</script>

<!-- AUDIENCE / REASON CARDS -->
<section class="co-sec">
  <div class="container">
    <div class="co-head">
      <p class="co-kicker">How can we help?</p>
      <h2 class="co-h2">Choose the reason you're reaching out</h2>
      <p class="co-sub">HCPS supports dealers and manufacturers across sales growth, marketing, training, showroom development, and business development. Pick the path that fits — we'll route your inquiry to the right person.</p>
    </div>
    <div class="co-grid">

      <!-- Dealer Support -->
      <article class="co-card">
        <div class="co-ico-top"><img src="/assets/contact/dealer-support.png" alt="" loading="lazy"></div>
        <h3>Dealer Support</h3>
        <p class="blurb">For active HCPS dealers — get answers, access, and hands-on help fast.</p>
        <ul class="co-list">
          <li>Manufacturer-specific questions</li>
          <li>Pricing and product information</li>
          <li>Online ordering assistance</li>
          <li>Literature and resources</li>
          <li>Technical support coordination</li>
          <li>In-service and training requests</li>
        </ul>
        <div class="co-card-cta">
          <button type="button" class="go co-jump" data-interest="Dealer Support">Contact Dealer Support &rarr;</button>
          <a class="txt" href="/dealer-hub/">Dealer Support page</a>
        </div>
      </article>

      <!-- Business Development -->
      <article class="co-card o">
