{# Concept B — Modern Training Dashboard: split hero (copy left, lifestyle photo in the depth frame with the live
   dashboard card floating over it), dashboard features first, course cards, timeline, pricing, CTA. #}
{% import "academy/sections.njk" as S %}
{% set L = academyLanding %}
<div class="ta ta-b">
<section class="ta-hero">
  <div class="wrap ta-split">
    <div data-reveal="up">
      <p class="kicker">{{ L.hero.eyebrow }}</p>
      <h1>{{ L.hero.headline }}</h1>
      <p class="lead">{{ L.hero.lead }}</p>
      <div class="ta-actions"><a class="ta-btn primary" href="{{ L.hero.cta1_url or '/academy/' }}">{{ L.hero.cta1_label }}</a><a class="ta-btn ghost" href="#courses">{{ L.hero.cta2_label }}</a></div>
      <div class="ta-chips">{% for s in L.hero.stats %}<span>{{ s.value }} {{ s.label }}</span>{% endfor %}</div>
    </div>
    <div class="ta-stage">
      <div class="ta-tilt"><img src="{{ L.hero.side_image }}" alt="{{ L.hero.side_image_alt }}" width="1000" height="810" fetchpriority="high"><span class="ta-glare"></span></div>
      <div class="ta-float">{{ S.dashPreview(L) }}</div>
    </div>
  </div>
</section>
<section class="ta-sec" id="dashboard">
  <div class="wrap">
    <div class="ta-head" data-reveal="up"><p class="kicker">{{ L.dashboard.eyebrow }}</p><h2>{{ L.dashboard.title }}</h2><p>{{ L.dashboard.intro }}</p></div>
    {{ S.dashPoints(L) }}
  </div>
</section>
<section class="ta-sec alt" id="courses">
  <div class="wrap">
    <div class="ta-head" data-reveal="up"><p class="kicker">{{ L.courses.eyebrow }}</p><h2>{{ L.courses.title }}</h2><p>{{ L.courses.intro }}</p></div>
    <div class="ta-progress-card">
      {% for c in L.courses.items %}
      <article class="ta-course {{ c.status }}" data-reveal="up" style="--d:{{ loop.index0 * 80 }}ms">
        <div class="img"><img src="{{ c.image }}" alt="{{ c.image_alt }}" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'"></div>
        <div class="body">
          <div><span class="ta-badge {{ 'live' if c.status == 'live' else 'coming' }}">{{ c.badge }}</span></div>
          <h3>{{ c.title }}</h3><p>{{ c.summary }}</p>{{ S.courseFacts(c) }}
          {% if c.price_note %}<p class="ta-price-note">{{ c.price_note }}</p>{% endif %}
          {% if c.status == "live" and c.cta_label %}<a class="ta-btn primary" href="{{ c.cta_url or '/academy/' }}" style="margin-top:8px">{{ c.cta_label }}</a>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{{ S.why(L, "") }}
<section class="ta-sec dark" id="how">
  <div class="wrap">
    <div class="ta-head" data-reveal="up"><p class="kicker">{{ L.how.eyebrow }}</p><h2>{{ L.how.title }}</h2></div>
    <ol class="ta-timeline">{% for s in L.how.steps %}<li data-reveal="up" style="--d:{{ loop.index0 * 70 }}ms"><div><h3>{{ s.title }}</h3><p>{{ s.description }}</p></div></li>{% endfor %}</ol>
  </div>
</section>
{{ S.pricing(L, "alt") }}
{{ S.finalCta(L) }}
</div>
