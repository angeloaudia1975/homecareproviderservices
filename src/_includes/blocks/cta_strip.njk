<div class="m-cta-strip" style="--m-accent:{{ accent }}"><div class="container">
  <div><h2>{{ b.headline }}</h2>{% if b.copy %}<p>{{ b.copy }}</p>{% endif %}</div>
  <div class="m-cta-actions">
    <a class="btn primary" href="{{ b.url or manu.ordering_url }}" {% if b.url or manu.ordering_url %}target="_blank" rel="noopener"{% endif %}>{{ b.cta }}</a>
    {% if b.url2 %}<a class="btn outline" href="{{ b.url2 }}" target="_blank" rel="noopener">{{ b.cta2 }}</a>{% endif %}
  </div>
</div></div>
