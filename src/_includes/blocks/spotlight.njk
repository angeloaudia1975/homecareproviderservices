<section class="m-featured-band" style="--m-accent:{{ accent }};--m-dark:{{ dark }}"><div class="container">
  <div class="m-split-grid">
    {% if b.image %}<div class="m-image-card"><img src="{{ b.image }}" alt="{{ b.headline }}"></div>{% endif %}
    <div class="m-callout">
      {% if b.badge %}<span class="m-price-badge">{{ b.badge }}</span>{% endif %}
      <h2>{{ b.headline }}</h2><p>{{ b.copy }}</p>
      {% if b.checklist.length %}<ul class="m-checklist">{% for i in b.checklist %}<li>{{ i }}</li>{% endfor %}</ul>{% endif %}
      {% if b.cta_url %}<div class="hero-actions"><a class="btn primary" href="{{ b.cta_url }}" target="_blank" rel="noopener">{{ b.cta or "Learn more" }}</a></div>
      {% elif manu.ordering_url %}<div class="hero-actions"><a class="btn primary" href="{{ manu.ordering_url }}" target="_blank" rel="noopener">{{ b.cta or "Place Dealer Order" }}</a></div>{% endif %}
    </div>
  </div>
</div></section>
