<!doctype html>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.classList.add('has-js');</script>

{%- set pageseo = false -%}
{%- for s in seo -%}{%- if s.path == page.url -%}{%- set pageseo = s -%}{%- endif -%}{%- endfor -%}
{%- set metaTitle = pageseo.title if (pageseo and pageseo.title) else (title + " | " + site.name) -%}
{%- set metaDesc = (pageseo.description if pageseo else "") or description or site.meta_description -%}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc }}">
{%- if pageseo and pageseo.canonical %}<link rel="canonical" href="{{ pageseo.canonical }}">{%- endif %}
<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:type" content="website">
{%- if pageseo and pageseo.image %}
<meta property="og:image" content="{{ pageseo.image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ pageseo.image }}">
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Archivo+Expanded:wght@700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css?v={{ asset.cssVersion }}">
{%- if site.analytics and site.analytics.provider == "ga4" and site.analytics.ga4_id %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4_id }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.analytics.ga4_id }}');</script>
{%- elif site.analytics and site.analytics.provider == "plausible" and site.analytics.plausible_domain %}
<script defer data-domain="{{ site.analytics.plausible_domain }}" src="https://plausible.io/js/script.js"></script>
{%- elif site.analytics and site.analytics.provider == "cloudflare" and site.analytics.cloudflare_token %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analytics.cloudflare_token }}"}'></script>
{%- endif %}
</head>
<body>

<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-left">
      <span>{{ site.tagline }} Since {{ site.founded }}</span><span class="sep">&bull;</span>
      <span>{{ activeManufacturers.length }} Manufacturing Partners</span><span class="sep">&bull;</span>
      <span>{{ site.stats.dealers }} Active Dealers</span>
    </div>
    <div class="topbar-right">
      <a href="tel:{{ site.contact.phone_href }}">{{ site.contact.phone_display }}</a>
      <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      <a class="topbar-btn" href="/become-a-manufacturer-partner/">Become a Manufacturer Partner</a>
    </div>
  </div>
</div>

<header class="mainnav">
  <div class="container nav-inner">
    <a class="brand" href="/"><img src="/assets/hcps-logo.png" alt="{{ site.name }}"></a>
    <a class="nav-order-btn" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">&#128722; Online Ordering Portal</a>
    <nav class="links" aria-label="Primary navigation">
      {%- if nav and nav.primary and nav.primary.length -%}
      {%- for item in nav.primary -%}
      {%- if item.dropdown == "manufacturers" -%}
      <div class="dropdown">
        <a href="{{ item.url }}">{{ item.label }}</a>
        <div class="dropdown-menu mega">
          {% for m in activeManufacturers %}<a href="/manufacturers/{{ m.id }}/">{{ m.name }}</a>{% endfor %}
        </div>
      </div>
      {%- elif item.children and item.children.length -%}
      <div class="dropdown">
        <a href="{{ item.url }}">{{ item.label }}</a>
        <div class="dropdown-menu">
          {% for c in item.children %}<a href="{{ c.url }}"{% if c.external %} target="_blank" rel="noopener"{% endif %}>{{ c.label }}</a>{% endfor %}
        </div>
      </div>
      {%- else -%}
      <a href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a>
      {%- endif -%}
      {%- endfor -%}
      {%- else -%}
      <a href="/">Home</a>
      <div class="dropdown">
        <a href="/manufacturers/">Manufacturers</a>
        <div class="dropdown-menu mega">
          {% for m in activeManufacturers %}<a href="/manufacturers/{{ m.id }}/">{{ m.name }}</a>{% endfor %}
        </div>
      </div>
      <div class="dropdown">
        <a href="/dealer-hub/">Dealer Hub</a>
        <div class="dropdown-menu">
          <a href="/resources/">Resource Library</a>
          <a href="/contact/?reason=Product%20or%20Pricing%20Question">Pricing Access</a>
          <a href="/contact/?reason=Online%20Ordering%20Support">Dealer Order Request</a>
          <a href="/contact/?reason=Dealer%20Support">Order Literature</a>
          <a href="/dealer-hub/?service=staff-in-service#schedule">Request In-Service</a>
          <a href="/dealer-hub/?service=technical-support#schedule">Technical Support</a>
        </div>
      </div>
      <a href="/consulting/">Consulting</a>
      <a href="/#team">Our Team</a>
      <a href="/#territory">Territory</a>
      <a href="/contact/">Contact</a>
      {%- endif -%}
    </nav>
  </div>
</header>

<main>{{ content | safe }}</main>

<style>
  .footer-grid .rep-login{display:inline-flex;align-items:center;gap:8px;margin-top:16px;color:#fff;font-weight:800;font-size:13.5px;text-decoration:none;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-left:3px solid #e07b00;border-radius:10px;padding:9px 16px;transition:background .15s}
  .footer-grid .rep-login:hover{background:rgba(255,255,255,.12)}
</style>
<footer id="contact">
  <div class="container footer-grid">
    <div>
      <img src="/assets/hcps-logo.png" alt="{{ site.name }}">
      <p>{{ site.meta_description }}</p>
      <div class="footer-contact">
        <a href="tel:{{ site.contact.phone_href }}">{{ site.contact.phone_display }}</a>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </div>
      <a class="rep-login" href="/admin/rep-login.html" rel="nofollow">🔑 Rep Login</a>
    </div>
    {%- if nav and nav.footer and nav.footer.length -%}
    {%- for col in nav.footer -%}
    <nav>
      <h3>{{ col.heading }}</h3>
      {% for l in col.links %}<a href="{{ l.url }}"{% if l.external %} target="_blank" rel="noopener"{% endif %}>{{ l.label }}</a>{% endfor %}
    </nav>
    {%- endfor -%}
    {%- else -%}
    <nav>
      <h3>Platform</h3>
      <a href="/manufacturers/">Manufacturers</a>
      <a href="/dealer-hub/">Dealer Hub</a>
      <a href="/resources/">Resource Library</a>
      <a href="/consulting/">Consulting</a>
      <a href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Online Ordering Portal</a>
    </nav>
    <nav>
      <h3>Company</h3>
      <a href="/#team">Our Team</a>
      <a href="/#territory">Territory</a>
      <a href="/become-a-dealer/">Become a Dealer</a>
    </nav>
    {%- endif -%}
    <div>
      <h3>Ready to Grow?</h3>
      <p>Talk with HCPS about becoming a dealer, checking stock, or getting pricing access.</p>
      <a class="btn primary" href="mailto:{{ site.contact.email }}">Become a Dealer</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; 2026 {{ site.name }}, LLC. All rights reserved.</span>
    <span>{{ site.tagline }} &bull; Serving Dealers Since {{ site.founded }}</span>
  </div>
</footer>

<script>
/* Graceful image fallback: any image that fails to load (e.g. a product photo
   not uploaded yet) is replaced with a clean branded placeholder showing its
   name, instead of a broken-image icon. */
(function () {
  function esc(s){return String(s).replace(/[<&>]/g,function(c){return {"<":"&lt;","&":"&amp;",">":"&gt;"}[c];});}
  function placeholder(img){
    if (img.dataset.ph) return; img.dataset.ph = "1";
    var name = (img.getAttribute("alt") || "").trim();
    var w = Math.max(img.clientWidth || 400, 260), h = Math.max(img.clientHeight || 200, 150);
    var mn = Math.min(w, h);
    var svg =
      '<svg xmlns="http://www.w3.org/2000/svg" width="'+w+'" height="'+h+'" viewBox="0 0 '+w+' '+h+'">'
      + '<rect width="100%" height="100%" fill="#eef2f7"/>'
      + '<g fill="none" stroke="#bcc7d6" stroke-width="'+(mn*0.014).toFixed(2)+'" stroke-linejoin="round" stroke-linecap="round">'
      + '<rect x="'+(w*0.33).toFixed(0)+'" y="'+(h*0.28).toFixed(0)+'" width="'+(w*0.34).toFixed(0)+'" height="'+(h*0.26).toFixed(0)+'" rx="'+(mn*0.03).toFixed(0)+'"/>'
      + '<circle cx="'+(w*0.42).toFixed(0)+'" cy="'+(h*0.37).toFixed(0)+'" r="'+(mn*0.03).toFixed(0)+'"/>'
      + '<path d="M'+(w*0.34).toFixed(0)+' '+(h*0.53).toFixed(0)+' L'+(w*0.45).toFixed(0)+' '+(h*0.43).toFixed(0)+' L'+(w*0.54).toFixed(0)+' '+(h*0.5).toFixed(0)+' L'+(w*0.6).toFixed(0)+' '+(h*0.45).toFixed(0)+' L'+(w*0.66).toFixed(0)+' '+(h*0.53).toFixed(0)+'"/>'
      + '</g>'
      + (name ? '<text x="50%" y="'+(h*0.72).toFixed(0)+'" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-weight="600" font-size="'+Math.round(Math.max(Math.min(w*0.05,17),12))+'" fill="#71829a">'+esc(name.length>34?name.slice(0,32)+"…":name)+'</text>' : '')
      + '<text x="50%" y="'+(h*0.72+20).toFixed(0)+'" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-size="11" fill="#a6b2c2">Image coming soon</text>'
      + '</svg>';
    img.src = "data:image/svg+xml," + encodeURIComponent(svg);
  }
  // Catch images that fail *after* this script runs.
  window.addEventListener("error", function (e) {
    var t = e.target;
    if (t && t.tagName === "IMG" && !t.dataset.ph) placeholder(t);
  }, true);
  // Catch images that already failed *before* this script ran (error fires once).
  function sweep(){
    var imgs = document.getElementsByTagName("img");
    for (var i = 0; i < imgs.length; i++){
      var img = imgs[i];
      if (!img.dataset.ph && img.complete && img.naturalWidth === 0 && img.getAttribute("src")) placeholder(img);
    }
  }
  sweep();
  window.addEventListener("load", sweep);
})();
</script>

<!-- Zoho SalesIQ live chat + visitor intelligence (config-driven, replaces Tawk.to) -->
{%- if site.salesiq and site.salesiq.widgetcode %}
<script type="text/javascript">
window.$zoho = window.$zoho || {};
$zoho.salesiq = $zoho.salesiq || { ready: function () {} };
</script>
<script id="zsiqscript" defer
  src="{{ site.salesiq.domain or 'https://salesiq.zohopublic.com' }}/widget?wc={{ site.salesiq.widgetcode }}"></script>
{%- endif %}

<!-- Shared HCPS interaction layer: scroll-reveal entrance animations (site-wide) -->
<script src="/assets/js/hcps-fx.js?v={{ asset.cssVersion }}" defer></script>
</body>
</html>
