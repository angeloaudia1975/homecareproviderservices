---
layout: layouts/base.njk
title: Dealer Services
permalink: /dealer-services/
description: "Value-added business services for HomeCare Provider Services dealers—beyond our manufacturer product lines. Access vetted partners, tools, and solutions designed to strengthen your business, improve cash flow, streamline operations, and support long-term growth. These services are separate from our manufacturer portfolio and available exclusively to the HCPS dealer network."
---
{% set ds = dealerServices %}
<style>
  .bh{--blue:var(--hcps-blue,#1681c2);--blue-d:var(--hcps-blue-dark,#0f5c8f);--orange:var(--hcps-orange,#ef6325);--gold:var(--hcps-gold,#fcb21e);--ink:#0b0d0f;--paper:#f6f7f5;}
  .bh *{box-sizing:border-box;}
  .bh .wrap{max-width:1200px;margin:0 auto;padding:0 24px;}
  .bh section{padding:60px 0;}
  .bh .kicker{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:2px;font-size:12px;color:var(--orange);margin:0 0 10px;}
  .bh h2{font-family:'Archivo',sans-serif;font-weight:800;font-size:clamp(24px,3vw,34px);color:var(--ink);margin:0 0 12px;line-height:1.15;}
  .bh .sub{font-size:16px;color:#48535f;max-width:760px;line-height:1.6;margin:0 0 8px;}
  .bh-btn{display:inline-block;font-family:'Archivo',sans-serif;font-weight:800;font-size:15px;border-radius:12px;padding:13px 24px;text-decoration:none;cursor:pointer;border:0;transition:transform .13s,box-shadow .13s;}
  .bh-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.75);}
  .bh-btn.primary:hover{transform:translateY(-2px);}
  .bh-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border:1px solid rgba(255,255,255,.32);}
  .bh-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .bh-btn.blue{background:var(--blue-d);color:#fff;}
  .bh-btn.sm{padding:10px 16px;font-size:13.5px;border-radius:10px;}

  /* Hero */
  .bh-hero{background:linear-gradient(150deg,#0b1f33 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:70px 0 60px;position:relative;overflow:hidden;}
  .bh-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.26),transparent 68%);}
  .bh-hero .kicker{color:var(--gold);}
  .bh-hero h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(29px,4.4vw,48px);line-height:1.06;margin:0 0 16px;color:#fff;}
  .bh-hero p{font-size:17px;line-height:1.6;color:rgba(255,255,255,.92);max-width:680px;margin:0 0 24px;}
  .bh-hero .actions{display:flex;gap:12px;flex-wrap:wrap;}
  .bh-chipline{display:flex;gap:8px;flex-wrap:wrap;margin-top:28px;}
  .bh-chipline span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;font-size:12.5px;font-weight:600;border-radius:20px;padding:6px 12px;}

  /* Solutions equation */
  .bh-eqbar{background:#fff;border-bottom:1px solid #edf0f3;}
  .bh-eq{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:12px;}
  .bh-eq span{background:#eef4fb;border:1px solid #d3e3f2;color:var(--blue-d);font-weight:700;font-size:13.5px;border-radius:9px;padding:8px 13px;}
  .bh-eq b{color:var(--orange);font-weight:800;font-size:16px;padding:0 2px;}

  /* Pillars */
  .bh-pillars{background:var(--paper);}
  .bh-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:26px;}
  @media(max-width:860px){.bh-grid3{grid-template-columns:1fr;}}
  .bh-pill{background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:24px;}
  .bh-pill .ic{width:48px;height:48px;border-radius:13px;background:linear-gradient(135deg,#ef6325,#fcb21e);color:#fff;display:grid;place-items:center;margin-bottom:14px;}
  .bh-pill .ic svg{width:25px;height:25px;}
  .bh-pill h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:18px;color:var(--ink);margin:0 0 6px;}
  .bh-pill .pd{font-size:13.5px;color:#54606c;line-height:1.5;margin:0 0 13px;}
  .bh-pill ul{list-style:none;padding:0;margin:0;display:grid;gap:8px;}
  .bh-pill li{position:relative;padding-left:26px;font-size:13.5px;color:#33404b;line-height:1.4;}
  .bh-pill li::before{content:"";position:absolute;left:0;top:1px;width:18px;height:18px;border-radius:50%;background:#e9f7ef;border:1px solid #bfe6cd;}
  .bh-pill li::after{content:"";position:absolute;left:6px;top:5px;width:5px;height:8px;border:solid #1c7a44;border-width:0 2px 2px 0;transform:rotate(45deg);}

  /* Separation band */
  .bh-sep{background:#fff;}
  .bh-sep-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:22px;align-items:stretch;margin-top:24px;}
  @media(max-width:760px){.bh-sep-grid{grid-template-columns:1fr;}}
  .bh-sep-card{border:1px solid #e5e9ee;border-radius:16px;padding:24px;}
  .bh-sep-card.man{background:linear-gradient(160deg,#0f5c8f,#1681c2);color:#fff;}
  .bh-sep-card.svc{background:linear-gradient(160deg,#b7491a,#ef6325);color:#fff;}
  .bh-sep-card h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:18px;margin:0 0 8px;color:#fff;}
  .bh-sep-card p{font-size:14px;line-height:1.55;color:rgba(255,255,255,.9);margin:0;}
  .bh-sep-card .tag{font-size:11px;text-transform:uppercase;letter-spacing:1.5px;font-weight:800;opacity:.8;display:block;margin-bottom:8px;}
  .bh-sep-vs{display:grid;place-items:center;font-family:'Archivo Expanded',sans-serif;font-weight:800;color:#c2ccd6;font-size:15px;}
  @media(max-width:760px){.bh-sep-vs{padding:4px;}}
  .bh-sep-note{margin-top:16px;background:var(--paper);border:1px solid #e5e9ee;border-left:4px solid var(--gold);border-radius:10px;padding:13px 16px;font-size:13.5px;color:#48535f;}

  /* Partner grid */
  .bh-partners{background:var(--paper);}
  .bh-chips{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0 8px;}
  .bh-chip{background:#fff;border:1px solid #d7dde3;color:#33404b;font-weight:700;font-size:13px;border-radius:20px;padding:8px 15px;cursor:pointer;transition:all .12s;}
  .bh-chip:hover{border-color:var(--blue);color:var(--blue-d);}
  .bh-chip.on{background:var(--blue-d);color:#fff;border-color:var(--blue-d);}
  .bh-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px;}
  @media(max-width:900px){.bh-cards{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:600px){.bh-cards{grid-template-columns:1fr;}}
  .bh-card{background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:22px;display:flex;flex-direction:column;transition:transform .13s,box-shadow .13s,border-color .13s;}
  .bh-card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .bh-card.feat{border-color:#f2c8a6;box-shadow:0 10px 30px rgba(239,99,37,.1);}
  .bh-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;}
  .bh-badge{font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:4px 9px;border-radius:20px;}
  .bh-badge.partner{background:#eaf3fb;color:#12466e;border:1px solid #cfe2fb;}
  .bh-badge.hcps{background:#fff3e0;color:#a5590f;border:1px solid #f2d9b0;}
  .bh-badge.feat{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;border:0;}
  .bh-card .logo{height:30px;max-width:150px;object-fit:contain;object-position:left;}
  .bh-card .nm{font-family:'Archivo',sans-serif;font-weight:800;font-size:18px;color:var(--ink);}
  .bh-card .cat{font-size:12px;color:#8a94a0;font-weight:600;margin-top:1px;}
  .bh-card .svc{font-size:14px;color:#33404b;font-weight:600;margin:12px 0 8px;line-height:1.4;}
  .bh-kv{font-size:13px;color:#54606c;line-height:1.5;margin:0 0 8px;}
  .bh-kv b{color:#243240;font-weight:700;display:block;font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;}
  .bh-card .cta{margin-top:auto;padding-top:14px;}
  .bh-card .cta a{display:inline-block;color:#fff;text-decoration:none;font-weight:800;font-size:14px;padding:11px 18px;border-radius:10px;}
  .bh-card .cta .sec{display:block;font-size:12px;color:#8a94a0;margin-top:7px;line-height:1.4;}
  .bh-req{grid-column:1/-1;background:#fff;border:1px dashed #c8d3df;border-radius:16px;padding:24px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;}
  .bh-req h3{margin:0 0 3px;color:var(--ink);font-size:17px;font-family:'Archivo',sans-serif;}
  .bh-req p{margin:0;font-size:13.5px;color:#54606c;max-width:560px;}

  /* Exclusive benefits */
  .bh-benefits{background:#fff;}
  .bh-bgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-top:24px;}
  @media(max-width:900px){.bh-bgrid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.bh-bgrid{grid-template-columns:1fr;}}
  .bh-b{background:var(--paper);border:1px solid #e5e9ee;border-radius:14px;padding:18px;}
  .bh-b .dot{width:34px;height:34px;border-radius:9px;background:#eef4fb;color:var(--blue-d);display:grid;place-items:center;margin-bottom:10px;}
  .bh-b h4{font-family:'Archivo',sans-serif;font-weight:800;font-size:14.5px;color:var(--ink);margin:0 0 4px;}
  .bh-b p{font-size:12.5px;color:#5b6672;line-height:1.45;margin:0;}

  /* Final CTA */
  .bh-final{background:var(--ink);color:#fff;text-align:center;}
  .bh-final h2{color:#fff;}
  .bh-final p{color:rgba(255,255,255,.8);max-width:640px;margin:0 auto 22px;}
  .bh-final .actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
</style>

<div class="bh">

<!-- HERO -->
<section class="bh-hero">
  <div class="wrap">
    <p class="kicker">{{ ds.eyebrow }}</p>
    <h1>{{ ds.headline }}</h1>
    <p>{{ ds.lead }}</p>
    <div class="actions">
      <a class="bh-btn primary" href="#partners">Explore Dealer Services →</a>
      <a class="bh-btn ghost" href="#payments">Improve Your Cash Flow</a>
    </div>
    <div class="bh-chipline">
      {% for c in ds.categories %}<span>{{ c.label }}</span>{% endfor %}
    </div>
  </div>
</section>

<!-- POSITIONING / EQUATION -->
<section class="bh-eqbar">
  <div class="wrap">
    <p class="kicker">A Solutions Company</p>
    <h2>The HCPS relationship goes beyond the products we represent.</h2>
    <p class="sub">We actively identify trusted tools, services, and partners that help our dealers run and grow better businesses — exclusive to the HCPS network.</p>
    <div class="bh-eq">
      <span>Improve Cash Flow</span><b>+</b><span>Operate More Efficiently</span><b>+</b><span>Strengthen Marketing</span><b>+</b><span>Grow Revenue</span><b>+</b><span>Build a Better Business</span>
    </div>
  </div>
</section>

<!-- PILLARS -->
<section class="bh-pillars" id="payments">
  <div class="wrap">
    <p class="kicker">What we help with</p>
    <h2>Business solutions across every part of your operation</h2>
    <p class="sub">Three core areas today — with a framework built to add partners across financial services, technology, insurance, and more.</p>
    <div class="bh-grid3">
      {% for p in ds.pillars %}
      <article class="bh-pill" id="{{ p.key }}">
        <div class="ic">
          {% if p.icon == "card" %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          {% elif p.icon == "gear" %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          {% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9M13 17V5M8 17v-3"/></svg>{% endif %}
        </div>
        <h3>{{ p.title }}</h3>
        <p class="pd">{{ p.desc }}</p>
        <ul>{% for b in p.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- SEPARATION -->
<section class="bh-sep">
  <div class="wrap">
    <p class="kicker">Important distinction</p>
    <h2>Dealer Services is separate from our manufacturer portfolio</h2>
    <p class="sub">Two different things — so dealers and manufacturers know these services never compete with or alter our product representation.</p>
    <div class="bh-sep-grid">
      <div class="bh-sep-card man">
        <span class="tag">Products we sell</span>
        <h3>{{ ds.separation.manufacturer.title }}</h3>
        <p>{{ ds.separation.manufacturer.desc }}</p>
      </div>
      <div class="bh-sep-vs">vs</div>
      <div class="bh-sep-card svc">
        <span class="tag">Business solutions</span>
        <h3>{{ ds.separation.services.title }}</h3>
        <p>{{ ds.separation.services.desc }}</p>
      </div>
    </div>
    <div class="bh-sep-note">{{ ds.separation.note }}</div>
  </div>
</section>

<!-- VETTED PARTNERS -->
<section class="bh-partners" id="partners">
  <div class="wrap">
    <p class="kicker">Vetted Partner Solutions</p>
    <h2>Preferred partners &amp; services for the HCPS network</h2>
    <p class="sub">HCPS evaluates and selects outside partners — and offers our own services — that provide meaningful value to dealers. Filter by what you need.</p>
    <div class="bh-chips" id="bh-chips">
      <button class="bh-chip on" data-cat="all">All services</button>
      {% for c in ds.categories %}<button class="bh-chip" data-cat="{{ c.key }}">{{ c.label }}</button>{% endfor %}
    </div>
    <div class="bh-cards" id="bh-cards">
      {% for p in ds.partners %}
      <article class="bh-card{% if p.featured %} feat{% endif %}" data-cats="{{ p.categories | join(' ') }}">
        <div class="bh-card-top">
          <div>
            {% if p.logo %}<img class="logo" src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy" onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<div class=\'nm\'>{{ p.name }}</div>')">
            {% else %}<div class="nm">{{ p.name }}</div>{% endif %}
            <div class="cat">{{ p.category_label }}</div>
          </div>
          {% if p.featured %}<span class="bh-badge feat">Featured</span>{% elif p.type == "hcps" %}<span class="bh-badge hcps">HCPS Service</span>{% else %}<span class="bh-badge partner">Vetted Partner</span>{% endif %}
        </div>
        <p class="svc">{{ p.service }}</p>
        <p class="bh-kv"><b>Key dealer benefit</b>{{ p.benefit }}</p>
        <p class="bh-kv"><b>HCPS dealer advantage</b>{{ p.hcps_advantage }}</p>
        <div class="cta">
          <a href="{{ p.url }}{% if p.tracking_key and 'http' in p.url %}?utm_source=hcps&utm_medium=website&utm_campaign=dealer-services&utm_content={{ p.tracking_key }}{% endif %}"{% if 'http' in p.url %} target="_blank" rel="noopener"{% endif %} style="background:{{ p.accent }};box-shadow:0 6px 16px {{ p.accent }}44;" data-svc-cta="{{ p.tracking_key }}">{{ p.cta_label }} &rarr;</a>
          {% if p.cta_secondary %}<span class="sec">{{ p.cta_secondary }}</span>{% endif %}
        </div>
      </article>
      {% endfor %}
      <div class="bh-req" id="bh-empty" style="display:none">
        <div>
          <h3>Looking for something specific?</h3>
          <p>We're actively vetting partners across financial services, insurance, technology, and operations. Tell us what would help your business and we'll point you to the right solution.</p>
        </div>
        <a class="bh-btn primary sm" href="/contact/?reason=Dealer%20Services%20%E2%80%94%20Partner%20Request">Request More Information →</a>
      </div>
    </div>
  </div>
</section>

<!-- EXCLUSIVE BENEFITS -->
<section class="bh-benefits">
  <div class="wrap">
    <p class="kicker">Exclusive Dealer Benefits</p>
    <h2>Why these services are better through HCPS</h2>
    <p class="sub">Selected specifically for the HCPS network — with the access and support that come from being a dealer.</p>
    <div class="bh-bgrid">
      {% for b in ds.exclusive_benefits %}
      <div class="bh-b">
        <div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>
        <h4>{{ b.title }}</h4>
        <p>{{ b.desc }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="bh-final">
  <div class="wrap">
    <p class="kicker">A Solutions Company</p>
    <h2>Let's talk about your business — not just your product lines.</h2>
    <p>HCPS helps dealers with both the products they sell and the business behind them. Tell us where you'd like to improve cash flow, operations, marketing, or growth, and we'll connect you with the right solution.</p>
    <div class="actions">
      <a class="bh-btn primary" href="/contact/?reason=Dealer%20Services%20%E2%80%94%20Business%20Needs">Talk to HCPS About Your Business Needs →</a>
      <a class="bh-btn ghost" href="#partners">View Preferred Partners</a>
    </div>
  </div>
</section>

</div>

<script>
(function () {
  // Category filter for the partner grid — data-driven, so new partners just work.
  var chips = document.getElementById("bh-chips");
  var cards = Array.prototype.slice.call(document.querySelectorAll("#bh-cards .bh-card"));
  var empty = document.getElementById("bh-empty");
  if (chips) chips.addEventListener("click", function (e) {
    var btn = e.target.closest(".bh-chip"); if (!btn) return;
    chips.querySelectorAll(".bh-chip").forEach(function (c) { c.classList.remove("on"); });
    btn.classList.add("on");
    var cat = btn.getAttribute("data-cat");
    var shown = 0;
    cards.forEach(function (card) {
      var cats = (card.getAttribute("data-cats") || "").split(" ");
      var ok = (cat === "all") || cats.indexOf(cat) > -1;
      card.style.display = ok ? "" : "none";
      if (ok) shown++;
    });
    if (empty) empty.style.display = shown ? "none" : "";
  });

  // Outbound partner-click tracking (SalesIQ + dataLayer), same as before.
  document.querySelectorAll("[data-svc-cta]").forEach(function (a) {
    a.addEventListener("click", function () {
      var key = this.getAttribute("data-svc-cta");
      try { if (window.HCPSChat && HCPSChat.event) HCPSChat.event("service:" + key + ":click", { Service: key, Surface: "Website" }); } catch (e) {}
      try { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: "service_click", service: key, surface: "website" }); } catch (e) {}
    });
  });
})();
</script>
