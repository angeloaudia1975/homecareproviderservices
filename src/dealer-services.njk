---
layout: layouts/base.njk
title: Dealer Services
permalink: /dealer-services/
description: "Value-added business services for HomeCare Provider Services dealers — beyond our manufacturer product lines. Improve cash flow, run more efficiently, and grow with a premier payments partner (CardChamp) plus HCPS business consulting, digital marketing, and website services, exclusively for the HCPS dealer network."
---
<style>
  .ds{--navy:#0b1f33;--blue:var(--hcps-blue,#1681c2);--blue-d:var(--hcps-blue-dark,#0f5c8f);--orange:var(--hcps-orange,#ef6325);--gold:var(--hcps-gold,#fcb21e);--ink:#0b0d0f;--paper:#f5f7fa;--line:#e5e9ee;}
  .ds *{box-sizing:border-box;}
  .ds .wrap{max-width:1180px;margin:0 auto;padding:0 24px;}
  .ds h1,.ds h2,.ds h3{font-family:'Archivo Expanded','Archivo',sans-serif;}
  .ds .kicker{font-family:'Archivo',sans-serif;font-weight:800;text-transform:uppercase;letter-spacing:2px;font-size:12px;color:var(--orange);margin:0 0 10px;}
  .ds-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:15px;border-radius:12px;padding:14px 26px;text-decoration:none;border:1px solid transparent;transition:transform .13s,box-shadow .13s;cursor:pointer;}
  .ds-btn:hover{transform:translateY(-2px);}
  .ds-btn.primary{background:linear-gradient(100deg,var(--orange),var(--gold));color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .ds-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.35);}
  .ds-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .ds-btn.big{font-size:17px;padding:18px 34px;border-radius:14px;}

  /* Scroll-reveal entrance animations are provided site-wide by the shared FX
     layer (site.css + /assets/js/hcps-fx.js). This page's [data-reveal] hooks
     are honored automatically — no per-page reveal code needed. */

  /* Hero */
  .ds-hero{background:linear-gradient(150deg,#0b1f33 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:46px 0 54px;position:relative;overflow:hidden;perspective:1500px;}
  .ds-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.24),transparent 66%);pointer-events:none;}
  .ds-hero .wrap{position:relative;z-index:1;}
  .ds-hero-img{max-width:1000px;margin:0 auto;border-radius:18px;overflow:hidden;aspect-ratio:1731/909;background:url("/assets/dealer-services/hero-banner.jpg") center/cover;box-shadow:0 45px 85px -22px rgba(0,0,0,.6);transform-style:preserve-3d;transition:transform .18s ease-out;will-change:transform;position:relative;}
  .ds-glare{position:absolute;inset:0;pointer-events:none;background:radial-gradient(300px 300px at var(--mx,50%) var(--my,30%),rgba(255,255,255,.28),transparent 60%);mix-blend-mode:screen;opacity:0;transition:opacity .2s;}
  .ds-hero-copy{max-width:900px;margin:30px auto 0;text-align:center;}
  .ds-hero-copy h1{font-weight:800;font-size:clamp(24px,3.4vw,40px);line-height:1.08;margin:0 0 14px;color:#fff;}
  .ds-hero-copy p{font-size:clamp(15px,1.4vw,17.5px);color:rgba(255,255,255,.92);max-width:720px;margin:0 auto 24px;}
  .ds-hero-copy .actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}

  /* Sections */
  .ds-sec{padding:64px 0;}
  .ds-sec.alt{background:var(--paper);}
  .ds-head{text-align:center;max-width:760px;margin:0 auto 34px;}
  .ds-head h2{font-weight:800;font-size:clamp(23px,2.9vw,34px);color:var(--ink);margin:0 0 10px;line-height:1.14;}
  .ds-head p{font-size:16px;color:#48535f;}

  /* Category cards (large icon on top, full card width) */
  .ds-cats{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  @media(max-width:860px){.ds-cats{grid-template-columns:1fr;}}
  .ds-cat{background:#fff;border:1px solid var(--line);border-radius:20px;padding:14px 26px 30px;text-align:center;box-shadow:0 10px 30px rgba(12,39,64,.05);transition:transform .14s,box-shadow .14s;}
  .ds-cat:hover{transform:translateY(-4px);box-shadow:0 22px 46px rgba(12,39,64,.12);}
  .ds-cat-ico{width:100%;margin:0 0 12px;position:relative;}
  .ds-cat-ico img{display:block;width:82%;max-width:230px;margin:0 auto;aspect-ratio:1/1;object-fit:contain;}
  .ds-cat-ico::after{content:"";display:block;height:4px;width:60px;margin:2px auto 0;border-radius:3px;background:var(--accent,var(--blue));}
  .ds-cat h3{font-weight:800;font-size:20px;color:var(--ink);margin:0 0 8px;line-height:1.15;}
  .ds-cat p{font-size:14.5px;color:#54606c;}

  /* CardChamp premier partner */
  .ds-champ{background:linear-gradient(160deg,#0b1f33,#123a5c);color:#fff;position:relative;overflow:hidden;}
  .ds-champ::before{content:"";position:absolute;left:-140px;bottom:-140px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(239,99,37,.22),transparent 66%);}
  .ds-champ .wrap{position:relative;z-index:1;}
  .ds-champ-ribbon{display:inline-flex;align-items:center;gap:9px;background:linear-gradient(100deg,var(--orange),var(--gold));color:#141414;font-family:'Archivo',sans-serif;font-weight:800;font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase;padding:8px 16px;border-radius:30px;margin:0 0 18px;}
  .ds-champ-img{max-width:920px;margin:0 auto 26px;border-radius:16px;overflow:hidden;box-shadow:0 40px 80px -26px rgba(0,0,0,.7);aspect-ratio:1672/941;background:url("/assets/dealer-services/cardchamp-banner.jpg") center/cover;}
  .ds-champ-copy{max-width:820px;margin:0 auto;text-align:center;}
  .ds-champ-copy h2{color:#fff;font-weight:800;font-size:clamp(24px,3vw,36px);margin:0 0 14px;line-height:1.1;}
  .ds-champ-copy p{color:rgba(255,255,255,.9);font-size:16.5px;margin:0 auto 22px;max-width:720px;}
  .ds-chips{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:0 0 30px;}
  .ds-chips span{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.2);border-radius:30px;padding:9px 17px;font-weight:700;font-size:13.5px;}
  .ds-chips span b{color:var(--gold);}

  /* HCPS partner services */
  .ds-svcs{display:grid;gap:28px;margin-top:8px;}
  .ds-svc{display:grid;grid-template-columns:1.15fr .85fr;gap:0;background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 12px 34px rgba(12,39,64,.07);}
  .ds-svc.rev{grid-template-columns:.85fr 1.15fr;}
  .ds-svc.rev .ds-svc-img{order:2;}
  .ds-svc.rev .ds-svc-body{order:1;}
  @media(max-width:820px){.ds-svc,.ds-svc.rev{grid-template-columns:1fr;}.ds-svc.rev .ds-svc-img{order:0;}.ds-svc.rev .ds-svc-body{order:0;}}
  .ds-svc-img{background:#0b1f33;}
  .ds-svc-img img{display:block;width:100%;height:100%;object-fit:cover;}
  .ds-svc-body{padding:34px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;}
  .ds-svc-tag{font-family:'Archivo',sans-serif;font-weight:800;font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#a5590f;background:#fff3e0;border:1px solid #f2d9b0;border-radius:20px;padding:4px 11px;margin:0 0 12px;}
  .ds-svc-body h3{font-weight:800;font-size:23px;color:var(--ink);margin:0 0 10px;line-height:1.12;}
  .ds-svc-body p{font-size:15px;color:#54606c;margin:0 0 20px;}

  /* Final CTA */
  .ds-final{background:var(--ink);color:#fff;text-align:center;padding:60px 0;}
  .ds-final h2{color:#fff;font-weight:800;font-size:clamp(23px,2.9vw,34px);margin:0 0 12px;}
  .ds-final p{color:rgba(255,255,255,.82);max-width:640px;margin:0 auto 24px;font-size:16px;}
</style>

<div class="ds">

<!-- HERO -->
<section class="ds-hero">
  <div class="wrap">
    <div class="ds-hero-img" id="ds-heroimg" data-reveal="fade" role="img" aria-label="HCPS Dealer Services — value-added business services for HCPS dealers, beyond the product lines."><span class="ds-glare"></span></div>
    <div class="ds-hero-copy" data-reveal="up" style="--d:120ms">
      <h1>Value-added business services for HCPS dealers.</h1>
      <p>Beyond the product lines. HCPS Dealer Services connects you with vetted partners and powerful business tools that strengthen how you run your business — from payments and cash flow to operations, marketing, and growth.</p>
      <div class="actions">
        <a class="ds-btn primary" href="#cardchamp">Turn Credit Card Fees into Cash Flow &rarr;</a>
        <a class="ds-btn ghost" href="#services">Explore Dealer Services</a>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="ds-sec">
  <div class="wrap">
    <div class="ds-head" data-reveal="up">
      <p class="kicker">What we help with</p>
      <h2>Three ways HCPS strengthens your business</h2>
      <p>Business solutions built exclusively for the HCPS dealer network — designed to help you keep more of every sale, run leaner, and grow.</p>
    </div>
    <div class="ds-cats">
      <article class="ds-cat" data-reveal="up" style="--accent:#0f5c8f;--d:0ms">
        <div class="ds-cat-ico"><img src="/assets/dealer-services/cat-payments.jpg" alt="" loading="lazy"></div>
        <h3>Payments &amp; Cash Flow</h3>
        <p>Solutions that improve cash flow, reduce friction, and help you get paid faster — so more of every sale stays in your business.</p>
      </article>
      <article class="ds-cat" data-reveal="up" style="--accent:#1681c2;--d:130ms">
        <div class="ds-cat-ico"><img src="/assets/dealer-services/cat-operations.jpg" alt="" loading="lazy"></div>
        <h3>Operations &amp; Efficiency</h3>
        <p>Tools and services that streamline your daily operations, cut busywork, and drive efficiency across your dealership.</p>
      </article>
      <article class="ds-cat" data-reveal="up" style="--accent:#ef6325;--d:260ms">
        <div class="ds-cat-ico"><img src="/assets/dealer-services/cat-marketing.jpg" alt="" loading="lazy"></div>
        <h3>Marketing &amp; Business Development</h3>
        <p>Strategy and support that strengthen your brand, expand your reach, and turn interest into orders and long-term growth.</p>
      </article>
    </div>
  </div>
</section>

<!-- CARDCHAMP — PREMIER PARTNER -->
<section class="ds-champ ds-sec" id="cardchamp">
  <div class="wrap">
    <div style="text-align:center" data-reveal="up"><span class="ds-champ-ribbon">&#9733; Premier Dealer Services Partner</span></div>
    <div class="ds-champ-img" data-reveal="fade" role="img" aria-label="CardChamp — turn credit card fees into cash flow"></div>
    <div class="ds-champ-copy" data-reveal="down">
      <h2>Turn credit card fees into cash flow.</h2>
      <p>Through an exclusive CardChamp partnership for the HCPS dealer network, you can recover the cost of credit card processing and put it back into your business. CardChamp's patented fee-collection technology means no monthly fees, healthier margins, and stronger cash flow — with a simple setup and a team that walks you through every step.</p>
      <div class="ds-chips"><span><b>&#10003;</b> No Monthly Fees</span><span><b>&#10003;</b> Patented Fee-Collection Technology</span><span><b>&#10003;</b> Improve Cash Flow &amp; Margins</span></div>
      <a class="ds-btn primary big" href="/contact/?reason=CardChamp%20Consultation%20%E2%80%94%20Turn%20Credit%20Card%20Fees%20into%20Cash%20Flow">Schedule Consultation to Turn Credit Card Fee's into Cash Flow &rarr;</a>
    </div>
  </div>
</section>

<!-- HCPS PARTNER SERVICES -->
<section class="ds-sec alt" id="services">
  <div class="wrap">
    <div class="ds-head" data-reveal="up">
      <p class="kicker">HCPS Partner Services</p>
      <h2>More ways to grow — powered by HCPS</h2>
      <p>Beyond our partner network, HCPS offers its own services to help dealers strengthen their business, reach more customers, and build a stronger online presence.</p>
    </div>
    <div class="ds-svcs">

      <article class="ds-svc">
        <div class="ds-svc-img" data-reveal="left"><img src="/assets/dealer-services/business-consulting.jpg" alt="HCPS Business Consulting" loading="lazy"></div>
        <div class="ds-svc-body" data-reveal="up" style="--d:120ms">
          <span class="ds-svc-tag">HCPS Service</span>
          <h3>HCPS Business Consulting</h3>
          <p>Hands-on guidance to strengthen how you run and grow your dealership. Our consultants work directly with you on showroom strategy, product mix, pricing, and sales process — building a clear, practical roadmap to scale revenue and profitability.</p>
          <a class="ds-btn primary" href="/contact/?reason=HCPS%20Business%20Consulting">Contact Us to Learn More &rarr;</a>
        </div>
      </article>

      <article class="ds-svc rev">
        <div class="ds-svc-img" data-reveal="right"><img src="/assets/dealer-services/digital-marketing.jpg" alt="HCPS Digital Marketing" loading="lazy"></div>
        <div class="ds-svc-body" data-reveal="up" style="--d:120ms">
          <span class="ds-svc-tag">HCPS Service</span>
          <h3>HCPS Digital Marketing</h3>
          <p>Marketing built for HME &amp; DME dealers. From local SEO and paid search to social, email, and category landing pages, we help you reach more customers across your territory and turn interest into orders.</p>
          <a class="ds-btn primary" href="/contact/?reason=HCPS%20Digital%20Marketing">Contact Us to Learn More &rarr;</a>
        </div>
      </article>

      <article class="ds-svc">
        <div class="ds-svc-img" data-reveal="left"><img src="/assets/dealer-services/website-online-presence.jpg" alt="HCPS Website &amp; Online Presence" loading="lazy"></div>
        <div class="ds-svc-body" data-reveal="up" style="--d:120ms">
          <span class="ds-svc-tag">HCPS Service</span>
          <h3>HCPS Website &amp; Online Presence</h3>
          <p>A modern, mobile-friendly website and online presence that makes your dealership easy to find and easy to trust — professional design, product showcases, online-ordering integration, and the local search visibility customers use to choose you.</p>
          <a class="ds-btn primary" href="/contact/?reason=HCPS%20Website%20%26%20Online%20Presence">Contact Us to Learn More &rarr;</a>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="ds-final">
  <div class="wrap" data-reveal="up">
    <p class="kicker">A Solutions Company</p>
    <h2>Let's build a stronger business together.</h2>
    <p>Tell us where you'd like to improve — cash flow, operations, marketing, or your online presence — and we'll connect you with the right solution for your dealership.</p>
    <a class="ds-btn primary big" href="/contact/?reason=Dealer%20Services%20%E2%80%94%20Business%20Needs">Talk to HCPS About Dealer Services &rarr;</a>
  </div>
</section>

</div>

<script>
// Hero 3D tilt (desktop pointer only; respects reduced motion)
(function () {
  var el = document.getElementById("ds-heroimg"); if (!el) return;
  var band = el.closest(".ds-hero"); var g = el.querySelector(".ds-glare");
  var reduce = false; try { reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}
  if (reduce) return;
  band.addEventListener("mousemove", function (e) {
    var b = el.getBoundingClientRect();
    var px = Math.max(0, Math.min(1, (e.clientX - b.left) / b.width));
    var py = Math.max(0, Math.min(1, (e.clientY - b.top) / b.height));
    el.style.transform = "perspective(1500px) rotateY(" + ((px - .5) * 12) + "deg) rotateX(" + ((.5 - py) * 8) + "deg) translateZ(18px)";
    if (g) { g.style.setProperty("--mx", (px * 100) + "%"); g.style.setProperty("--my", (py * 100) + "%"); g.style.opacity = "1"; }
  });
  band.addEventListener("mouseleave", function () { el.style.transform = "perspective(1500px) rotateY(0) rotateX(0)"; if (g) g.style.opacity = "0"; });
})();
// Scroll-reveal is handled site-wide by /assets/js/hcps-fx.js — this page's
// [data-reveal] hooks are observed automatically, no per-page script needed.
</script>
