---
layout: layouts/base.njk
title: Dealer Resources
permalink: /resources/
description: "Explore catalogs, product guides, clinical publications, credit applications, and dealer resources from HME and DME manufacturers represented by HomeCare Provider Services."
---
<style>
  .rl-hero{position:relative;overflow:hidden;background:linear-gradient(150deg,#0c2740 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:60px 0 52px;}
  .rl-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.26),transparent 62%);pointer-events:none;}
  .rl-hero .container{position:relative;z-index:1;}
  .rl-eyebrow{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:7px 15px;font-family:'Archivo',sans-serif;font-weight:800;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 15px;}
  .rl-hero h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(28px,4.4vw,48px);line-height:1.05;margin:0 0 14px;max-width:18ch;}
  .rl-hero .rl-lead{font-size:clamp(15.5px,1.4vw,18px);line-height:1.55;color:rgba(255,255,255,.9);max-width:72ch;margin:0 0 24px;}
  .rl-cta-row{display:flex;gap:11px;flex-wrap:wrap;align-items:center;}
  .rl-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:14.5px;text-decoration:none;border-radius:11px;padding:13px 22px;transition:transform .12s,box-shadow .12s;border:1px solid transparent;cursor:pointer;}
  .rl-btn:hover{transform:translateY(-1px);}
  .rl-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .rl-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.28);}
  .rl-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .rl-btn.blue{background:var(--hcps-blue,#1681c2);color:#fff;}
  .rl-btn.sm{padding:10px 16px;font-size:13px;}

  .rl-sec{padding:44px 0;}
  .rl-sec.alt{background:var(--paper,#f6f7f5);}
  .rl-kicker{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hcps-blue,#1681c2);margin:0 0 8px;}
  .rl-h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(22px,2.7vw,32px);line-height:1.1;color:var(--ink);margin:0 0 10px;}
  .rl-sub{font-size:15.5px;line-height:1.55;color:#48525c;margin:0 0 22px;max-width:70ch;}

  .rl-types{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 6px;}
  .rl-type-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #d9e0e7;border-radius:999px;padding:9px 15px;font-family:'Archivo',sans-serif;font-weight:700;font-size:13.5px;color:var(--ink);cursor:pointer;transition:.13s;}
  .rl-type-chip:hover{border-color:var(--hcps-blue,#1681c2);color:var(--hcps-blue-dark,#0f5c8f);}
  .rl-type-chip.on{background:var(--hcps-blue,#1681c2);border-color:var(--hcps-blue,#1681c2);color:#fff;}

  .rl-filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:12px;background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:16px;box-shadow:0 10px 30px rgba(12,39,64,.05);align-items:center;}
  @media(max-width:900px){.rl-filters{grid-template-columns:1fr 1fr;}}
  @media(max-width:560px){.rl-filters{grid-template-columns:1fr;}}
  .rl-filters input,.rl-filters select{width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #d7dde3;border-radius:10px;font-size:14.5px;font-family:'Inter',sans-serif;color:var(--ink);background:#fff;}
  .rl-filters input:focus,.rl-filters select:focus{outline:none;border-color:var(--hcps-blue,#1681c2);box-shadow:0 0 0 3px rgba(22,129,194,.15);}
  .rl-count{grid-column:1/-1;font-size:13px;color:#6b7580;font-weight:600;margin-top:2px;}

  .rl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px;}
  @media(max-width:940px){.rl-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:600px){.rl-grid{grid-template-columns:1fr;}}
  .rl-card{background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:20px;box-shadow:0 8px 24px rgba(12,39,64,.05);display:flex;flex-direction:column;transition:transform .14s,box-shadow .14s,border-color .14s;}
  .rl-card:hover{transform:translateY(-3px);box-shadow:0 16px 38px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .rl-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 0 13px;}
  .rl-logo{height:26px;max-width:120px;object-fit:contain;}
  .rl-logo-txt{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;color:#6b7580;}
  .rl-badge{font-family:'Archivo',sans-serif;font-weight:800;font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;padding:5px 10px;border-radius:999px;white-space:nowrap;}
  .rl-t-catalog{background:#e7f1fb;color:#0f5c8f;}
  .rl-t-brochure{background:#e7f1fb;color:#0f5c8f;}
  .rl-t-service-guide{background:#e5f5f1;color:#0b6a55;}
  .rl-t-spec-sheet{background:#e5f5f1;color:#0b6a55;}
  .rl-t-credit-application{background:#efeafb;color:#5a3fb0;}
  .rl-t-form{background:#fdeadd;color:#c14a10;}
  .rl-t-price-list{background:#fdf3d6;color:#8a6400;}
  .rl-t-custom-price-list{background:#fdf3d6;color:#8a6400;}
  .rl-t-calculator{background:#e8f4f6;color:#0b6478;}
  .rl-t-training-video{background:#e9f6e5;color:#3a7d1f;}
  .rl-t-signage{background:#eef2f6;color:#334656;}
  /* legacy aliases (kept so any older type ids still render a chip) */
  .rl-t-guide{background:#e5f5f1;color:#0b6a55;}
  .rl-t-clinical{background:#efeafb;color:#5a3fb0;}
  .rl-t-marketing{background:#fdf3d6;color:#8a6400;}
  .rl-t-training{background:#e9f6e5;color:#3a7d1f;}
  .rl-t-resource{background:#eef2f6;color:#334656;}
  .rl-card h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;color:var(--ink);margin:0 0 7px;line-height:1.25;}
  .rl-card p{font-size:13.5px;line-height:1.5;color:#55606a;margin:0 0 16px;}
  .rl-card-foot{margin-top:auto;display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:12px;border-top:1px solid #eef1f4;}
  .rl-owner{font-size:12px;color:#8a94a0;font-weight:600;}
  .rl-act{display:inline-flex;align-items:center;gap:6px;font-family:'Archivo',sans-serif;font-weight:800;font-size:13px;text-decoration:none;padding:8px 13px;border-radius:9px;white-space:nowrap;}
  .rl-act.dl{background:var(--hcps-blue,#1681c2);color:#fff;}
  .rl-act.dl:hover{background:var(--hcps-blue-dark,#0f5c8f);}
  .rl-act.req{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;}
  .rl-act.order{background:var(--ink,#0b0d0f);color:#fff;}
  .rl-empty{text-align:center;color:#6b7580;padding:40px 0;font-size:15px;}

  .rl-band{background:linear-gradient(150deg,#12181d,#243746);color:#fff;border-radius:20px;padding:34px 38px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;box-shadow:0 20px 50px rgba(12,39,64,.14);}
  .rl-band h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(19px,2.3vw,26px);margin:0 0 6px;color:#fff;}
  .rl-band p{margin:0;color:rgba(255,255,255,.85);font-size:14.5px;max-width:58ch;}
  .rl-band-cta{display:flex;gap:10px;flex-wrap:wrap;}
</style>

{% set docs = documents %}

<!-- HERO -->
<section class="rl-hero">
  <div class="container">
    <span class="rl-eyebrow">HCPS Dealer Resource Library</span>
    <h1>Every dealer resource, in one place</h1>
    <p class="rl-lead">Explore catalogs, product guides, clinical publications, credit applications, and dealer resources from the {{ activeManufacturers.length }} HME &amp; DME manufacturers represented by HomeCare Provider Services. Filter by manufacturer, product category, or resource type and get to the right document fast.</p>
    <div class="rl-cta-row">
      <a class="rl-btn primary" href="#library">Browse Manufacturer Resources &rarr;</a>
      <a class="rl-btn ghost" href="/become-a-dealer/">Apply for a Dealer Account</a>
      <a class="rl-btn ghost" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Access Online Ordering</a>
    </div>
  </div>
</section>

<!-- FEATURED -->
<section class="rl-sec">
  <div class="container">
    <p class="rl-kicker">Featured &amp; most-used</p>
    <h2 class="rl-h2">Start here</h2>
    <div class="rl-grid">
      {% for doc in docs.items %}
      {% set owner = activeManufacturers | manuById(doc.manufacturer) %}
      {% if doc.featured and owner %}
      {% set ownerName = owner.name %}
      {% set ext = (doc.file if doc.file else doc.url) | string %}{% set isExt = "http" in ext %}
      <article class="rl-card">
        <div class="rl-card-head">
          {% if owner and owner.logo %}<img class="rl-logo" src="{{ owner.logo }}" alt="{{ ownerName }}" loading="lazy">{% else %}<span class="rl-logo-txt">{{ ownerName }}</span>{% endif %}
          <span class="rl-badge rl-t-{{ doc.type }}">{{ doc.type | typeLabel(docs.types) }}</span>
        </div>
        <h3>{{ doc.title }}</h3>
        <p>{{ doc.description }}</p>
        <div class="rl-card-foot">
          <span class="rl-owner">{{ ownerName }}</span>
          {% if doc.access == "request" %}<a class="rl-act req" href="{{ ext }}">Request &rarr;</a>
          {% elif doc.access == "dealer" %}<a class="rl-act order" href="{{ ext }}"{% if isExt %} target="_blank" rel="noopener"{% endif %}>Order Online &rarr;</a>
          {% else %}<a class="rl-act dl" href="{{ ext }}"{% if isExt %} target="_blank" rel="noopener"{% endif %}>{% if ".pdf" in ext %}Download &rarr;{% else %}View &rarr;{% endif %}</a>{% endif %}
        </div>
      </article>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>

<!-- FILTERABLE LIBRARY -->
<section class="rl-sec alt" id="library">
  <div class="container">
    <p class="rl-kicker">Resource directory</p>
    <h2 class="rl-h2">Find it by manufacturer, category &amp; type</h2>
    <p class="rl-sub">Pick a resource type, choose your manufacturer and product category, or search — for example, <b>Golden Technologies &rarr; Lift Chairs &rarr; Product Guides</b>, or <b>Access4U &rarr; Credit Applications</b>.</p>

    <div class="rl-types" id="rl-types">
      <button class="rl-type-chip on" data-type="">All types</button>
      {% for t in docs.types %}<button class="rl-type-chip" data-type="{{ t.id }}">{{ t.label }}</button>{% endfor %}
    </div>

    <div class="rl-filters" style="margin-top:12px;">
      <input type="search" id="rl-search" placeholder="Search resources — title, manufacturer, or keyword…" aria-label="Search resources">
      <select id="rl-manu" aria-label="Filter by manufacturer">
        <option value="">All manufacturers</option>
        {% for m in activeManufacturers %}<option value="{{ m.id }}">{{ m.name }}</option>{% endfor %}
      </select>
      <select id="rl-cat" aria-label="Filter by product category">
        <option value="">All categories</option>
        {% for c in resourceCategories %}<option value="{{ c.id }}">{{ c.label }}</option>{% endfor %}
      </select>
      <select id="rl-type" aria-label="Filter by resource type">
        <option value="">All resource types</option>
        {% for t in docs.types %}<option value="{{ t.id }}">{{ t.label }}</option>{% endfor %}
      </select>
      <span class="rl-count" id="rl-count"></span>
    </div>

    <div class="rl-grid" id="rl-list">
      {% for doc in docs.items %}
      {% set owner = activeManufacturers | manuById(doc.manufacturer) %}
      {% if owner %}
      {% set ownerName = owner.name %}
      {% set catId = owner.category | resourceCat %}
      {% set ext = (doc.file if doc.file else doc.url) | string %}{% set isExt = "http" in ext %}
      <article class="rl-card" data-manu="{{ doc.manufacturer }}" data-cat="{{ catId }}" data-type="{{ doc.type }}"
               data-search="{{ doc.title | lower }} {{ doc.description | lower }} {{ ownerName | lower }}">
        <div class="rl-card-head">
          {% if owner and owner.logo %}<img class="rl-logo" src="{{ owner.logo }}" alt="{{ ownerName }}" loading="lazy">{% else %}<span class="rl-logo-txt">{{ ownerName }}</span>{% endif %}
          <span class="rl-badge rl-t-{{ doc.type }}">{{ doc.type | typeLabel(docs.types) }}</span>
        </div>
        <h3>{{ doc.title }}</h3>
        <p>{{ doc.description }}</p>
        <div class="rl-card-foot">
          <span class="rl-owner">{{ ownerName }}</span>
          {% if doc.access == "request" %}<a class="rl-act req" href="{{ ext }}">Request &rarr;</a>
          {% elif doc.access == "dealer" %}<a class="rl-act order" href="{{ ext }}"{% if isExt %} target="_blank" rel="noopener"{% endif %}>Order Online &rarr;</a>
          {% else %}<a class="rl-act dl" href="{{ ext }}"{% if isExt %} target="_blank" rel="noopener"{% endif %}>{% if ".pdf" in ext %}Download &rarr;{% else %}View &rarr;{% endif %}</a>{% endif %}
        </div>
      </article>
      {% endif %}{% endfor %}
    </div>
    <p class="rl-empty" id="rl-none" hidden>No resources match those filters. Try clearing a filter, or <a href="/contact/?reason=General%20Question" style="color:var(--hcps-orange);font-weight:800;">ask Dealer Support</a>.</p>
  </div>
</section>

<!-- SUPPORT BAND -->
<section class="rl-sec">
  <div class="container">
    <div class="rl-band">
      <div>
        <h3>Can't find a document? We'll get it for you.</h3>
        <p>Catalogs, credit applications, pricing, clinical resources, or training materials — request anything from your HCPS team and we'll send the right file or set up your access.</p>
      </div>
      <div class="rl-band-cta">
        <a class="rl-btn primary" href="/contact/?reason=Dealer%20Support">Contact Dealer Support &rarr;</a>
        <a class="rl-btn ghost" style="border-color:rgba(255,255,255,.3);color:#fff;" href="/dealer-hub/?service=staff-in-service#schedule">Schedule an In-Service</a>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var search = document.getElementById('rl-search');
  var fManu = document.getElementById('rl-manu');
  var fCat  = document.getElementById('rl-cat');
  var fType = document.getElementById('rl-type');
  var chips = Array.prototype.slice.call(document.querySelectorAll('#rl-types .rl-type-chip'));
  var cards = Array.prototype.slice.call(document.querySelectorAll('#rl-list .rl-card'));
  var none  = document.getElementById('rl-none');
  var count = document.getElementById('rl-count');

  function apply() {
    var q = search.value.trim().toLowerCase();
    var m = fManu.value, c = fCat.value, t = fType.value, shown = 0;
    cards.forEach(function (card) {
      var ok = (!m || card.dataset.manu === m)
            && (!c || card.dataset.cat === c)
            && (!t || card.dataset.type === t)
            && (!q || card.dataset.search.indexOf(q) > -1);
      card.hidden = !ok;
      if (ok) shown++;
    });
    none.hidden = shown > 0;
    count.textContent = shown + (shown === 1 ? ' resource' : ' resources');
    chips.forEach(function (ch) { ch.classList.toggle('on', ch.dataset.type === t); });
  }
  [search, fManu, fCat, fType].forEach(function (el) {
    el.addEventListener('input', apply);
    el.addEventListener('change', apply);
  });
  chips.forEach(function (ch) {
    ch.addEventListener('click', function () { fType.value = ch.dataset.type; apply(); document.getElementById('library').scrollIntoView({behavior:'smooth',block:'start'}); });
  });
  // Deep-link: /resources/?manufacturer=<id>&category=<id>&type=<id>
  var qp = new URLSearchParams(location.search);
  if (qp.get('manufacturer')) fManu.value = qp.get('manufacturer');
  if (qp.get('category')) fCat.value = qp.get('category');
  if (qp.get('type')) fType.value = qp.get('type');
  apply();
})();
</script>
