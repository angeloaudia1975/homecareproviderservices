---
layout: layouts/base.njk
title: Become a Manufacturer Partner
permalink: /become-a-manufacturer-partner/
description: "Partner with HomeCare Provider Services for manufacturer representation across Southern Ohio, Southern Indiana, Kentucky, Tennessee, and Georgia — dealer relationships, market development, and sales growth without adding headcount."
eleventyExcludeFromCollections: true
---
{% set pg = pages.partner %}
<section class="hero" style="padding-bottom:56px;">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{{ pg.hero.eyebrow }}</p>
      <h1 style="font-size:clamp(30px,4.2vw,48px);color:#fff;">{{ pg.hero.headline }}</h1>
      <p class="lead">{{ pg.hero.lead }}</p>
      <div class="hero-actions">
        <a class="btn primary" href="#partner-form">{{ pg.hero.cta1_label }}</a>
        <a class="btn outline" href="#partner-territory">{{ pg.hero.cta2_label }}</a>
      </div>
    </div>
    {% if pg.hero.video %}
    <aside class="m-card" style="padding:14px;"><div class="m-video-wrap m-card-video"><iframe src="{{ pg.hero.video | embed }}" title="{{ site.name }}" loading="lazy" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div></aside>
    {% else %}
    <aside class="m-card" style="--m-accent:var(--hcps-orange);--m-dark:var(--hcps-blue-dark);">
      <h2>{{ pg.hero.card_title }}</h2>
      <ul>{% for b in pg.hero.card_bullets %}<li>{{ b }}</li>{% endfor %}</ul>
      <div class="m-hero-stats">
        <div class="m-stat"><strong>{{ site.stats.dealers }}</strong><span>Active Dealers</span></div>
        <div class="m-stat"><strong>{{ site.stats.states }}</strong><span>States</span></div>
        <div class="m-stat"><strong>{{ site.stats.manufacturers }}</strong><span>Partners</span></div>
      </div>
    </aside>
    {% endif %}
  </div>
</section>

<section class="why">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">{{ pg.why.eyebrow }}</p>
      <h2>{{ pg.why.title }}</h2>
    </div>
    <div class="why-grid">
      {% for c in pg.why.cards %}
      <article>
        <div class="why-icon{% if loop.index == 2 %} orange{% endif %}"></div>
        <h3>{{ c.title }}</h3>
        <p>{{ c.description }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="territory" id="partner-territory">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ pg.territory.eyebrow }}</p>
      <h2>{{ site.stats.states }} States. {{ site.stats.dealers }} Dealers. {{ site.stats.manufacturers }} Manufacturer Partners.</h2>
      <p>{{ pg.territory.intro }}</p>
    </div>
    <div class="territory-layout">
      <aside class="territory-copy">
        <h3>{{ home.territory_section.coverage_title }}</h3>
        <p>{{ home.territory_section.coverage_copy }}</p>
        <div class="territory-stats">
          <span><strong>{{ site.stats.states }}</strong>States</span>
          <span><strong>{{ site.stats.dealers }}</strong>Dealers</span>
          <span><strong>{{ site.stats.manufacturers }}</strong>Manufacturers</span>
        </div>
        <div class="region-list">
          <h4>Regional Coverage</h4>
          <ul>
            {% for r in site.territory.regions %}
            <li><strong>{{ r.name }}</strong><span>{{ r.rep }}</span></li>
            {% endfor %}
          </ul>
        </div>
      </aside>
      <div class="map-card">
        <div id="hcps-us-map"></div>
        <div class="map-legend">
          <span><i></i>Covered Territory</span>
          <span><i class="future"></i>Future Expansion</span>
          <span><i class="gray"></i>Not Currently Covered</span>
        </div>
      </div>
      <aside class="state-panel">
        <p class="eyebrow">State Detail</p>
        <h3 id="hcps-state-name">Hover a State</h3>
        <p id="hcps-state-status">Covered states are shown in blue. Future expansion opportunities are shown in orange.</p>
      </aside>
    </div>
  </div>
</section>

<section class="team">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">{{ pg.leadership.eyebrow }}</p>
      <h2>{{ pg.leadership.title }}</h2>
    </div>
    <div class="team-grid">
      {% for t in team %}
      <article class="team-card">
        {% if t.photo %}
        <div class="team-avatar has-photo" style="background-image:url('{{ t.photo }}')" role="img" aria-label="{{ t.name }}"></div>
        {% else %}
        <div class="team-avatar">{{ t.name[0] }}</div>
        {% endif %}
        <h3>{{ t.name }}</h3>
        <p class="team-role">{{ t.role }}</p>
        {% if t.phone_href %}<a href="tel:{{ t.phone_href }}">{{ t.phone_display }}</a>{% endif %}
        {% if t.email %}<a href="mailto:{{ t.email }}">{{ t.email }}</a>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="partner-form" style="background:#fff;">
  <div class="container" style="max-width:820px;">
    <div class="section-head center">
      <p class="eyebrow">{{ pg.form.eyebrow }}</p>
      <h2>{{ pg.form.title }}</h2>
      <p>{{ pg.form.intro }}</p>
    </div>

    <form id="partner-contact" class="hcps-form" novalidate>
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
      <input type="hidden" name="interest" value="Manufacturer Partnership">

      <div class="form-row">
        <div><label for="p-company">Company / Manufacturer *</label><input id="p-company" name="company" type="text" required></div>
        <div><label for="p-name">Primary contact *</label><input id="p-name" name="name" type="text" required></div>
      </div>
      <div class="form-row">
        <div><label for="p-email">Email *</label><input id="p-email" name="email" type="email" required></div>
        <div><label for="p-phone">Phone</label><input id="p-phone" name="phone" type="tel"></div>
      </div>
      <div class="form-row">
        <div><label for="p-website">Company website</label><input id="p-website" name="website" type="text" placeholder="https://"></div>
        <div><label for="p-line">Product line / category</label><input id="p-line" name="product_line" type="text" placeholder="e.g. respiratory, mobility, bracing"></div>
      </div>
      <div>
        <label for="p-markets">Markets / states you'd like coverage in</label>
        <input id="p-markets" name="markets" type="text" placeholder="e.g. Ohio, Kentucky, Tennessee — or 'open to recommendations'">
      </div>
      <div>
        <label for="p-dist">Current representation in these markets</label>
        <select id="p-dist" name="distribution">
          <option value="">Select…</option>
          <option value="New to the region — no current reps">New to the region — no current reps</option>
          <option value="Self-distributed / factory direct">Self-distributed / factory direct</option>
          <option value="Have reps but looking to expand">Have reps but looking to expand</option>
          <option value="Replacing current representation">Replacing current representation</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </div>
      <div>
        <label for="p-message">Tell us about your goals</label>
        <textarea id="p-message" name="message" placeholder="What products would you like represented, what markets matter most, and what does success look like for this partnership?"></textarea>
      </div>
      <div>
        <button type="submit" class="btn primary" id="p-submit">Submit Partnership Inquiry</button>
        <p class="form-status" id="p-status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p style="text-align:center;color:#5f6b7a;margin-top:26px;">
      Prefer to reach us directly? Call
      <a href="tel:{{ site.contact.phone_href }}" style="color:var(--hcps-blue-dark);font-weight:700;">{{ site.contact.phone_display }}</a>
      or email
      <a href="mailto:{{ site.contact.email }}" style="color:var(--hcps-blue-dark);font-weight:700;">{{ site.contact.email }}</a>.
    </p>
  </div>
</section>

<script src="https://cdn.amcharts.com/lib/5/index.js"></script>
<script src="https://cdn.amcharts.com/lib/5/map.js"></script>
<script src="https://cdn.amcharts.com/lib/5/geodata/usaLow.js"></script>
<script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>
<script>
(function () {
  var covered = {{ site.territory.covered_state_codes | dump | safe }};
  var future = {{ site.territory.expansion_state_codes | dump | safe }};
  function initMap() {
    var el = document.getElementById("hcps-us-map");
    if (!el || typeof am5 === "undefined") return;
    var root = am5.Root.new("hcps-us-map");
    root.setThemes([am5themes_Animated.new(root)]);
    var chart = root.container.children.push(am5map.MapChart.new(root, {
      panX: "none", panY: "none", wheelX: "none", wheelY: "none",
      projection: am5map.geoAlbersUsa()
    }));
    var series = chart.series.push(am5map.MapPolygonSeries.new(root, { geoJSON: am5geodata_usaLow }));
    series.mapPolygons.template.setAll({
      tooltipText: "{name}", interactive: true,
      stroke: am5.color(0x111820), strokeWidth: 1.2,
      fill: am5.color(0x3a4048), cursorOverStyle: "pointer"
    });
    series.mapPolygons.template.adapters.add("fill", function (fill, target) {
      var id = target.dataItem && target.dataItem.dataContext && target.dataItem.dataContext.id;
      if (covered.indexOf(id) > -1) return am5.color(0x1681c2);
      if (future.indexOf(id) > -1) return am5.color(0xef6325);
      return am5.color(0x3a4048);
    });
    series.mapPolygons.template.states.create("hover", {
      fill: am5.color(0xfcb21e), stroke: am5.color(0xffffff), strokeWidth: 2
    });
    series.mapPolygons.template.events.on("pointerover", function (ev) {
      var d = ev.target.dataItem.dataContext;
      var status = "Not currently covered.";
      if (covered.indexOf(d.id) > -1) {
        status = (d.id === "US-OH" || d.id === "US-IN")
          ? "Active HCPS territory — concentrated in southern " + d.name + "."
          : "Active HCPS distribution territory — " + d.name + " dealers order directly through us.";
      } else if (future.indexOf(d.id) > -1) {
        status = "Future expansion opportunity for HCPS.";
      }
      document.getElementById("hcps-state-name").textContent = d.name;
      document.getElementById("hcps-state-status").textContent = status;
    });
    series.events.on("datavalidated", function () { chart.goHome(); });
    chart.appear(800, 100);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initMap);
  else initMap();
})();
</script>

<script>
(function () {
  var form = document.getElementById("partner-contact");
  var status = document.getElementById("p-status");
  var submit = document.getElementById("p-submit");
  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    status.textContent = "";
    var data = Object.fromEntries(new FormData(form).entries());
    if (!data.company || !data.name || !data.email) {
      status.className = "form-status error";
      status.textContent = "Please fill in company, contact name, and email.";
      return;
    }
    submit.disabled = true;
    var original = submit.textContent;
    submit.textContent = "Sending…";
    try {
      var res = await fetch("/.netlify/functions/contact", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data)
      });
      var out = await res.json();
      if (res.ok && out.ok) {
        form.reset();
        status.className = "form-status ok";
        status.textContent = "Thank you — your inquiry has been sent. A HCPS principal will follow up shortly.";
      } else {
        status.className = "form-status error";
        status.textContent = out.error || "Something went wrong. Please email info@homecareproviderservices.us.";
      }
    } catch (err) {
      status.className = "form-status error";
      status.textContent = "Network error. Please email info@homecareproviderservices.us.";
    } finally {
      submit.disabled = false;
      submit.textContent = original;
    }
  });
})();
</script>
