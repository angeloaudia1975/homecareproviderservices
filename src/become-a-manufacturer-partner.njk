{% set relatedPages = [
  { href: "/manufacturers/", label: "Manufacturers", blurb: "See the partners we already represent." },
  { href: "/consulting/", label: "Consulting", blurb: "How we develop dealers and their showrooms." },
  { href: "/contact/", label: "Contact", blurb: "Talk to the HCPS partnerships team." }
] %}
{% include "related.njk" %}

<script>
(function () {
  var API = "/.netlify/functions/schedule-api";
  var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]; }); };
  var TZ = (function () { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) { return ""; } })();
  var $ = function (id) { return document.getElementById(id); };
  var BOOK = { start_utc: null, label: null };
  function val(id) { var e = $(id); return e ? (e.value || "").trim() : ""; }
  function fields() { return { company: val("mp-company"), name: val("mp-name"), email: val("mp-email"), phone: val("mp-phone"), website: val("mp-website"), product_category: val("mp-category"), states: val("mp-states"), territory_needs: val("mp-territory"), description: val("mp-desc") }; }
  async function api(payload) { var r = await fetch(API, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) }); return r.json(); }

  $("mp-find").addEventListener("click", async function () {
    var st = $("mp-status"); st.textContent = ""; st.className = "mp-status";
    var f = fields();
    if (!f.company || !f.name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email)) { st.className = "mp-status error"; st.textContent = "Please add your company, contact name, and a valid email."; return; }
    var btn = $("mp-find"); btn.disabled = true; var o = btn.textContent; btn.textContent = "Loading times…";
    try {
      var s = await api({ action: "partner_slots", tz: TZ });
      if (!s || !s.ok) { st.className = "mp-status error"; st.textContent = (s && s.message) || "Couldn't load times. Please email us."; return; }
      renderSlots(s);
    } catch (e) { st.className = "mp-status error"; st.textContent = "Network error. Please try again."; }
    finally { btn.disabled = false; btn.textContent = o; }
  });

  function renderSlots(s) {
    $("mp-step-form").style.display = "none"; $("mp-step-done").style.display = "none"; $("mp-step-slots").style.display = "";
    $("mp-confirm").style.display = "none"; BOOK.start_utc = null;
    var days = $("mp-days");
    if (!s.days || !s.days.length) { days.innerHTML = '<p style="font-size:13px;color:#54606c;">No open times in the next few weeks. Please call us and we\'ll find a time.</p>'; return; }
    days.innerHTML = s.days.map(function (d) {
      var head = new Date(d.date + "T12:00:00Z").toLocaleDateString("en-US", { weekday: "long", month: "short", day: "numeric" });
      return '<div class="mp-day"><div class="dh">' + esc(head) + '</div><div class="mp-slotrow">' +
        d.slots.map(function (sl) { return '<button type="button" class="mp-slot" data-start="' + esc(sl.start_utc) + '" data-label="' + esc(sl.label) + '">' + esc(sl.label) + ' CT</button>'; }).join("") +
        '</div></div>';
    }).join("");
    days.querySelectorAll(".mp-slot").forEach(function (btn) {
      btn.addEventListener("click", function () {
        days.querySelectorAll(".mp-slot.on").forEach(function (x) { x.classList.remove("on"); });
        btn.classList.add("on"); BOOK.start_utc = btn.getAttribute("data-start"); BOOK.label = btn.getAttribute("data-label");
        var head = btn.closest(".mp-day").querySelector(".dh").textContent;
        showConfirm(s, head);
      });
    });
  }

  function showConfirm(s, head) {
    var c = $("mp-confirm"); c.style.display = "";
    c.innerHTML = '<div style="border-top:1px solid #eef2f6;margin-top:12px;padding-top:12px;">' +
      '<button class="mp-btn primary go" id="mp-confirm-btn" type="button">Confirm partnership meeting — ' + esc(head) + ' at ' + esc(BOOK.label) + ' CT →</button>' +
      '<p class="mp-status" id="mp-confirm-status" role="status" aria-live="polite"></p></div>';
    $("mp-confirm-btn").addEventListener("click", doBook);
    c.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  async function doBook() {
    var cs = $("mp-confirm-status"); cs.textContent = ""; cs.className = "mp-status";
    var btn = $("mp-confirm-btn"); if (!BOOK.start_utc) { cs.className = "mp-status error"; cs.textContent = "Pick a time first."; return; }
    btn.disabled = true; var o = btn.textContent; btn.textContent = "Booking…";
    try {
      var payload = Object.assign({ action: "partner_book", start_utc: BOOK.start_utc, tz: TZ }, fields());
      var out = await api(payload);
      if (out && out.ok) {
        $("mp-step-slots").style.display = "none"; $("mp-step-done").style.display = "";
        $("mp-step-done").innerHTML = '<div class="mp-done"><h3>Your meeting is booked ✓</h3><p>' + esc(out.message || "") + '</p>' +
          (out.zoom_link ? '<a class="zoom" href="' + esc(out.zoom_link) + '" target="_blank" rel="noopener">Zoom link: ' + esc(out.zoom_link) + '</a>' : "") + '</div>';
      } else if (out && out.error === "slot_taken") {
        cs.className = "mp-status error"; cs.textContent = out.message || "That time was just taken — pick another.";
        var s2 = await api({ action: "partner_slots", tz: TZ }); if (s2 && s2.ok) renderSlots(s2);
      } else { cs.className = "mp-status error"; cs.textContent = (out && out.message) || "Couldn't book that time. Please email us."; }
    } catch (e) { cs.className = "mp-status error"; cs.textContent = "Network error. Please try again."; }
    finally { btn.disabled = false; btn.textContent = o; }
  }

  $("mp-back").addEventListener("click", function () { $("mp-step-slots").style.display = "none"; $("mp-step-form").style.display = ""; });
})();
</script>
