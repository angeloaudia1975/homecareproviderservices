---
layout: layouts/base.njk
title: Become a Dealer
permalink: /become-a-dealer/
description: "Become a HomeCare Provider Services dealer and access premium HME and DME product lines, competitive dealer pricing, expert support, 24/7 online ordering, and access to our exclusive Showroom Designer Platform. Start your dealer account today."
---
<style>
  .bd-hero{position:relative;overflow:hidden;background:linear-gradient(150deg,#0c2740 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:64px 0 58px;}
  .bd-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.28),transparent 62%);pointer-events:none;}
  .bd-hero .container{position:relative;z-index:1;}
  .bd-eyebrow{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:7px 15px;font-family:'Archivo',sans-serif;font-weight:800;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 16px;}
  .bd-hero h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(30px,4.6vw,52px);line-height:1.05;margin:0 0 16px;max-width:16ch;}
  .bd-hero .bd-lead{font-size:clamp(16px,1.5vw,18.5px);line-height:1.55;color:rgba(255,255,255,.9);max-width:70ch;margin:0 0 26px;}
  .bd-cta-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;}
  .bd-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:15px;text-decoration:none;border-radius:11px;padding:14px 24px;transition:transform .12s,filter .12s,box-shadow .12s;border:1px solid transparent;}
  .bd-btn:hover{transform:translateY(-1px);}
  .bd-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .bd-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.28);}
  .bd-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .bd-btn.blue{background:var(--hcps-blue,#1681c2);color:#fff;box-shadow:0 14px 30px -12px rgba(22,129,194,.6);}
  .bd-btn.dark{background:var(--ink,#0b0d0f);color:#fff;}
  .bd-btn.sm{padding:11px 18px;font-size:13.5px;}
  .bd-trust{display:flex;gap:22px;flex-wrap:wrap;margin-top:26px;color:rgba(255,255,255,.82);font-size:13.5px;font-weight:600;}
  .bd-trust b{color:#fcb21e;font-family:'Archivo Expanded','Archivo',sans-serif;}

  .bd-stats{background:var(--ink,#0b0d0f);color:#fff;}
  .bd-stats .container{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;padding-top:0;padding-bottom:0;}
  @media(max-width:720px){.bd-stats .container{grid-template-columns:repeat(2,1fr);}}
  .bd-stat{padding:22px 18px;text-align:center;}
  .bd-stat b{display:block;font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:30px;line-height:1;color:#fff;}
  .bd-stat span{display:block;margin-top:6px;font-size:12.5px;color:#aeb7c0;font-weight:600;text-transform:uppercase;letter-spacing:.05em;}

  .bd-sec{padding:58px 0;}
  .bd-sec.alt{background:var(--paper,#f6f7f5);}
  .bd-head{max-width:64ch;margin:0 0 34px;}
  .bd-kicker{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hcps-blue,#1681c2);margin:0 0 10px;}
  .bd-h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(24px,3vw,36px);line-height:1.1;color:var(--ink);margin:0 0 12px;}
  .bd-sub{font-size:16px;line-height:1.6;color:#48525c;margin:0;}

  .bd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  @media(max-width:920px){.bd-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:600px){.bd-grid{grid-template-columns:1fr;}}
  .bd-card{background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:24px 22px;box-shadow:0 10px 30px rgba(12,39,64,.05);transition:transform .14s,box-shadow .14s,border-color .14s;display:flex;flex-direction:column;}
  .bd-card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .bd-ico{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;margin:0 0 15px;background:linear-gradient(135deg,#e9f3fb,#d5e8f6);color:var(--hcps-blue-dark,#0f5c8f);}
  .bd-ico.orange{background:linear-gradient(135deg,#fde7d8,#fbd3b4);color:#c14a10;}
  .bd-ico svg{width:24px;height:24px;}
  .bd-card h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:17.5px;color:var(--ink);margin:0 0 8px;}
  .bd-card p{font-size:14px;line-height:1.55;color:#55606a;margin:0 0 14px;}
  .bd-card .bd-link{margin-top:auto;font-family:'Archivo',sans-serif;font-weight:800;font-size:13.5px;color:var(--hcps-orange,#ef6325);text-decoration:none;}
  .bd-card .bd-link:hover{text-decoration:underline;}

  .bd-spot{display:grid;grid-template-columns:1.1fr .9fr;gap:0;border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(12,39,64,.14);}
  @media(max-width:860px){.bd-spot{grid-template-columns:1fr;}}
  .bd-spot-main{padding:40px;color:#fff;}
  .bd-spot.blue .bd-spot-main{background:linear-gradient(150deg,#0f5c8f,#1681c2);}
  .bd-spot.dark .bd-spot-main{background:linear-gradient(150deg,#12181d,#243746);}
  .bd-spot-main .bd-kicker{color:#fcb21e;}
  .bd-spot-main h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(22px,2.6vw,30px);line-height:1.12;margin:0 0 12px;color:#fff;}
  .bd-spot-main p{font-size:15px;line-height:1.6;color:rgba(255,255,255,.9);margin:0 0 20px;}
  .bd-spot-list{list-style:none;padding:0;margin:0 0 24px;display:grid;gap:10px;}
  .bd-spot-list li{position:relative;padding-left:28px;font-size:14.5px;color:rgba(255,255,255,.95);}
  .bd-spot-list li::before{content:"";position:absolute;left:0;top:1px;width:18px;height:18px;border-radius:50%;background:#fcb21e url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23141414' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>") center/11px no-repeat;}
  .bd-spot-side{background:#0a1219;color:#fff;padding:34px;display:flex;flex-direction:column;justify-content:center;gap:14px;}
  .bd-mini{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-left:3px solid #fcb21e;border-radius:12px;padding:15px 17px;}
  .bd-mini b{display:block;font-family:'Archivo Expanded','Archivo',sans-serif;font-size:22px;color:#fff;line-height:1;}
  .bd-mini span{display:block;margin-top:5px;font-size:12.5px;color:rgba(255,255,255,.72);}

  .bd-logos{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media(max-width:860px){.bd-logos{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:560px){.bd-logos{grid-template-columns:repeat(2,1fr);}}
  .bd-logo{background:#fff;border:1px solid #e5e9ee;border-radius:14px;padding:18px 16px 14px;text-align:center;text-decoration:none;transition:transform .14s,box-shadow .14s,border-color .14s;display:flex;flex-direction:column;align-items:center;}
  .bd-logo:hover{transform:translateY(-3px);box-shadow:0 16px 34px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .bd-logo img{height:46px;width:auto;max-width:100%;object-fit:contain;margin:0 0 12px;}
  .bd-logo b{font-family:'Archivo',sans-serif;font-weight:800;font-size:14px;color:var(--ink);line-height:1.2;}
  .bd-logo span{font-size:12px;color:#6b7580;margin-top:4px;line-height:1.35;}

  .bd-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
  @media(max-width:860px){.bd-steps{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.bd-steps{grid-template-columns:1fr;}}
  .bd-step{background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:24px 20px;position:relative;}
  .bd-step .bd-num{width:42px;height:42px;border-radius:50%;background:linear-gradient(120deg,#ef6325,#fcb21e);color:#141414;display:grid;place-items:center;font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:18px;margin:0 0 14px;}
  .bd-step h4{font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;color:var(--ink);margin:0 0 7px;}
  .bd-step p{font-size:13.5px;line-height:1.5;color:#55606a;margin:0;}

  .bd-final{background:linear-gradient(150deg,#0c2740,#0f5c8f);color:#fff;padding:60px 0;}
  .bd-final .bd-h2{color:#fff;}
  .bd-final .bd-sub{color:rgba(255,255,255,.85);}
  .bd-form{background:#fff;border-radius:20px;padding:30px;box-shadow:0 24px 60px rgba(0,0,0,.28);max-width:760px;margin:26px auto 0;}
  .bd-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media(max-width:600px){.bd-form .form-row{grid-template-columns:1fr;}}
  .bd-form label{display:block;font-family:'Archivo',sans-serif;font-weight:700;font-size:13px;color:var(--ink);margin:14px 0 6px;}
  .bd-form input,.bd-form select,.bd-form textarea{width:100%;box-sizing:border-box;padding:12px 13px;border:1px solid #d7dde3;border-radius:10px;font-size:15px;font-family:'Inter',sans-serif;color:var(--ink);background:#fff;}
  .bd-form textarea{min-height:104px;resize:vertical;}
  .bd-form input:focus,.bd-form select:focus,.bd-form textarea:focus{outline:none;border-color:var(--hcps-blue,#1681c2);box-shadow:0 0 0 3px rgba(22,129,194,.15);}
  .bd-form .form-status{margin:12px 0 0;font-size:14px;font-weight:600;}
  .bd-form .form-status.ok{color:#166b45;}
  .bd-form .form-status.error{color:#b42323;}
</style>

<!-- HERO -->
<section class="bd-hero">
  <div class="container">
    <span class="bd-eyebrow">HCPS Dealer Program</span>
    <h1>Become a HomeCare Provider Services Dealer</h1>
    <p class="bd-lead">Access premium HME &amp; DME product lines, competitive dealer pricing, expert support, 24/7 online ordering, and our exclusive Showroom Designer Platform. HCPS gives you more than products — it gives you an entire dealer growth platform built around pricing, ordering, training, showroom development, marketing, and ongoing support.</p>
    <div class="bd-cta-row">
      <a class="bd-btn primary" href="#apply">Start Your Dealer Account &rarr;</a>
      <a class="bd-btn ghost" href="/manufacturers/">Explore Our Manufacturer Partners</a>
      <a class="bd-btn ghost" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Access Online Ordering</a>
    </div>
    <div class="bd-trust">
      <span><b>{{ site.stats.dealers }}</b> Active dealers</span>
      <span><b>{{ activeManufacturers.length }}</b> Manufacturer partners</span>
      <span><b>{{ site.stats.states }}</b>-state territory</span>
      <span>Trusted since <b>{{ site.founded }}</b></span>
    </div>
  </div>
</section>

<!-- STAT STRIP -->
<section class="bd-stats">
  <div class="container">
    <div class="bd-stat"><b>{{ site.stats.dealers }}</b><span>Active Dealers</span></div>
    <div class="bd-stat"><b>{{ activeManufacturers.length }}</b><span>Premium Lines</span></div>
    <div class="bd-stat"><b>24/7</b><span>Online Ordering</span></div>
    <div class="bd-stat"><b>Since {{ site.founded }}</b><span>{{ site.tagline }}</span></div>
  </div>
</section>

<!-- BENEFIT GRID -->
<section class="bd-sec">
  <div class="container">
    <div class="bd-head">
