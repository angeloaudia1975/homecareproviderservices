          <a class="bd-btn primary" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Access Online Ordering &rarr;</a>
          <a class="bd-btn ghost" href="#apply">Get your dealer login</a>
        </div>
      </div>
      <div class="bd-spot-side">
        <div class="bd-mini"><b>24/7</b><span>ordering, every day of the year</span></div>
        <div class="bd-mini"><b>Live</b><span>dealer pricing &amp; availability</span></div>
        <div class="bd-mini"><b>1 login</b><span>ordering &middot; pricing &middot; resources</span></div>
      </div>
    </div>
  </div>
</section>

<!-- MANUFACTURER PARTNERS -->
<section class="bd-sec alt">
  <div class="container">
    <div class="bd-head">
      <p class="bd-kicker">Premium HME &amp; DME lines</p>
      <h2 class="bd-h2">Explore our manufacturer partners</h2>
      <p class="bd-sub">A curated portfolio across the categories today's home-medical-equipment dealers actually sell — from advanced mobility and respiratory to bracing, bath safety, and lifts.</p>
    </div>
    <div class="bd-logos">
      {% for m in activeManufacturers %}
      <a class="bd-logo" href="/manufacturers/{{ m.id }}/">
        {% if m.logo %}<img src="{{ m.logo }}" alt="{{ m.name }}" loading="lazy">{% endif %}
        <b>{{ m.name }}</b>
        {% if m.category %}<span>{{ m.category }}</span>{% endif %}
      </a>
      {% endfor %}
    </div>
    <div style="margin-top:26px;">
      <a class="bd-btn blue" href="/manufacturers/">View all manufacturer partners &rarr;</a>
    </div>
  </div>
</section>

<!-- ONBOARDING -->
<section class="bd-sec" id="onboarding">
  <div class="container">
    <div class="bd-head">
      <p class="bd-kicker">Simple dealer onboarding</p>
      <h2 class="bd-h2">From application to your first order</h2>
      <p class="bd-sub">A clear, guided path — most dealers are set up and ordering quickly, with a regional consultant helping every step of the way.</p>
    </div>
    <div class="bd-steps">
      <div class="bd-step"><div class="bd-num">1</div><h4>Apply</h4><p>Tell us your company and the lines you're interested in. A regional consultant follows up personally.</p></div>
      <div class="bd-step"><div class="bd-num">2</div><h4>Establish accounts</h4><p>We help set up your manufacturer accounts across the product lines you choose to carry.</p></div>
      <div class="bd-step"><div class="bd-num">3</div><h4>Receive credentials</h4><p>Get your online ordering logins and dealer pricing access, ready to use right away.</p></div>
      <div class="bd-step"><div class="bd-num">4</div><h4>Start ordering</h4><p>Order 24/7, tap into resources and training, and book a showroom consultation whenever you're ready.</p></div>
    </div>
  </div>
</section>

<!-- FINAL CTA + APPLICATION -->
<section class="bd-final" id="apply">
  <div class="container">
    <div class="bd-head" style="max-width:70ch;">
      <p class="bd-kicker" style="color:#fcb21e;">Start today</p>
      <h2 class="bd-h2">Become an HCPS dealer</h2>
      <p class="bd-sub">Start your dealer account and get access to premium lines, dealer pricing, 24/7 ordering, the Showroom Designer Platform, and hands-on support. Tell us a little about your business and a regional consultant will reach out.</p>
    </div>

    <form id="dealer-form" class="bd-form" novalidate>
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
      <input type="hidden" name="manufacturer" id="form-manufacturer" value="">
      <div class="form-row">
        <div><label for="f-name">Name *</label><input id="f-name" name="name" type="text" required></div>
        <div><label for="f-company">Company / Dealer name *</label><input id="f-company" name="company" type="text" required></div>
      </div>
      <div class="form-row">
        <div><label for="f-email">Email *</label><input id="f-email" name="email" type="email" required></div>
        <div><label for="f-phone">Phone</label><input id="f-phone" name="phone" type="tel"></div>
      </div>
      <div>
        <label for="f-interest">Primary interest</label>
        <select id="f-interest" name="interest">
          <option value="">Select…</option>
          <option value="Complete HCPS dealer program">Complete HCPS dealer program</option>
          <option value="Competitive dealer pricing">Competitive dealer pricing</option>
          <option value="24/7 online ordering access">24/7 online ordering access</option>
          <option value="Showroom Designer / consultation">Showroom Designer / consultation</option>
          <option value="Training / account development">Training / account development</option>
          {% for m in activeManufacturers %}<option value="{{ m.name }}">{{ m.name }}</option>{% endfor %}
        </select>
      </div>
      <div>
        <label for="f-message">Message</label>
        <textarea id="f-message" name="message" placeholder="Tell us about your showroom, the lines you carry today, and what you'd like from HCPS."></textarea>
      </div>
      <div>
        <button type="submit" class="bd-btn primary" id="f-submit" style="border:none;cursor:pointer;">Start Your Dealer Account</button>
        <p class="form-status" id="f-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script>
(function () {
  var form = document.getElementById("dealer-form");
  var status = document.getElementById("f-status");
  var submit = document.getElementById("f-submit");

  var params = new URLSearchParams(location.search);
  var mf = params.get("manufacturer");
  if (mf) {
    document.getElementById("form-manufacturer").value = mf;
    var sel = document.getElementById("f-interest");
    for (var i = 0; i < sel.options.length; i++) {
      if (sel.options[i].value.toLowerCase().replace(/[^a-z0-9]/g,"") === mf.toLowerCase().replace(/[^a-z0-9]/g,"")) {
        sel.selectedIndex = i; break;
      }
    }
  }

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    status.textContent = "";
    var data = Object.fromEntries(new FormData(form).entries());
    if (!data.name || !data.company || !data.email) {
      status.className = "form-status error";
      status.textContent = "Please fill in name, company, and email.";
      return;
    }
    submit.disabled = true;
    var original = submit.textContent;
    submit.textContent = "Sending…";
    try {
      var res = await fetch("/.netlify/functions/contact", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data)
      });
      var out = await res.json();
      if (res.ok && out.ok) {
        form.reset();
        status.className = "form-status ok";
        status.textContent = "Thank you — your dealer request has been sent. A regional consultant will be in touch shortly.";
      } else {
        status.className = "form-status error";
        status.textContent = out.error || "Something went wrong. Please email info@homecareproviderservices.us.";
      }
    } catch {
      status.className = "form-status error";
      status.textContent = "Network error. Please email info@homecareproviderservices.us.";
    } finally {
      submit.disabled = false;
      submit.textContent = original;
    }
  });
})();
</script>
