<!-- SPOTLIGHT: SHOWROOM DESIGNER -->
<section class="bd-sec alt" id="showroom">
  <div class="container">
    <div class="bd-spot blue">
      <div class="bd-spot-main">
        <p class="bd-kicker">Exclusive to HCPS dealers</p>
        <h3>The Showroom Designer Platform</h3>
        <p>Most rep groups hand you a catalog and walk away. HCPS helps you design the room. Plan where each line lives on your floor, model the mix that drives the most revenue per square foot, and give shoppers a showroom that sells for you.</p>
        <ul class="bd-spot-list">
          <li>Plan product placement and traffic flow across your floor</li>
          <li>Optimize layouts for the categories that convert</li>
          <li>Build a more profitable, better-merchandised product mix</li>
          <li>Walkthroughs and merchandising guidance from your consultant</li>
        </ul>
        <a class="bd-btn primary" href="/consulting/">Request a Showroom Consultation &rarr;</a>
      </div>
      <div class="bd-spot-side">
        <div class="bd-mini"><b>More revenue</b><span>per square foot of showroom floor</span></div>
        <div class="bd-mini"><b>Hands-on</b><span>in-person walkthroughs &amp; merchandising</span></div>
        <div class="bd-mini"><b>Right mix</b><span>lines matched to your market</span></div>
      </div>
    </div>
  </div>
</section>

<!-- SPOTLIGHT: ORDERING -->
<section class="bd-sec">
  <div class="container">
    <div class="bd-spot dark">
      <div class="bd-spot-main">
        <p class="bd-kicker">Order anytime, from anywhere</p>
        <h3>24/7 Online Ordering &amp; Dealer Access</h3>
