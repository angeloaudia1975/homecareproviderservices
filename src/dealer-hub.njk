---
layout: layouts/base.njk
title: Dealer Hub
permalink: /dealer-hub/
description: "The Dealer Hub is your central destination for manufacturer resources, order requests, product literature, dealer pricing, in-service scheduling, technical support, and dealer login tools—all designed to make managing your HCPS manufacturer relationships faster and easier."
---
<style>
  .dh-hero{position:relative;overflow:hidden;background:linear-gradient(150deg,#0c2740 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:60px 0 52px;}
  .dh-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.26),transparent 62%);pointer-events:none;}
  .dh-hero .container{position:relative;z-index:1;}
  .dh-eyebrow{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:7px 15px;font-family:'Archivo',sans-serif;font-weight:800;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 15px;}
  .dh-hero h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(28px,4.4vw,48px);line-height:1.05;margin:0 0 14px;max-width:18ch;}
  .dh-hero .dh-lead{font-size:clamp(15.5px,1.4vw,18px);line-height:1.55;color:rgba(255,255,255,.9);max-width:74ch;margin:0 0 24px;}
  .dh-cta-row{display:flex;gap:11px;flex-wrap:wrap;align-items:center;}
  .dh-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:14.5px;text-decoration:none;border-radius:11px;padding:13px 22px;transition:transform .12s,box-shadow .12s;border:1px solid transparent;cursor:pointer;}
  .dh-btn:hover{transform:translateY(-1px);}
  .dh-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .dh-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.28);}
  .dh-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .dh-btn.blue{background:var(--hcps-blue,#1681c2);color:#fff;}
  .dh-btn.sm{padding:10px 16px;font-size:13px;}

  .dh-sec{padding:50px 0;}
  .dh-sec.alt{background:var(--paper,#f6f7f5);}
  .dh-head{max-width:66ch;margin:0 0 28px;}
  .dh-kicker{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hcps-blue,#1681c2);margin:0 0 9px;}
  .dh-h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(23px,2.9vw,34px);line-height:1.1;color:var(--ink);margin:0 0 11px;}
  .dh-sub{font-size:15.5px;line-height:1.55;color:#48525c;margin:0;}

  .dh-svc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  @media(max-width:900px){.dh-svc-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:560px){.dh-svc-grid{grid-template-columns:1fr;}}
  .dh-svc{background:#fff;border:1px solid #e5e9ee;border-radius:16px;padding:22px 20px;box-shadow:0 8px 24px rgba(12,39,64,.05);display:flex;flex-direction:column;transition:transform .14s,box-shadow .14s,border-color .14s;}
  .dh-svc:hover{transform:translateY(-3px);box-shadow:0 16px 38px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .dh-ico{width:60px;height:60px;border-radius:14px;display:grid;place-items:center;margin:0 0 13px;overflow:hidden;background:#fff;}
  .dh-ico img{width:100%;height:100%;object-fit:contain;display:block;}
  .dh-svc h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;color:var(--ink);margin:0 0 6px;line-height:1.2;}
  .dh-svc .mode{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:#8a94a0;margin:0 0 8px;}
  .dh-svc p{font-size:13.5px;line-height:1.5;color:#55606a;margin:0 0 15px;}
  .dh-svc .go{margin-top:auto;font-family:'Archivo',sans-serif;font-weight:800;font-size:13.5px;color:#fff;background:var(--hcps-blue,#1681c2);border:none;border-radius:9px;padding:10px 15px;cursor:pointer;align-self:flex-start;transition:background .13s;}
  .dh-svc .go:hover{background:var(--hcps-blue-dark,#0f5c8f);}
  .dh-svc.o .go{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;}

  /* Showroom highlight */
  .dh-spot{display:grid;grid-template-columns:1.1fr .9fr;gap:0;border-radius:20px;overflow:hidden;box-shadow:0 20px 50px rgba(12,39,64,.14);margin-top:26px;}
  @media(max-width:820px){.dh-spot{grid-template-columns:1fr;}}
  .dh-spot-main{background:linear-gradient(150deg,#0f5c8f,#1681c2);color:#fff;padding:36px;}
  .dh-spot-main .dh-kicker{color:#fcb21e;}
  .dh-spot-main h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(21px,2.5vw,28px);margin:0 0 10px;color:#fff;}
  .dh-spot-main p{color:rgba(255,255,255,.9);font-size:14.5px;line-height:1.6;margin:0 0 18px;}
  .dh-spot-list{list-style:none;padding:0;margin:0 0 22px;display:grid;gap:9px;}
  .dh-spot-list li{position:relative;padding-left:27px;font-size:14px;color:rgba(255,255,255,.95);}
  .dh-spot-list li::before{content:"";position:absolute;left:0;top:1px;width:17px;height:17px;border-radius:50%;background:#fcb21e url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23141414' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>") center/10px no-repeat;}
  .dh-spot-side{background:#0a1219;color:#fff;padding:30px;display:flex;flex-direction:column;justify-content:center;gap:12px;}
  .dh-mini{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-left:3px solid #fcb21e;border-radius:12px;padding:14px 16px;}
  .dh-mini b{display:block;font-family:'Archivo Expanded','Archivo',sans-serif;font-size:19px;color:#fff;line-height:1.05;}
  .dh-mini span{display:block;margin-top:4px;font-size:12px;color:rgba(255,255,255,.72);}

  /* Scheduling form */
  .dh-form-wrap{display:grid;grid-template-columns:1.4fr .9fr;gap:26px;align-items:start;}
  @media(max-width:900px){.dh-form-wrap{grid-template-columns:1fr;}}
  .dh-form{background:#fff;border-radius:20px;padding:30px;box-shadow:0 20px 50px rgba(12,39,64,.1);border:1px solid #e5e9ee;}
  .dh-form .row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media(max-width:560px){.dh-form .row{grid-template-columns:1fr;}}
  .dh-form label{display:block;font-family:'Archivo',sans-serif;font-weight:700;font-size:13px;color:var(--ink);margin:14px 0 6px;}
  .dh-form input,.dh-form select,.dh-form textarea{width:100%;box-sizing:border-box;padding:12px 13px;border:1px solid #d7dde3;border-radius:10px;font-size:15px;font-family:'Inter',sans-serif;color:var(--ink);background:#fff;}
  .dh-form textarea{min-height:96px;resize:vertical;}
  .dh-form input:focus,.dh-form select:focus,.dh-form textarea:focus{outline:none;border-color:var(--hcps-blue,#1681c2);box-shadow:0 0 0 3px rgba(22,129,194,.15);}
  .dh-modes{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;}
  .dh-modes label{display:inline-flex;align-items:center;gap:7px;margin:0;font-weight:600;font-size:13.5px;color:#33404b;background:#f4f7fa;border:1px solid #dfe6ee;border-radius:9px;padding:9px 13px;cursor:pointer;}
  .dh-modes input{width:auto;}
  .dh-form .btn-primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;font-family:'Archivo',sans-serif;font-weight:800;font-size:15px;border:none;border-radius:11px;padding:14px 24px;cursor:pointer;margin-top:16px;box-shadow:0 12px 26px -12px rgba(239,99,37,.7);}
  .dh-form .form-status{margin:12px 0 0;font-size:14px;font-weight:600;}
  .dh-form .form-status.ok{color:#166b45;}
  .dh-form .form-status.error{color:#b42323;}
  .dh-flow{background:linear-gradient(150deg,#0c2740,#0f5c8f);color:#fff;border-radius:20px;padding:26px;}
  .dh-flow h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:16px;margin:0 0 14px;color:#fff;}
  .dh-flow ol{list-style:none;counter-reset:f;padding:0;margin:0;display:grid;gap:11px;}
  .dh-flow li{counter-increment:f;position:relative;padding-left:38px;font-size:13.5px;color:rgba(255,255,255,.9);line-height:1.4;}
  .dh-flow li::before{content:counter(f);position:absolute;left:0;top:-1px;width:26px;height:26px;border-radius:50%;background:linear-gradient(120deg,#ef6325,#fcb21e);color:#141414;font-family:'Archivo Expanded',sans-serif;font-weight:800;font-size:13px;display:grid;place-items:center;}

  /* Self-booker */
  .dh-avail{background:#eef4fb;border:1px solid #cfe0ef;border-radius:10px;padding:10px 13px;font-size:12.5px;color:#33404b;margin:12px 0 4px;line-height:1.5;}
  .dh-note{display:block;font-size:12px;color:#7a848f;margin-top:6px;}
  .dh-link{background:none;border:none;color:var(--hcps-blue,#1681c2);font-weight:700;font-size:13.5px;cursor:pointer;padding:6px 0;font-family:'Inter',sans-serif;}
  .dh-link:hover{text-decoration:underline;}
  .sb-welcome{background:#e9f7ef;border:1px solid #bfe6cd;border-radius:10px;padding:10px 13px;font-size:13px;color:#1c6b3f;margin-bottom:12px;}
  .sb-welcome b{color:#12512e;}
  .sb-days{display:flex;flex-direction:column;gap:14px;max-height:360px;overflow:auto;margin-top:6px;padding-right:4px;}
  .sb-day .sb-dh{font-family:'Archivo',sans-serif;font-weight:800;font-size:13px;color:var(--ink);margin:0 0 7px;}
  .sb-slotrow{display:flex;flex-wrap:wrap;gap:7px;}
  .sb-slot{background:#f4f7fa;border:1px solid #d7dde3;border-radius:9px;padding:8px 12px;font-size:13.5px;font-weight:700;color:#243240;cursor:pointer;font-family:'Inter',sans-serif;}
  .sb-slot:hover{border-color:var(--hcps-blue,#1681c2);background:#eaf3fb;}
  .sb-slot.on{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;border-color:transparent;}
  .sb-confirm{margin-top:14px;border-top:1px solid #eef2f6;padding-top:14px;}
  .sb-done{background:#e9f7ef;border:1px solid #bfe6cd;border-radius:14px;padding:22px;text-align:center;}
  .sb-done h3{font-family:'Archivo',sans-serif;color:#12512e;margin:0 0 8px;font-size:19px;}
  .sb-done .zoom{display:inline-block;margin-top:10px;background:#1681c2;color:#fff;text-decoration:none;font-weight:700;padding:10px 18px;border-radius:10px;font-size:14px;}
  .sb-typebtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;}
  .sb-typebtns label{display:inline-flex;align-items:center;gap:7px;margin:0;font-weight:600;font-size:13.5px;color:#33404b;background:#f4f7fa;border:1px solid #dfe6ee;border-radius:9px;padding:9px 13px;cursor:pointer;}
  .sb-typebtns input{width:auto;}

  /* Quick access */
  .dh-quick{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;}
  @media(max-width:900px){.dh-quick{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:560px){.dh-quick{grid-template-columns:repeat(2,1fr);}}
  .dh-q{background:#fff;border:1px solid #e5e9ee;border-radius:14px;padding:16px 14px;text-decoration:none;text-align:center;transition:transform .13s,box-shadow .13s,border-color .13s;display:flex;flex-direction:column;align-items:center;gap:8px;}
  .dh-q:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .dh-q .qi{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:#eef4fb;color:var(--hcps-blue-dark,#0f5c8f);}
  .dh-q .qi svg{width:20px;height:20px;}
  .dh-q b{font-family:'Archivo',sans-serif;font-weight:800;font-size:13.5px;color:var(--ink);line-height:1.2;}
  .dh-q span{font-size:11.5px;color:#7a848f;}

  /* manufacturer centers */
  .dh-mfg{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media(max-width:860px){.dh-mfg{grid-template-columns:repeat(3,1fr);}}
  @media(max-width:560px){.dh-mfg{grid-template-columns:repeat(2,1fr);}}
  .dh-m{background:#fff;border:1px solid #e5e9ee;border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px;transition:transform .13s,box-shadow .13s,border-color .13s;}
  .dh-m:hover{transform:translateY(-3px);box-shadow:0 14px 30px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .dh-m img{height:34px;width:auto;max-width:100%;object-fit:contain;align-self:flex-start;}
  .dh-m b{font-family:'Archivo',sans-serif;font-weight:800;font-size:14px;color:var(--ink);}
  .dh-m span{font-size:12px;color:#6b7580;}
  .dh-m .mrow{display:flex;gap:8px;margin-top:auto;}
  .dh-m .mrow a{flex:1;text-align:center;font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;text-decoration:none;border-radius:8px;padding:8px;}
  .dh-m .mrow a.open{background:var(--hcps-blue,#1681c2);color:#fff;}
  .dh-m .mrow a.sup{background:#eef2f6;color:#334656;}

  .dh-band{background:linear-gradient(150deg,#12181d,#243746);color:#fff;border-radius:20px;padding:34px 38px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;box-shadow:0 20px 50px rgba(12,39,64,.14);}
  .dh-band h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(19px,2.3vw,26px);margin:0 0 6px;color:#fff;}
  .dh-band p{margin:0;color:rgba(255,255,255,.85);font-size:14.5px;max-width:58ch;}
  .dh-band-cta{display:flex;gap:10px;flex-wrap:wrap;}
</style>

{% set services = [
  {key:"remote-product-training", name:"Remote Product Training", mode:"remote", o:false, blurb:"Live online product walkthroughs for your sales and clinical team."},
  {key:"inperson-product-training", name:"In-Person Product Training", mode:"in_person", o:false, blurb:"A HCPS rep visits your location for hands-on product training."},
  {key:"staff-in-service", name:"Staff In-Service Training", mode:"in_person", o:true, blurb:"Structured in-service education so your whole team can sell and support the line."},
  {key:"portal-training", name:"Online Ordering Portal Training", mode:"remote", o:false, blurb:"Learn to order, reorder, and track everything in the HCPS ordering platform."},
  {key:"product-education", name:"Manufacturer Product Education", mode:"", o:false, blurb:"Deep-dive education on a specific manufacturer line, remote or in person."},
  {key:"technical-support", name:"Technical Support Appointment", mode:"remote", o:true, blurb:"Book a working session for setup, troubleshooting, or a technical question."},
  {key:"account-pricing", name:"Dealer Account & Pricing Assistance", mode:"remote", o:false, blurb:"Get help with account setup, dealer pricing, credit apps, and access."},
  {key:"showroom-consult", name:"Showroom Consultation", mode:"in_person", o:true, blurb:"Evaluate your product mix, layout, merchandising, and profitability."},
  {key:"business-dev", name:"Business Development Consultation", mode:"", o:false, blurb:"Growth strategy, category expansion, and a plan to grow revenue."},
  {key:"showroom-layout", name:"Showroom Layout Review (Showroom Designer)", mode:"", o:true, blurb:"Plan product placement and optimize your floor with our Showroom Designer tools."}
] %}

<!-- HERO -->
<section class="dh-hero">
  <div class="container">
    <span class="dh-eyebrow">HCPS Dealer Hub</span>
    <h1>Your dealer service &amp; scheduling center</h1>
    <p class="dh-lead">Your central destination for manufacturer resources, order requests, product literature, dealer pricing, in-service scheduling, technical support, and dealer login tools — plus the ability to request and schedule training, consultations, and support directly from this page. One place to manage every HCPS manufacturer relationship faster and easier.</p>
    <div class="dh-cta-row">
      <a class="dh-btn primary" href="#schedule">Schedule Product Training &rarr;</a>
      <a class="dh-btn ghost" href="#schedule" data-preset="showroom-consult">Request a Showroom Consultation</a>
      <a class="dh-btn ghost" href="/dealer-support/?request=Place%20or%20Request%20an%20Order#request">Start an Order</a>
    </div>
  </div>
</section>

<!-- SCHEDULE A SERVICE -->
<section class="dh-sec">
  <div class="container">
    <div class="dh-head">
      <p class="dh-kicker">Request &amp; schedule</p>
      <h2 class="dh-h2">Schedule a service</h2>
      <p class="dh-sub">Pick a service and we'll take it from there — choose remote or in-person, tell us your preferred time, and a HCPS representative will confirm the appointment and send a calendar invite. Every request becomes a tracked Dealer 360 touch point.</p>
    </div>
    <div class="dh-svc-grid">
      {% for s in services %}
      <article class="dh-svc{% if s.o %} o{% endif %}">
        <div class="dh-ico"><img src="/assets/dealer-hub/{{ s.key }}.png" alt="{{ s.name }} icon" loading="lazy" width="120" height="120"></div>
        <h3>{{ s.name }}</h3>
        <div class="mode">{% if s.mode == "remote" %}Remote{% elif s.mode == "in_person" %}In-person{% else %}Remote or in-person{% endif %}</div>
        <p>{{ s.blurb }}</p>
        <button type="button" class="go dh-pick" data-key="{{ s.key }}" data-name="{{ s.name }}" data-mode="{{ s.mode }}">Schedule &rarr;</button>
      </article>
      {% endfor %}
    </div>

    <!-- Showroom consultation highlight -->
    <div class="dh-spot" id="showroom">
      <div class="dh-spot-main">
        <p class="dh-kicker">Showroom Designer</p>
        <h3>Showroom consultation &amp; layout review</h3>
        <p>Have a HCPS consultant evaluate your current product mix, showroom layout, and merchandising — and use our new Showroom Designer tools to plan a more profitable floor. In person or remote.</p>
        <ul class="dh-spot-list">
          <li>Product-mix evaluation and category gaps</li>
          <li>Showroom layout &amp; traffic-flow review</li>
          <li>Merchandising strategy that converts</li>
          <li>Profitability opportunities per square foot</li>
        </ul>
        <button type="button" class="dh-btn primary dh-pick" data-key="showroom-consult" data-name="Showroom Consultation" data-mode="in_person">Request a Showroom Consultation &rarr;</button>
      </div>
      <div class="dh-spot-side">
        <div class="dh-mini"><b>Product mix</b><span>the right lines for your market</span></div>
        <div class="dh-mini"><b>Layout</b><span>plan placement with Showroom Designer</span></div>
        <div class="dh-mini"><b>Profitability</b><span>more revenue per square foot</span></div>
      </div>
    </div>
  </div>
</section>

<!-- SELF-SCHEDULER -->
<section class="dh-sec alt" id="schedule">
  <div class="container">
    <div class="dh-head">
      <p class="dh-kicker">Book it</p>
      <h2 class="dh-h2">Schedule your appointment</h2>
      <p class="dh-sub">Pick a live 30-minute time and it books instantly — calendar invite, Zoom link, reminders, and confirmation all handled for you.</p>
    </div>

    <div class="dh-form-wrap">
      <div class="dh-form" id="dh-booker">
        <!-- Step 1: choose + identify -->
        <div id="sb-id">
          <label for="dh-service">What's it about?</label>
          <select id="dh-service">
            <option value="">General / not sure</option>
            {% for s in services %}<option value="{{ s.name }}" data-key="{{ s.key }}" data-mode="{{ s.mode }}">{{ s.name }}</option>{% endfor %}
          </select>

          <label>Meeting type</label>
          <div class="sb-typebtns" id="sb-types">
            <label><input type="radio" name="mtype" value="online" checked> Online meeting (Zoom)</label>
            <label><input type="radio" name="mtype" value="field"> Field visit (on-site)</label>
          </div>
          <p class="dh-avail" id="sb-availbar"></p>

          <label for="sb-email">Your dealer email *</label>
          <input id="sb-email" type="email" placeholder="you@yourcompany.com" autocomplete="email">
          <button class="btn-primary" id="sb-find" type="button">Find available times &rarr;</button>
          <p class="form-status" id="sb-status" role="status" aria-live="polite"></p>
          <p class="dh-note">Self-scheduling is for established HCPS dealers. Not set up yet? <a href="/become-a-dealer/">Become a dealer</a> — or we'll show you a request option.</p>
        </div>

        <!-- Step 2: live slots -->
        <div id="sb-slots-wrap" style="display:none">
          <div class="sb-welcome" id="sb-welcome"></div>
          <div class="sb-days" id="sb-days"></div>
          <div class="sb-confirm" id="sb-confirm" style="display:none"></div>
          <p class="dh-note" id="sb-slotnote"></p>
          <button class="dh-link" id="sb-back" type="button">&larr; Change meeting type or email</button>
        </div>

        <!-- Step 3: done -->
        <div id="sb-done" style="display:none"></div>
      </div>

      <aside class="dh-flow">
        <h3>How self-scheduling works</h3>
        <ol>
          <li>Choose an online meeting or a field visit</li>
          <li>We show live 30-minute openings in your time zone</li>
          <li>Pick a time — it books instantly with a calendar invite</li>
          <li>You and your HCPS rep get a confirmation (and Zoom link)</li>
          <li>A reminder goes out 24 hours before; it's logged in Dealer 360</li>
        </ol>
        <p style="color:rgba(255,255,255,.8);font-size:12.5px;margin:16px 0 0;">Prefer to talk now? Call <a href="tel:{{ site.contact.phone_href }}" style="color:#fcb21e;font-weight:800;">{{ site.contact.phone_display }}</a>.</p>
      </aside>
    </div>

    <!-- LEGACY fallback: request a time (shown when the email isn't a known dealer) -->
    <div class="dh-form" id="dh-legacy" style="display:none;max-width:760px;margin:22px auto 0;">
      <h3 style="font-family:'Archivo',sans-serif;margin:0 0 4px;">Request a time instead</h3>
      <p class="dh-note" style="margin:0 0 6px;">We couldn't match your email to a dealer account, so tell us what works and a HCPS rep will confirm and send an invite.</p>
      <form id="dh-sched" novalidate>
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
        <input type="hidden" name="service_key" id="dhl-key" value="">
        <div><label for="dhl-service">Service</label>
          <select id="dhl-service" name="service"><option value="">Select…</option>{% for s in services %}<option value="{{ s.name }}" data-key="{{ s.key }}">{{ s.name }}</option>{% endfor %}</select></div>
        <div class="row">
          <div><label for="dhl-date">Preferred date</label><input id="dhl-date" name="preferred_date" type="date"></div>
          <div><label for="dhl-time">Preferred time</label><input id="dhl-time" name="preferred_time" type="text" placeholder="e.g. Wednesday morning"></div>
        </div>
        <div class="row">
          <div><label for="dhl-company">Dealer / Company *</label><input id="dhl-company" name="company" type="text" required></div>
          <div><label for="dhl-name">Contact name *</label><input id="dhl-name" name="name" type="text" required></div>
        </div>
        <div class="row">
          <div><label for="dhl-email">Email *</label><input id="dhl-email" name="email" type="email" required></div>
          <div><label for="dhl-phone">Phone</label><input id="dhl-phone" name="phone" type="tel"></div>
        </div>
        <div><label for="dhl-notes">Notes</label><textarea id="dhl-notes" name="notes" placeholder="Anything that helps us prepare."></textarea></div>
        <div><button type="submit" class="btn-primary" id="dhl-submit">Request appointment</button>
          <p class="form-status" id="dhl-status" role="status" aria-live="polite"></p></div>
      </form>
    </div>
  </div>
</section>

<!-- QUICK ACCESS -->
<section class="dh-sec">
  <div class="container">
    <div class="dh-head">
      <p class="dh-kicker">Quick access</p>
      <h2 class="dh-h2">Everyday dealer tools &amp; resources</h2>
      <p class="dh-sub">The links dealers reach for most — ordering, resources, pricing, applications, and support.</p>
    </div>
    <div class="dh-quick">
      <a class="dh-q" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg></span><b>Online Ordering</b><span>Order 24/7</span></a>
      <a class="dh-q" href="/resources/"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5a2 2 0 0 1 2-2h13v18H6a2 2 0 0 1-2-2.5z"/><path d="M8 7h8M8 11h8"/></svg></span><b>Catalogs &amp; Literature</b><span>Resource library</span></a>
      <a class="dh-q" href="/dealer-support/?request=Pricing%20Access#request"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span><b>Dealer Pricing</b><span>Request access</span></a>
      <a class="dh-q" href="/dealer-support/?request=Pricing%20Access#request"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg></span><b>Credit Applications</b><span>Dealer forms</span></a>
      <a class="dh-q" href="/dealer-support/?request=Place%20or%20Request%20an%20Order#request"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span><b>Order Requests</b><span>Place / request</span></a>
      <a class="dh-q" href="/dealer-support/?request=Technical%20Support#request"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-2-2 2.3-2.3z"/></svg></span><b>Technical Support</b><span>Get help</span></a>
      <a class="dh-q" href="/manufacturers/"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg></span><b>Manufacturer Resources</b><span>All partners</span></a>
      <a class="dh-q" href="/admin/rep-login.html" rel="nofollow"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span><b>Dealer Login Tools</b><span>Portal access</span></a>
      <a class="dh-q" href="/dealer-support/"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span><b>Dealer Support</b><span>Every request</span></a>
      <a class="dh-q" href="#schedule" data-preset="remote-product-training"><span class="qi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 2 9 2 12 0v-5"/></svg></span><b>Training Resources</b><span>Schedule training</span></a>
    </div>
  </div>
</section>

<!-- MANUFACTURER CENTERS -->
<section class="dh-sec alt">
  <div class="container">
    <div class="dh-head">
      <p class="dh-kicker">Manufacturer centers</p>
      <h2 class="dh-h2">Resources by manufacturer partner</h2>
      <p class="dh-sub">Pricing, literature, technical service, and training for each of our {{ activeManufacturers.length }} manufacturer partners.</p>
    </div>
    <div class="dh-mfg">
      {% for m in activeManufacturers %}
      <article class="dh-m">
        {% if m.logo %}<img src="{{ m.logo }}" alt="{{ m.name }}" loading="lazy">{% endif %}
        <b>{{ m.name }}</b>
        <span>{{ m.category }}</span>
        <div class="mrow">
          <a class="open" href="/manufacturers/{{ m.id }}/">Open</a>
          <a class="sup" href="/resources/?manufacturer={{ m.id }}">Resources</a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FINAL BAND -->
<section class="dh-sec">
  <div class="container">
    <div class="dh-band">
      <div>
        <h3>One place for resources, ordering, and scheduling.</h3>
        <p>Request training, book a showroom consultation, get technical support, or start an order — and every request becomes a tracked touch point in your Dealer 360 history.</p>
      </div>
      <div class="dh-band-cta">
        <a class="dh-btn primary" href="#schedule">Schedule a Service &rarr;</a>
        <a class="dh-btn ghost" style="border-color:rgba(255,255,255,.3);color:#fff;" href="/dealer-support/">Contact Dealer Support</a>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var API = "/.netlify/functions/schedule-api";
  var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) { return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]; }); };
  var TZ = (function () { try { return Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (e) { return ""; } })();
  var svc = document.getElementById("dh-service");
  var emailIn = document.getElementById("sb-email");
  var findBtn = document.getElementById("sb-find");
  var sbStatus = document.getElementById("sb-status");
  var availbar = document.getElementById("sb-availbar");
  var stepId = document.getElementById("sb-id");
  var slotsWrap = document.getElementById("sb-slots-wrap");
  var daysBox = document.getElementById("sb-days");
  var confirmBox = document.getElementById("sb-confirm");
  var welcome = document.getElementById("sb-welcome");
  var doneBox = document.getElementById("sb-done");
  var legacy = document.getElementById("dh-legacy");
  var BOOK = { start_utc: null, label: null };

  function mtype() { var r = document.querySelector('input[name="mtype"]:checked'); return r ? r.value : "online"; }
  function availText() {
    if (mtype() === "field") return "Field visits: <b>Wednesday &amp; Thursday, 9:00 AM–4:00 PM</b> in your local time (" + esc(TZ || "your time zone") + "). Enter your email to see live openings.";
    return "Online meetings: <b>Mon 12:00–1:30, Tue 10:00–3:00, Fri 10:00–3:00 (Central)</b>, held over Zoom. Enter your email to see live openings.";
  }
  function refreshAvail() { availbar.innerHTML = availText(); }
  document.querySelectorAll('input[name="mtype"]').forEach(function (r) { r.addEventListener("change", refreshAvail); });
  refreshAvail();

  // Topic preselect from service cards / presets / deep-link (keeps the picker useful).
  function pick(key, name, mode, scroll) {
    for (var i = 0; i < svc.options.length; i++) { if (svc.options[i].value === name || svc.options[i].getAttribute("data-key") === key) { svc.selectedIndex = i; break; } }
    if (mode === "in_person") { var f = document.querySelector('input[name="mtype"][value="field"]'); if (f) { f.checked = true; refreshAvail(); } }
    if (scroll !== false) { document.getElementById("schedule").scrollIntoView({ behavior: "smooth", block: "start" }); setTimeout(function () { if (emailIn) emailIn.focus(); }, 420); }
  }
  document.querySelectorAll(".dh-pick").forEach(function (btn) { btn.addEventListener("click", function () { pick(btn.getAttribute("data-key"), btn.getAttribute("data-name"), btn.getAttribute("data-mode")); }); });
  document.querySelectorAll('[data-preset]').forEach(function (a) { a.addEventListener("click", function () { var key = a.getAttribute("data-preset"); for (var i = 0; i < svc.options.length; i++) { if (svc.options[i].getAttribute("data-key") === key) { pick(key, svc.options[i].value, svc.options[i].getAttribute("data-mode"), false); break; } } }); });
  var qp = new URLSearchParams(location.search), sk = qp.get("service");
  if (sk) { for (var i = 0; i < svc.options.length; i++) { if (svc.options[i].getAttribute("data-key") === sk) { pick(sk, svc.options[i].value, svc.options[i].getAttribute("data-mode"), false); break; } } }

  async function api(payload) { var r = await fetch(API, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) }); return r.json(); }

  findBtn.addEventListener("click", async function () {
    sbStatus.textContent = ""; sbStatus.className = "form-status";
    var email = (emailIn.value || "").trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { sbStatus.className = "form-status error"; sbStatus.textContent = "Enter a valid email."; return; }
    findBtn.disabled = true; var orig = findBtn.textContent; findBtn.textContent = "Finding times…";
    try {
      var v = await api({ action: "verify_dealer", email: email });
      if (v && v.ok && v.matched === false) { revealLegacy(email); return; }
      if (!v || !v.ok) { sbStatus.className = "form-status error"; sbStatus.textContent = (v && v.message) || "Couldn't check that email."; return; }
      var s = await api({ action: "slots", email: email, meeting_type: mtype(), tz: TZ });
      if (!s || !s.ok) { sbStatus.className = "form-status error"; sbStatus.textContent = (s && s.message) || "Couldn't load times."; return; }
      renderSlots(email, v, s);
    } catch (e) { sbStatus.className = "form-status error"; sbStatus.textContent = "Network error. Please try again."; }
    finally { findBtn.disabled = false; findBtn.textContent = orig; }
  });

  function revealLegacy(email) {
    legacy.style.display = "";
    var le = document.getElementById("dhl-email"); if (le) le.value = email;
    var ls = document.getElementById("dhl-service"); if (ls && svc.value) { for (var i = 0; i < ls.options.length; i++) if (ls.options[i].value === svc.value) ls.selectedIndex = i; }
    legacy.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function renderSlots(email, v, s) {
    stepId.style.display = "none"; doneBox.style.display = "none"; slotsWrap.style.display = "";
    confirmBox.style.display = "none"; BOOK.start_utc = null;
    var topic = svc.value || "";
    var tzNote = s.location_type === "online" ? ("Central time" + (s.tz_abbr ? " (" + esc(s.tz_abbr) + ")" : "")) : ("your local time" + (s.tz_abbr ? " (" + esc(s.tz_abbr) + ")" : ""));
    welcome.innerHTML = "Welcome back, <b>" + esc(v.company || "dealer") + "</b>! Showing open <b>" + esc(s.label) + "</b> times with <b>" + esc(s.rep_display || "your HCPS team") + "</b>, in " + tzNote + "." + (s.zoom_link ? " Online meetings use Zoom." : "");
    if (!s.days || !s.days.length) {
      daysBox.innerHTML = '<p class="dh-note">No open times in the next few weeks. Please check the other meeting type, or use the request option below.</p>';
      document.getElementById("sb-slotnote").innerHTML = '<button class="dh-link" id="sb-req" type="button">Request a time instead →</button>';
      var rq = document.getElementById("sb-req"); if (rq) rq.addEventListener("click", function () { revealLegacy(email); });
      return;
    }
    daysBox.innerHTML = s.days.map(function (d, di) {
      var head = new Date(d.date + "T12:00:00Z").toLocaleDateString("en-US", { weekday: "long", month: "short", day: "numeric" });
      return '<div class="sb-day"><div class="sb-dh">' + esc(head) + '</div><div class="sb-slotrow">' +
        d.slots.map(function (sl, si) { return '<button type="button" class="sb-slot" data-di="' + di + '" data-si="' + si + '" data-start="' + esc(sl.start_utc) + '" data-label="' + esc(sl.label) + '">' + esc(sl.label) + '</button>'; }).join("") +
        '</div></div>';
    }).join("");
    document.getElementById("sb-slotnote").textContent = "Times shown are 30 minutes. Booked slots are removed automatically.";
    daysBox.querySelectorAll(".sb-slot").forEach(function (btn) {
      btn.addEventListener("click", function () {
        daysBox.querySelectorAll(".sb-slot.on").forEach(function (x) { x.classList.remove("on"); });
        btn.classList.add("on");
        BOOK.start_utc = btn.getAttribute("data-start"); BOOK.label = btn.getAttribute("data-label");
        var head = btn.closest(".sb-day").querySelector(".sb-dh").textContent;
        showConfirm(email, v, s, head, topic);
      });
    });
  }

  function showConfirm(email, v, s, head, topic) {
    confirmBox.style.display = "";
    confirmBox.innerHTML =
      '<label for="sb-name">Your name</label><input id="sb-name" type="text" value="' + esc(v.contact_name || "") + '" placeholder="First and last name">' +
      '<label for="sb-phone">Phone (optional)</label><input id="sb-phone" type="tel">' +
      '<label for="sb-notes">Anything we should know? (optional)</label><textarea id="sb-notes" placeholder="Topic, products, team size, address for a field visit…">' + (topic ? "Topic: " + esc(topic) : "") + '</textarea>' +
      '<button class="btn-primary" id="sb-confirm-btn" type="button">Confirm ' + esc(s.label) + ' on ' + esc(head) + ' &rarr;</button>' +
      '<p class="form-status" id="sb-confirm-status" role="status" aria-live="polite"></p>';
    document.getElementById("sb-confirm-btn").addEventListener("click", function () { doBook(email, s, topic); });
    confirmBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  async function doBook(email, s, topic) {
    var cs = document.getElementById("sb-confirm-status"); cs.textContent = ""; cs.className = "form-status";
    var btn = document.getElementById("sb-confirm-btn");
    if (!BOOK.start_utc) { cs.className = "form-status error"; cs.textContent = "Pick a time first."; return; }
    btn.disabled = true; var orig = btn.textContent; btn.textContent = "Booking…";
    try {
      var out = await api({ action: "book", email: email, meeting_type: mtype(), start_utc: BOOK.start_utc, tz: TZ,
        name: (document.getElementById("sb-name") || {}).value || "", phone: (document.getElementById("sb-phone") || {}).value || "",
        notes: (document.getElementById("sb-notes") || {}).value || "", topic: topic });
      if (out && out.ok) {
        slotsWrap.style.display = "none"; doneBox.style.display = "";
        doneBox.innerHTML = '<div class="sb-done"><h3>You\'re booked ✓</h3><p>' + esc(out.message || "") + '</p>' +
          (out.zoom_link ? '<a class="zoom" href="' + esc(out.zoom_link) + '" target="_blank" rel="noopener">Join link: ' + esc(out.zoom_link) + '</a>' : "") +
          '<p style="margin-top:14px;"><button class="dh-link" id="sb-again" type="button">Book another →</button></p></div>';
        var ag = document.getElementById("sb-again"); if (ag) ag.addEventListener("click", resetBooker);
      } else if (out && out.error === "slot_taken") {
        cs.className = "form-status error"; cs.textContent = out.message || "That time was just taken — pick another.";
        // refresh slots
        var s2 = await api({ action: "slots", email: email, meeting_type: mtype(), tz: TZ }); if (s2 && s2.ok) renderSlots(email, { company: welcome.textContent }, s2);
      } else { cs.className = "form-status error"; cs.textContent = (out && out.message) || "Couldn't book that time."; }
    } catch (e) { cs.className = "form-status error"; cs.textContent = "Network error. Please try again."; }
    finally { btn.disabled = false; btn.textContent = orig; }
  }

  function resetBooker() { doneBox.style.display = "none"; slotsWrap.style.display = "none"; stepId.style.display = ""; sbStatus.textContent = ""; document.getElementById("schedule").scrollIntoView({ behavior: "smooth", block: "start" }); }
  document.getElementById("sb-back").addEventListener("click", resetBooker);

  // Legacy request form (unverified dealers).
  var lform = document.getElementById("dh-sched");
  if (lform) lform.addEventListener("submit", async function (e) {
    e.preventDefault();
    var st = document.getElementById("dhl-status"); st.textContent = ""; st.className = "form-status";
    var data = Object.fromEntries(new FormData(lform).entries());
    var keyOpt = document.getElementById("dhl-service"); if (keyOpt && keyOpt.selectedIndex >= 0) data.service_key = keyOpt.options[keyOpt.selectedIndex].getAttribute("data-key") || "";
    if (!data.company || !data.name || !data.email) { st.className = "form-status error"; st.textContent = "Please fill in company, contact name, and email."; return; }
    var sb = document.getElementById("dhl-submit"); sb.disabled = true; var o = sb.textContent; sb.textContent = "Sending…";
    try {
      var out = await api(Object.assign({ action: "request" }, data));
      if (out && out.ok) { lform.reset(); st.className = "form-status ok"; st.textContent = out.message || "Request received — we'll confirm your appointment shortly."; }
      else { st.className = "form-status error"; st.textContent = (out && (out.message || out.error)) || "Something went wrong. Please email info@homecareproviderservices.us."; }
    } catch (err) { st.className = "form-status error"; st.textContent = "Network error. Please email info@homecareproviderservices.us."; }
    finally { sb.disabled = false; sb.textContent = o; }
  });
})();
</script>
