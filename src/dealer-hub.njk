<!-- FINAL BAND -->
<section class="dh-sec">
  <div class="container">
    <div class="dh-band">
      <div>
        <h3>One place for resources, ordering, and scheduling.</h3>
        <p>Request training, book a showroom consultation, get technical support, or start an order — and every request becomes a tracked touch point in your Dealer 360 history.</p>
      </div>
      <div class="dh-band-cta">
        <a class="dh-btn primary" href="#schedule">Schedule a Service &rarr;</a>
        <a class="dh-btn ghost" style="border-color:rgba(255,255,255,.3);color:#fff;" href="/dealer-support/">Contact Dealer Support</a>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var svc = document.getElementById("dh-service");
  var keyField = document.getElementById("dh-key");
  var form = document.getElementById("dh-sched");
  var status = document.getElementById("dh-status");
  var submit = document.getElementById("dh-submit");

  function setMode(mode) {
    var radios = form.querySelectorAll('input[name="mode"]');
    var target = mode || "";
    radios.forEach(function (r) { r.checked = (r.value === target); });
    if (!mode) { var none = form.querySelector('input[name="mode"][value=""]'); if (none) none.checked = true; }
  }
  function syncKey() {
    var opt = svc.options[svc.selectedIndex];
    keyField.value = opt ? (opt.getAttribute("data-key") || "") : "";
  }
  function pick(key, name, mode, scroll) {
    for (var i = 0; i < svc.options.length; i++) {
      if (svc.options[i].value === name || svc.options[i].getAttribute("data-key") === key) { svc.selectedIndex = i; break; }
    }
    syncKey(); setMode(mode);
    if (scroll !== false) {
      document.getElementById("schedule").scrollIntoView({ behavior: "smooth", block: "start" });
      setTimeout(function () { var f = document.getElementById("dh-company"); if (f) f.focus(); }, 420);
    }
  }
  svc.addEventListener("change", function () {
    syncKey();
    var opt = svc.options[svc.selectedIndex];
    if (opt) setMode(opt.getAttribute("data-mode") || "");
  });
  // Service cards + spotlight buttons
  document.querySelectorAll(".dh-pick").forEach(function (btn) {
    btn.addEventListener("click", function () { pick(btn.getAttribute("data-key"), btn.getAttribute("data-name"), btn.getAttribute("data-mode")); });
  });
  // Hero / quick-access presets (href="#schedule" data-preset=key)
  document.querySelectorAll('[data-preset]').forEach(function (a) {
    a.addEventListener("click", function () {
      var key = a.getAttribute("data-preset");
      for (var i = 0; i < svc.options.length; i++) { if (svc.options[i].getAttribute("data-key") === key) { pick(key, svc.options[i].value, svc.options[i].getAttribute("data-mode"), false); break; } }
    });
  });
  // Deep-link ?service=<key>
  var qp = new URLSearchParams(location.search);
  var sk = qp.get("service");
  if (sk) { for (var i = 0; i < svc.options.length; i++) { if (svc.options[i].getAttribute("data-key") === sk) { pick(sk, svc.options[i].value, svc.options[i].getAttribute("data-mode"), false); break; } } }

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    status.textContent = "";
    var data = Object.fromEntries(new FormData(form).entries());
    if (!data.service) { status.className = "form-status error"; status.textContent = "Please choose a service."; return; }
    if (!data.company || !data.name || !data.email) { status.className = "form-status error"; status.textContent = "Please fill in company, contact name, and email."; return; }
    submit.disabled = true; var original = submit.textContent; submit.textContent = "Sending…";
    try {
      var res = await fetch("/.netlify/functions/schedule-api", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(Object.assign({ action: "request" }, data)) });
      var out = await res.json();
      if (res.ok && out.ok) {
        form.reset(); syncKey(); setMode("");
        status.className = "form-status ok";
        status.textContent = out.message || "Request received — a HCPS representative will confirm your appointment shortly.";
      } else {
        status.className = "form-status error";
        status.textContent = out.message || out.error || "Something went wrong. Please email info@homecareproviderservices.us.";
      }
    } catch (err) {
      status.className = "form-status error";
      status.textContent = "Network error. Please email info@homecareproviderservices.us.";
    } finally { submit.disabled = false; submit.textContent = original; }
  });
})();
</script>
