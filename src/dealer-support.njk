    </div>
    <div class="ds-grid">

      <!-- Showroom Development -->
      <article class="ds-card">
        <div class="ds-card-top">
          <div class="ds-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9h18v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z"/><path d="M4.5 11.5V20h15v-8.5"/><path d="M9.5 20v-5h5v5"/></svg></div>
