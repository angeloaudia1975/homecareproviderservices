---
layout: layouts/base.njk
title: Dealer Support
permalink: /dealer-support/
description: "HomeCare Provider Services offers hands-on showroom development, sales training, marketing support, and business consulting to help HME and DME dealers strengthen their product mix, improve performance, and grow revenue."
---
<style>
  .ds-hero{position:relative;overflow:hidden;background:linear-gradient(150deg,#0c2740 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:64px 0 58px;}
  .ds-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:460px;height:460px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.28),transparent 62%);pointer-events:none;}
  .ds-hero .container{position:relative;z-index:1;}
  .ds-eyebrow{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:7px 15px;font-family:'Archivo',sans-serif;font-weight:800;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 16px;}
  .ds-hero h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(30px,4.6vw,50px);line-height:1.05;margin:0 0 16px;max-width:18ch;}
  .ds-hero .ds-lead{font-size:clamp(16px,1.5vw,18.5px);line-height:1.55;color:rgba(255,255,255,.9);max-width:72ch;margin:0 0 26px;}
  .ds-cta-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;}
  .ds-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:15px;text-decoration:none;border-radius:11px;padding:14px 24px;transition:transform .12s,filter .12s,box-shadow .12s;border:1px solid transparent;cursor:pointer;}
  .ds-btn:hover{transform:translateY(-1px);}
  .ds-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .ds-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.28);}
  .ds-btn.ghost:hover{background:rgba(255,255,255,.16);}
  .ds-btn.blue{background:var(--hcps-blue,#1681c2);color:#fff;box-shadow:0 14px 30px -12px rgba(22,129,194,.6);}
  .ds-btn.sm{padding:11px 18px;font-size:13.5px;}
  .ds-trust{display:flex;gap:22px;flex-wrap:wrap;margin-top:26px;color:rgba(255,255,255,.82);font-size:13.5px;font-weight:600;}
  .ds-trust b{color:#fcb21e;font-family:'Archivo Expanded','Archivo',sans-serif;}

  .ds-sec{padding:58px 0;}
  .ds-sec.alt{background:var(--paper,#f6f7f5);}
  .ds-head{max-width:66ch;margin:0 0 34px;}
  .ds-kicker{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hcps-blue,#1681c2);margin:0 0 10px;}
  .ds-h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(24px,3vw,36px);line-height:1.1;color:var(--ink);margin:0 0 12px;}
  .ds-sub{font-size:16px;line-height:1.6;color:#48525c;margin:0;}

  .ds-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  @media(max-width:820px){.ds-grid{grid-template-columns:1fr;}}
  .ds-card{background:#fff;border:1px solid #e5e9ee;border-radius:18px;padding:28px 26px;box-shadow:0 10px 30px rgba(12,39,64,.05);transition:transform .14s,box-shadow .14s,border-color .14s;display:flex;flex-direction:column;}
  .ds-card:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(12,39,64,.1);border-color:#cfe0ef;}
  .ds-card-top{display:flex;align-items:center;gap:14px;margin:0 0 12px;}
  .ds-ico{flex:none;width:50px;height:50px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#e9f3fb,#d5e8f6);color:var(--hcps-blue-dark,#0f5c8f);}
  .ds-ico.orange{background:linear-gradient(135deg,#fde7d8,#fbd3b4);color:#c14a10;}
  .ds-ico svg{width:26px;height:26px;}
  .ds-card h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:20px;color:var(--ink);margin:0;line-height:1.1;}
  .ds-card p.blurb{font-size:14.5px;line-height:1.55;color:#55606a;margin:0 0 16px;}
  .ds-list{list-style:none;padding:0;margin:0 0 20px;display:grid;gap:9px;}
  .ds-list li{position:relative;padding-left:27px;font-size:14px;line-height:1.4;color:#33404b;}
  .ds-list li::before{content:"";position:absolute;left:0;top:1px;width:17px;height:17px;border-radius:50%;background:var(--hcps-blue,#1681c2) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6L9 17l-5-5'/></svg>") center/10px no-repeat;}
  .ds-card.o .ds-list li::before{background-color:var(--hcps-orange,#ef6325);}
  .ds-card .ds-link{margin-top:auto;font-family:'Archivo',sans-serif;font-weight:800;font-size:14px;color:var(--hcps-orange,#ef6325);text-decoration:none;}
  .ds-card .ds-link:hover{text-decoration:underline;}

  .ds-band{background:linear-gradient(150deg,#12181d,#243746);color:#fff;border-radius:20px;padding:38px 40px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;box-shadow:0 20px 50px rgba(12,39,64,.14);}
  .ds-band h3{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(20px,2.4vw,28px);margin:0 0 8px;color:#fff;}
  .ds-band p{margin:0;color:rgba(255,255,255,.85);font-size:15px;max-width:60ch;}
  .ds-band .ds-band-cta{display:flex;gap:12px;flex-wrap:wrap;}

  .ds-final{background:linear-gradient(150deg,#0c2740,#0f5c8f);color:#fff;padding:60px 0;}
  .ds-final .ds-h2{color:#fff;}
  .ds-final .ds-sub{color:rgba(255,255,255,.85);}
  .ds-form{background:#fff;border-radius:20px;padding:30px;box-shadow:0 24px 60px rgba(0,0,0,.28);max-width:780px;margin:26px auto 0;}
  .ds-form .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media(max-width:600px){.ds-form .form-row{grid-template-columns:1fr;}}
  .ds-form label{display:block;font-family:'Archivo',sans-serif;font-weight:700;font-size:13px;color:var(--ink);margin:14px 0 6px;}
  .ds-form input,.ds-form select,.ds-form textarea{width:100%;box-sizing:border-box;padding:12px 13px;border:1px solid #d7dde3;border-radius:10px;font-size:15px;font-family:'Inter',sans-serif;color:var(--ink);background:#fff;}
  .ds-form textarea{min-height:104px;resize:vertical;}
  .ds-form input:focus,.ds-form select:focus,.ds-form textarea:focus{outline:none;border-color:var(--hcps-blue,#1681c2);box-shadow:0 0 0 3px rgba(22,129,194,.15);}
  .ds-form .form-status{margin:12px 0 0;font-size:14px;font-weight:600;}
  .ds-form .form-status.ok{color:#166b45;}
  .ds-form .form-status.error{color:#b42323;}
  .ds-direct{text-align:center;color:rgba(255,255,255,.85);margin-top:22px;font-size:15px;}
  .ds-direct a{color:#fcb21e;font-weight:800;text-decoration:none;}
</style>

<!-- HERO -->
<section class="ds-hero">
  <div class="container">
    <span class="ds-eyebrow">Dealer Support &amp; Growth</span>
    <h1>Hands-on support that grows your business</h1>
    <p class="ds-lead">HomeCare Provider Services offers hands-on showroom development, sales training, marketing support, and business consulting to help HME &amp; DME dealers strengthen their product mix, improve performance, and grow revenue. We do more than represent manufacturers — we work alongside your team to help you sell more effectively.</p>
    <div class="ds-cta-row">
      <a class="ds-btn primary" href="#request">Request Dealer Support &rarr;</a>
      <a class="ds-btn ghost" href="?request=Showroom%20Consultation#request">Schedule a Showroom Consultation</a>
      <a class="ds-btn ghost" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Access Online Ordering</a>
    </div>
    <div class="ds-trust">
      <span><b>{{ site.stats.dealers }}</b> Active dealers</span>
      <span><b>{{ activeManufacturers.length }}</b> Manufacturer partners</span>
      <span><b>{{ site.stats.states }}</b>-state territory</span>
      <span>Supporting dealers since <b>{{ site.founded }}</b></span>
    </div>
  </div>
</section>

<!-- INTRO -->
