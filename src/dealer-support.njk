<!-- MID CTA BAND -->
<section class="ds-sec alt">
  <div class="container">
    <div class="ds-band">
      <div>
        <h3>Not sure where to start? Let's build your plan.</h3>
        <p>Tell us about your showroom, your team, and your goals — a HCPS representative will put together the right mix of showroom, training, marketing, and consulting support for your business.</p>
      </div>
      <div class="ds-band-cta">
        <a class="ds-btn primary" href="#request">Request Dealer Support &rarr;</a>
        <a class="ds-btn ghost" href="/contact/">Contact Your HCPS Representative</a>
      </div>
    </div>
  </div>
</section>

<!-- QUICK LINKS -->
<section class="ds-sec">
  <div class="container">
    <div class="ds-head">
      <p class="ds-kicker">Everyday dealer tools</p>
      <h2 class="ds-h2">Jump straight to what you need</h2>
      <p class="ds-sub">The fastest paths for active dealers — order, browse resources, request literature, or reach your rep.</p>
    </div>
    <div class="ds-cta-row">
      <a class="ds-btn blue" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Access Online Ordering &rarr;</a>
      <a class="ds-btn blue" href="/dealer-hub/">Open the Dealer Hub</a>
      <a class="ds-btn blue" href="/resources/">Explore Dealer Resources</a>
      <a class="ds-btn blue" href="?request=Order%20Literature#request">Order Literature</a>
      <a class="ds-btn blue" href="/manufacturers/">Manufacturer Partners</a>
    </div>
  </div>
</section>

<!-- FINAL CTA + REQUEST FORM -->
<section class="ds-final" id="request">
  <div class="container">
    <div class="ds-head" style="max-width:72ch;">
      <p class="ds-kicker" style="color:#fcb21e;">We're here to help</p>
      <h2 class="ds-h2">Request dealer support</h2>
      <p class="ds-sub">Showroom consultation, in-service, marketing, consulting, pricing, orders, literature, or a technical question — send a request and a HCPS team member will follow up quickly.</p>
    </div>

    <form id="support-form" class="ds-form" novalidate>
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;" aria-hidden="true">
      <div>
        <label for="s-request">Request type *</label>
        <select id="s-request" name="interest">
          <option value="Showroom Consultation">Showroom Consultation</option>
          <option value="Request an In-Service">Sales Training / In-Service</option>
          <option value="Marketing Support">Marketing Support</option>
          <option value="Business Consulting">Business Consulting</option>
          <option value="Pricing Access">Pricing Access</option>
          <option value="Online Ordering Access">Online Ordering Access</option>
          <option value="Place or Request an Order">Place / Request an Order</option>
          <option value="Order Literature">Order Literature</option>
          <option value="Technical Support">Technical Support</option>
          <option value="General Dealer Question">General Dealer Question</option>
        </select>
      </div>
      <div class="form-row">
        <div><label for="s-company">Dealer / Company name *</label><input id="s-company" name="company" type="text" required></div>
        <div><label for="s-name">Contact name *</label><input id="s-name" name="name" type="text" required></div>
      </div>
      <div class="form-row">
        <div><label for="s-email">Email *</label><input id="s-email" name="email" type="email" required></div>
        <div><label for="s-phone">Phone</label><input id="s-phone" name="phone" type="tel"></div>
      </div>
      <div>
        <label for="s-manu">Manufacturer (if applicable)</label>
        <select id="s-manu" name="manufacturer">
          <option value="">All / not sure</option>
          {% for m in activeManufacturers %}<option value="{{ m.name }}">{{ m.name }}</option>{% endfor %}
        </select>
      </div>
      <div>
        <label for="s-message">Details</label>
        <textarea id="s-message" name="message" placeholder="Tell us about your showroom, team, and goals — or the account name, product, quantities, dates, or question you need answered."></textarea>
      </div>
      <div>
        <button type="submit" class="ds-btn primary" id="s-submit" style="border:none;">Submit Request</button>
        <p class="form-status" id="s-status" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="ds-direct">
      Prefer to reach us directly? Call
      <a href="tel:{{ site.contact.phone_href }}">{{ site.contact.phone_display }}</a>
      or email
      <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.
    </p>
  </div>
</section>

<script>
(function () {
  var form = document.getElementById("support-form");
  var status = document.getElementById("s-status");
  var submit = document.getElementById("s-submit");
  var request = document.getElementById("s-request");

  // Pre-select the request type from ?request=
  var params = new URLSearchParams(location.search);
  var req = (params.get("request") || "").toLowerCase();
  if (req) {
    for (var i = 0; i < request.options.length; i++) {
      if (request.options[i].value.toLowerCase() === req ||
          request.options[i].value.toLowerCase().indexOf(req) !== -1) { request.selectedIndex = i; break; }
    }
  }

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    status.textContent = "";
    var data = Object.fromEntries(new FormData(form).entries());
    if (!data.name || !data.company || !data.email) {
      status.className = "form-status error";
      status.textContent = "Please fill in dealer name, contact name, and email.";
      return;
    }
    submit.disabled = true;
    var original = submit.textContent;
    submit.textContent = "Sending…";
    try {
      var res = await fetch("/.netlify/functions/contact", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data)
      });
      var out = await res.json();
      if (res.ok && out.ok) {
        form.reset();
        if (req) { for (var j = 0; j < request.options.length; j++) { if (request.options[j].value.toLowerCase().indexOf(req) !== -1) { request.selectedIndex = j; break; } } }
        status.className = "form-status ok";
        status.textContent = "Thank you — your request has been sent. A HCPS team member will be in touch shortly.";
      } else {
        status.className = "form-status error";
        status.textContent = out.error || "Something went wrong. Please email info@homecareproviderservices.us.";
      }
    } catch (err) {
      status.className = "form-status error";
      status.textContent = "Network error. Please email info@homecareproviderservices.us.";
    } finally {
      submit.disabled = false;
      submit.textContent = original;
    }
  });
})();
</script>
