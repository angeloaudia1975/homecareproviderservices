---
layout: layouts/base.njk
title: Consulting
permalink: /consulting/
description: "Market development & consulting from HomeCare Provider Services — dealer network development, showroom strategy, product launches, sales education, floorplan design, and territory growth."
---
{% set pg = pages.consulting %}
<section class="consult-hero">
  <div class="container consult-hero-grid">
    <div>
      <p class="eyebrow" style="color:var(--hcps-gold);">{{ pg.hero.eyebrow }}</p>
      <h1>{{ pg.hero.headline }}</h1>
      <p class="lead">{{ pg.hero.lead }}</p>
      <div class="hero-actions">
        <a class="btn primary" href="/contact/?topic=Consulting">{{ pg.hero.cta1_label }}</a>
        <a class="btn outline" href="/dealer-hub/">{{ pg.hero.cta2_label }}</a>
      </div>
    </div>
    <aside class="consult-hero-card">
      <span class="badge">{{ pg.hero.card_badge }}</span>
      <strong>{{ pg.hero.card_title }}</strong>
      <p>{{ pg.hero.card_copy }}</p>
    </aside>
  </div>
</section>

<section>
  <div class="container">
    <div class="svc-head">
      <div>
        <p class="eyebrow">{{ pg.services.eyebrow }}</p>
        <h2>{{ pg.services.title }}</h2>
      </div>
      <p>{{ pg.services.intro }}</p>
    </div>
    <div class="svc-grid">
      {% for s in pg.services.items %}
      <article class="svc-card"><span class="svc-num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.description }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="alt-band">
  <div class="container consult-split">
    <div>
      <p class="eyebrow">{{ pg.split.eyebrow }}</p>
      <h2>{{ pg.split.title }}</h2>
      <p>{{ pg.split.copy }}</p>
      <div class="chip-list">
        {% for chip in pg.split.chips %}<span class="chip">{{ chip }}</span>{% endfor %}
      </div>
    </div>
    <aside class="consult-aside">
      <strong>{{ pg.split.aside_title }}</strong>
      <p>{{ pg.split.aside_copy }}</p>
      <a class="btn primary" href="/contact/?topic=Consulting">{{ pg.split.aside_cta }}</a>
    </aside>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">{{ pg.process.eyebrow }}</p>
      <h2>{{ pg.process.title }}</h2>
    </div>
    <div class="proc-grid">
      {% for step in pg.process.steps %}
      <article class="proc-card"><span class="proc-num">{{ loop.index }}</span><h3>{{ step.title }}</h3><p>{{ step.description }}</p></article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="alt-band">
  <div class="container aud-grid">
    <article class="aud-card">
      <p class="eyebrow">For Manufacturers</p>
      <h3>Build a stronger dealer channel.</h3>
      <p>Use HCPS to support market entry, dealer development, new product launches, training, showroom placement, and ongoing field execution.</p>
      <a href="/become-a-manufacturer-partner/">Become a Manufacturer Partner &rarr;</a>
    </article>
    <article class="aud-card">
      <p class="eyebrow">For Dealers</p>
      <h3>Improve how products are presented and supported.</h3>
      <p>Use HCPS for showroom strategy, literature requests, product education, in-services, and manufacturer support workflows.</p>
      <a href="/dealer-hub/">Open Dealer Hub &rarr;</a>
    </article>
  </div>
</section>

<section class="cta">
  <div class="container cta-grid">
    <div>
      <h2>{{ pg.cta.title }}</h2>
      <p>{{ pg.cta.copy }}</p>
    </div>
    <div class="hero-actions">
      <a class="btn primary" href="/contact/?topic=Consulting">{{ pg.cta.cta1_label }}</a>
      <a class="btn outline" href="/manufacturers/">{{ pg.cta.cta2_label }}</a>
    </div>
  </div>
</section>
