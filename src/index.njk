---
layout: layouts/base.njk
title: Manufacturer Sales Representation
permalink: /
---
<style>
  /* Banner-led hero (interactive 3D tilt) — shared depth-hero pattern used site-wide */
  .rep-band{background:linear-gradient(150deg,#0b1f33 0%,#0f5c8f 64%,#1681c2 100%);color:#fff;padding:40px 0 50px;position:relative;overflow:hidden;perspective:1500px;}
  .rep-band::after{content:"";position:absolute;right:-120px;top:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.26),transparent 68%);pointer-events:none;}
  .rep-band .container{position:relative;z-index:1;}
  .rep-h1{color:#fff;text-align:center;max-width:940px;margin:0 auto 22px;font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(19px,2.5vw,30px);line-height:1.14;text-wrap:balance;}
  .rep-frame{max-width:1000px;margin:0 auto;border-radius:18px;overflow:hidden;aspect-ratio:1672/941;background:url("/assets/representation-banner.jpg") center/cover;box-shadow:0 45px 85px -22px rgba(0,0,0,.6);transform-style:preserve-3d;transition:transform .18s ease-out;will-change:transform;position:relative;}
  .rep-glare{position:absolute;inset:0;pointer-events:none;background:radial-gradient(300px 300px at var(--mx,50%) var(--my,30%),rgba(255,255,255,.28),transparent 60%);mix-blend-mode:screen;opacity:0;transition:opacity .2s;}
  .rep-copy{max-width:1040px;margin:28px auto 0;text-align:center;}
  .rep-copy h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;white-space:nowrap;font-size:clamp(22px,3.4vw,38px);line-height:1.05;margin:0 0 12px;color:#fff;}
  .rep-copy p{margin:0 auto 22px;max-width:820px;font-size:clamp(14.5px,1.35vw,16.5px);line-height:1.6;color:rgba(255,255,255,.92);}
  .rep-actions{display:flex;gap:11px;justify-content:center;flex-wrap:wrap;}
  .rep-band .btn.outline{border-color:rgba(255,255,255,.4);color:#fff;}
  .rep-band .btn.outline:hover{background:rgba(255,255,255,.14);}
  @media(max-width:600px){.rep-copy h2{white-space:normal;}}
  @media(prefers-reduced-motion:reduce){.rep-frame{transition:none;}}
  /* Data-driven customer-service icons — full-size, centered on top of each card */
  .why-grid article{text-align:center;}
  .why-icon-img{width:min(82%,190px);height:auto;aspect-ratio:1/1;object-fit:contain;display:block;margin:2px auto 14px;filter:drop-shadow(0 10px 18px rgba(12,39,64,.14));transition:transform .18s ease;}
  .why-grid article:hover .why-icon-img{transform:translateY(-4px) scale(1.04);}
</style>

<section class="rep-band" aria-label="HomeCare Provider Services — HME &amp; DME Manufacturer Representation">
  <div class="container">
    <h1 class="rep-h1">Connecting {{ activeManufacturers.length }} Manufacturers to {{ site.stats.dealers }} Dealers Across Southern Ohio, Southern Indiana, Kentucky, Tennessee &amp; Georgia.</h1>
    <div class="rep-frame" id="rep-heroimg" role="img" aria-label="HME &amp; DME Manufacturer Representation — Your Partner. Your Growth. Connecting quality products with quality providers across the Ohio Valley and Southeast."><span class="rep-glare"></span></div>
    <div class="rep-copy">
      <h2>Your partner. Your growth.</h2>
      <p>{{ home.hero.lead1 }}</p>
      <div class="rep-actions">
        <a class="btn primary" href="/become-a-dealer/">Become a Dealer &rarr;</a>
        <a class="btn outline" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Explore Online Ordering</a>
        <a class="btn outline" href="/become-a-manufacturer-partner/">Become a Manufacturing Partner</a>
      </div>
    </div>
  </div>
</section>
<script>
(function () {
  var img = document.getElementById("rep-heroimg"); if (!img) return;
  var band = img.closest(".rep-band") || img.parentElement;
  var glare = img.querySelector(".rep-glare");
  var reduce = false; try { reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}
  if (reduce) return;
  band.addEventListener("mousemove", function (e) {
    var r = img.getBoundingClientRect();
    var px = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
    var py = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));
    var ry = (px - 0.5) * 14, rx = (0.5 - py) * 10;
    img.style.transform = "perspective(1500px) rotateY(" + ry + "deg) rotateX(" + rx + "deg) translateZ(20px)";
    if (glare) { glare.style.setProperty("--mx", (px * 100) + "%"); glare.style.setProperty("--my", (py * 100) + "%"); glare.style.opacity = "1"; }
  });
  band.addEventListener("mouseleave", function () {
    img.style.transform = "perspective(1500px) rotateY(0) rotateX(0)";
    if (glare) glare.style.opacity = "0";
  });
})();
</script>

<section class="credibility">
  <div class="container row">
    <span>&#9733; {{ site.tagline }}</span>
    <span>Since {{ site.founded }}</span>
    <span>{{ site.stats.dealers }} Active Dealers</span>
    <span>{{ activeManufacturers.length }} Manufacturing Partners</span>
    <span>{{ site.territory.states_display }}</span>
  </div>
</section>

<section class="manu-band">
  <div class="container">
    <p class="label">Trusted by Leading Healthcare Manufacturers</p>
    <div class="logo-row">
      {% for m in activeManufacturers %}
      <div class="badge-logo" role="img" aria-label="{{ m.name }}">
        <img src="{{ m.logo }}" alt="{{ m.name }} logo" loading="lazy">
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section id="manufacturers">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ home.manufacturers_section.eyebrow }}</p>
      <h2>{{ home.manufacturers_section.title }}</h2>
      <p>{{ home.manufacturers_section.intro }}</p>
    </div>
    <div class="manu-grid">
      {% for m in activeManufacturers %}
      <article class="manu-card">
        <a href="/manufacturers/{{ m.id }}/" class="manu-logo-tile" style="background-image:url('{{ m.logo }}')" aria-label="{{ m.name }}"></a>
        <p class="cat">{{ m.category }}</p>
        <h3><a href="/manufacturers/{{ m.id }}/">{{ m.name }}</a></h3>
        <p>{{ m.description }}</p>
        <a class="visit" href="/manufacturers/{{ m.id }}/">View Products &amp; Documents &rarr;</a>
      </article>
      {% endfor %}
    </div>
    <div class="manu-note">
      <div>
        <strong>{{ home.manufacturers_section.order_note_title }}</strong>
        <span>{{ home.manufacturers_section.order_note_copy }}</span>
      </div>
      <a class="btn primary" href="{{ site.links.online_ordering }}" target="_blank" rel="noopener">Visit Our Online Ordering Page</a>
    </div>
  </div>
</section>

<section class="why">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">{{ home.why_section.eyebrow }}</p>
      <h2>{{ home.why_section.title }}</h2>
    </div>
    <div class="why-grid">
      {% for card in site.why_choose %}
      <article>
        {% if card.icon %}<img class="why-icon-img" src="{{ card.icon }}" alt="" loading="lazy">{% else %}<div class="why-icon{% if loop.index == 2 %} orange{% endif %}"></div>{% endif %}
        <h3>{{ card.title }}</h3>
        <p>{{ card.description }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="team" id="team">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">{{ home.team_section.eyebrow }}</p>
      <h2>{{ home.team_section.title }}</h2>
    </div>
    <div class="team-grid">
      {% for t in team %}
      <article class="team-card">
        {% if t.photo %}
        <div class="team-avatar has-photo" style="background-image:url('{{ t.photo }}')" role="img" aria-label="{{ t.name }}"></div>
        {% else %}
        <div class="team-avatar">{{ t.name[0] }}</div>
        {% endif %}
        <h3>{{ t.name }}</h3>
        <p class="team-role">{{ t.role }}</p>
        <a href="tel:{{ t.phone_href }}">{{ t.phone_display }}</a>
        <a href="mailto:{{ t.email }}">{{ t.email }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="testimonials">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">{{ home.testimonials_section.eyebrow }}</p>
      <h2>{{ home.testimonials_section.title }}</h2>
    </div>
    <div class="testimonial-grid">
      {% for t in testimonials %}
      <article class="testimonial-card">
        <p class="quote">&ldquo;{{ t.quote }}&rdquo;</p>
        <div class="testimonial-who"><strong>{{ t.name }}</strong><span>{{ t.role }}</span></div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="territory" id="territory">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ home.territory_section.eyebrow }}</p>
      <h2>{{ site.stats.states }} States. {{ site.stats.dealers }} Dealers. {{ activeManufacturers.length }} Manufacturer Partners.</h2>
      <p>HomeCare Provider Services serves dealers across {{ site.territory.states_display | replace(" &bull; ", ", ") }} &mdash; with regional consultants on the ground in each territory.</p>
    </div>
    <div class="territory-layout">
      <aside class="territory-copy">
        <h3>{{ home.territory_section.coverage_title }}</h3>
        <p>{{ home.territory_section.coverage_copy }}</p>
        <div class="territory-stats">
          <span><strong>{{ site.stats.states }}</strong>States</span>
          <span><strong>{{ site.stats.dealers }}</strong>Dealers</span>
          <span><strong>{{ activeManufacturers.length }}</strong>Manufacturers</span>
        </div>
        <div class="region-list">
          <h4>Regional Coverage</h4>
          <ul>
            {% for r in site.territory.regions %}
            <li><strong>{{ r.name }}</strong><span>{{ r.rep }}</span></li>
            {% endfor %}
          </ul>
        </div>
      </aside>
      <div class="map-card">
        <div id="hcps-us-map"></div>
        <div class="map-legend">
          <span><i></i>Covered Territory</span>
          <span><i class="future"></i>Future Expansion</span>
          <span><i class="gray"></i>Not Currently Covered</span>
        </div>
      </div>
      <aside class="state-panel">
        <p class="eyebrow">State Detail</p>
        <h3 id="hcps-state-name">Hover a State</h3>
        <p id="hcps-state-status">Covered states are shown in blue. Future expansion opportunities are shown in orange.</p>
      </aside>
    </div>
  </div>
</section>

<section class="cta" id="become-a-dealer">
  <div class="container cta-grid">
    <div>
      <h2>{{ home.cta_section.title }}</h2>
      <p>{{ home.cta_section.copy }}</p>
    </div>
    <div class="hero-actions">
      <a class="btn primary" href="/resources/">Download Credit Application</a>
      <a class="btn outline" href="mailto:{{ site.contact.email }}">Contact Us</a>
    </div>
  </div>
</section>

<script src="https://cdn.amcharts.com/lib/5/index.js"></script>
<script src="https://cdn.amcharts.com/lib/5/map.js"></script>
<script src="https://cdn.amcharts.com/lib/5/geodata/usaLow.js"></script>
<script src="https://cdn.amcharts.com/lib/5/themes/Animated.js"></script>
<script>
(function () {
  var covered = {{ site.territory.covered_state_codes | dump | safe }};
  var future = {{ site.territory.expansion_state_codes | dump | safe }};
  function initMap() {
    var el = document.getElementById("hcps-us-map");
    if (!el || typeof am5 === "undefined") return;
    var root = am5.Root.new("hcps-us-map");
    root.setThemes([am5themes_Animated.new(root)]);
    var chart = root.container.children.push(am5map.MapChart.new(root, {
      panX: "none", panY: "none", wheelX: "none", wheelY: "none",
      projection: am5map.geoAlbersUsa()
    }));
    var series = chart.series.push(am5map.MapPolygonSeries.new(root, { geoJSON: am5geodata_usaLow }));
    series.mapPolygons.template.setAll({
      tooltipText: "{name}", interactive: true,
      stroke: am5.color(0x111820), strokeWidth: 1.2,
      fill: am5.color(0x3a4048), cursorOverStyle: "pointer"
    });
    series.mapPolygons.template.adapters.add("fill", function (fill, target) {
      var id = target.dataItem && target.dataItem.dataContext && target.dataItem.dataContext.id;
      if (covered.indexOf(id) > -1) return am5.color(0x1681c2);
      if (future.indexOf(id) > -1) return am5.color(0xef6325);
      return am5.color(0x3a4048);
    });
    series.mapPolygons.template.states.create("hover", {
      fill: am5.color(0xfcb21e), stroke: am5.color(0xffffff), strokeWidth: 2
    });
    series.mapPolygons.template.events.on("pointerover", function (ev) {
      var d = ev.target.dataItem.dataContext;
      var status = "Not currently covered.";
      if (covered.indexOf(d.id) > -1) {
        status = (d.id === "US-OH" || d.id === "US-IN")
          ? "Active HCPS territory \u2014 concentrated in southern " + d.name + "."
          : "Active HCPS distribution territory \u2014 " + d.name + " dealers order directly through us.";
      } else if (future.indexOf(d.id) > -1) {
        status = "Future expansion opportunity for HCPS.";
      }
      document.getElementById("hcps-state-name").textContent = d.name;
      document.getElementById("hcps-state-status").textContent = status;
    });
    series.events.on("datavalidated", function () { chart.goHome(); });
    chart.appear(800, 100);
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initMap);
  else initMap();
})();
</script>
