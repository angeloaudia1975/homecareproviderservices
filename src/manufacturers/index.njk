---
layout: layouts/base.njk
title: Manufacturers
permalink: /manufacturers/
description: "HomeCare Provider Services is the authorized sales representative for innovative HME & DME manufacturers — products and programs that expand your offerings, strengthen your showroom, and add value for your customers."
---
<style>
  /* Depth hero: banner (interactive 3D tilt) -> headline -> buttons — shared site pattern */
  .mfp-hero{background:linear-gradient(150deg,#0b1f33 0%,#0f5c8f 62%,#1681c2 100%);color:#fff;padding:52px 0 50px;position:relative;overflow:hidden;perspective:1500px;}
  .mfp-hero::after{content:"";position:absolute;right:-120px;top:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(252,178,30,.26),transparent 68%);pointer-events:none;}
  .mfp-hero .container{position:relative;z-index:1;}
  .mfp-hero-img{position:relative;max-width:1000px;margin:0 auto;border-radius:18px;overflow:hidden;aspect-ratio:1672/941;background:url("/assets/manufacturers/hero-banner.jpg") center/cover;box-shadow:0 45px 85px -22px rgba(0,0,0,.6);transform-style:preserve-3d;transition:transform .18s ease-out;will-change:transform;}
  .mfp-hero-glare{position:absolute;inset:0;pointer-events:none;background:radial-gradient(300px 300px at var(--mx,50%) var(--my,30%),rgba(255,255,255,.28),transparent 60%);mix-blend-mode:screen;opacity:0;transition:opacity .2s;}
  .mfp-hero-copy{max-width:1040px;margin:30px auto 0;text-align:center;}
  .mfp-hero-copy h1{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;white-space:nowrap;font-size:clamp(22px,3.6vw,40px);line-height:1.05;margin:0 0 12px;color:#fff;}
  .mfp-hero-copy p{margin:0 auto 22px;max-width:720px;font-size:clamp(15px,1.4vw,17.5px);line-height:1.6;color:rgba(255,255,255,.92);}
  .mfp-actions{display:flex;gap:11px;flex-wrap:wrap;justify-content:center;}
  .mfp-btn{display:inline-flex;align-items:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:800;font-size:14.5px;text-decoration:none;border-radius:11px;padding:13px 22px;transition:transform .12s;border:1px solid transparent;}
  .mfp-btn:hover{transform:translateY(-1px);}
  .mfp-btn.primary{background:linear-gradient(100deg,#ef6325,#fcb21e);color:#141414;box-shadow:0 14px 30px -12px rgba(239,99,37,.7);}
  .mfp-btn.ghost{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.30);}
  .mfp-btn.ghost:hover{background:rgba(255,255,255,.16);}
  @media(max-width:600px){.mfp-hero-copy h1{white-space:normal;}}
  @media(prefers-reduced-motion:reduce){.mfp-hero-img{transition:none;}}

  /* Strong-statement pillars (text version of the banner's three promises) */
  .mfp-pillars{padding:38px 0 6px;}
  .mfp-pillars-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  @media(max-width:760px){.mfp-pillars-grid{grid-template-columns:1fr;}}
  .mfp-pill{background:#fff;border:1px solid #e5e9ee;border-radius:18px;padding:24px 22px 26px;text-align:center;box-shadow:0 12px 34px rgba(12,39,64,.06);transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease;}
  .mfp-pill:hover{transform:translateY(-6px);box-shadow:0 30px 60px rgba(12,39,64,.14);border-color:#cfe0ef;}
  /* Big icon on top — full card width (matches other HCPS pages) */
  .mfp-pill .ic{width:100%;height:auto;background:none;border-radius:0;display:block;margin:0 0 14px;}
  .mfp-pill .ic img{display:block;width:82%;max-width:190px;margin:0 auto;aspect-ratio:1/1;object-fit:contain;filter:drop-shadow(0 10px 18px rgba(12,39,64,.14));transition:transform .18s ease;}
  .mfp-pill:hover .ic img{transform:translateY(-4px) scale(1.05);}
  .mfp-pill .ic::after{content:"";display:block;height:4px;width:56px;margin:12px auto 0;border-radius:3px;background:var(--hcps-blue,#1681c2);}
  .mfp-pill h3{font-family:'Archivo',sans-serif;font-weight:800;font-size:18px;color:var(--ink);margin:0 0 7px;}
  .mfp-pill p{font-size:14px;line-height:1.55;color:#55606a;margin:0;}

  /* Manufacturer grid section head */
  .mfp-grid-sec{padding:34px 0 52px;}
  .mfp-grid-head{margin:0 0 20px;}
  .mfp-grid-head .eyebrow{font-family:'Archivo',sans-serif;font-weight:800;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--hcps-blue,#1681c2);margin:0 0 8px;}
  .mfp-grid-head h2{font-family:'Archivo Expanded','Archivo',sans-serif;font-weight:800;font-size:clamp(22px,2.7vw,32px);line-height:1.1;color:var(--ink);margin:0 0 8px;}
  .mfp-grid-head p{font-size:15.5px;line-height:1.55;color:#48525c;margin:0;max-width:74ch;}
</style>

<!-- DEPTH HERO -->
<section class="mfp-hero">
  <div class="container">
    <div class="mfp-hero-img" id="mfp-heroimg" role="img" aria-label="HomeCare Provider Services Manufacturing Partners — strong partnerships, innovative products, and better solutions for dealers, representing HME and DME manufacturers across lift chairs, mobility, wheelchairs, ramps, bath safety, oxygen, and respiratory."><span class="mfp-hero-glare"></span></div>
    <div class="mfp-hero-copy">
      <h1>Strong partnerships. Better solutions.</h1>
      <p>HomeCare Provider Services is the authorized sales representative for the manufacturers below — innovative products and programs that expand your offerings, strengthen your showroom, and add value for your customers.</p>
      <div class="mfp-actions">
        <a class="mfp-btn primary" href="#manufacturers">Browse Our Manufacturers &rarr;</a>
        <a class="mfp-btn ghost" href="/resources/">Explore Resources</a>
        <a class="mfp-btn ghost" href="/become-a-dealer/">Become a Dealer</a>
      </div>
    </div>
  </div>
</section>
<script>
(function () {
  var img = document.getElementById("mfp-heroimg"); if (!img) return;
  var band = img.closest(".mfp-hero") || img.parentElement;
  var glare = img.querySelector(".mfp-hero-glare");
  var reduce = false; try { reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}
  if (reduce) return;
  band.addEventListener("mousemove", function (e) {
    var r = img.getBoundingClientRect();
    var px = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width));
    var py = Math.max(0, Math.min(1, (e.clientY - r.top) / r.height));
    var ry = (px - 0.5) * 14, rx = (0.5 - py) * 10;
    img.style.transform = "perspective(1500px) rotateY(" + ry + "deg) rotateX(" + rx + "deg) translateZ(20px)";
    if (glare) { glare.style.setProperty("--mx", (px * 100) + "%"); glare.style.setProperty("--my", (py * 100) + "%"); glare.style.opacity = "1"; }
  });
  band.addEventListener("mouseleave", function () {
    img.style.transform = "perspective(1500px) rotateY(0) rotateX(0)";
    if (glare) glare.style.opacity = "0";
  });
})();
</script>

<!-- STRONG-STATEMENT PILLARS -->
<section class="mfp-pillars">
  <div class="container">
    <div class="mfp-pillars-grid">
      <div class="mfp-pill" data-reveal="up">
        <div class="ic" aria-hidden="true"><img src="/assets/manufacturers/pillar-partnerships.png" alt="" loading="lazy"></div>
        <h3>Strong Manufacturer Partnerships</h3>
        <p>Authorized representation for HME &amp; DME manufacturers, backed by dedicated field sales, training, and dealer support.</p>
      </div>
      <div class="mfp-pill" data-reveal="up" style="--d:110ms">
        <div class="ic" aria-hidden="true"><img src="/assets/manufacturers/pillar-innovative.png" alt="" loading="lazy"></div>
        <h3>Innovative Products</h3>
        <p>Carefully selected lines across lift chairs, mobility, wheelchairs, ramps, bath safety, oxygen, and respiratory therapy.</p>
      </div>
      <div class="mfp-pill" data-reveal="up" style="--d:220ms">
        <div class="ic" aria-hidden="true"><img src="/assets/manufacturers/pillar-solutions.png" alt="" loading="lazy"></div>
        <h3>Better Solutions for Dealers</h3>
        <p>Products and programs that expand your offerings, strengthen your showroom, and deliver greater value to your customers.</p>
      </div>
    </div>
  </div>
</section>

<!-- MANUFACTURER GRID -->
<section class="mfp-grid-sec" id="manufacturers">
  <div class="container">
    <div class="mfp-grid-head">
      <p class="eyebrow">Our Manufacturing Partners</p>
      <h2>{{ activeManufacturers.length }} manufacturers. One representation team.</h2>
      <p>Explore each partner's products, catalogs, and dealer resources. HomeCare Provider Services is the authorized sales representative for every manufacturer listed below.</p>
    </div>
    <div class="partner-grid">
      {% for m in activeManufacturers %}
      <button type="button" class="partner-card"
              data-card="/assets/manufacturers/partners/{{ m.id }}.jpg"
              data-name="{{ m.name }}"
              data-url="/manufacturers/{{ m.id }}/"
              aria-label="{{ m.name }} — enlarge partner card">
        <img src="/assets/manufacturers/partners/{{ m.id }}.jpg" alt="{{ m.name }} — HomeCare Provider Services manufacturer partner" loading="lazy" width="1100" height="1100">
        <span class="partner-hint" aria-hidden="true">Click to enlarge</span>
      </button>
      {% endfor %}
    </div>
  </div>

  <!-- Manufacturer partner-card lightbox -->
  <div class="pcard-lightbox" id="pcardLightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Manufacturer partner card">
    <div class="pcard-backdrop" data-close></div>
    <div class="pcard-dialog">
      <button type="button" class="pcard-close" data-close aria-label="Close">&times;</button>
      <img id="pcardImg" src="" alt="">
      <a id="pcardLearn" class="pcard-learn" href="#">Learn More &rarr;</a>
    </div>
  </div>

  {% raw %}
  <style>
    #manufacturers .partner-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:30px;margin-top:10px;}
    @media(max-width:760px){ #manufacturers .partner-grid{grid-template-columns:1fr;gap:22px;} }
    .partner-card{display:block;padding:0;border:0;background:transparent;cursor:pointer;border-radius:20px;position:relative;overflow:hidden;
      box-shadow:0 30px 60px -26px rgba(16,38,63,.55),0 8px 22px rgba(16,38,63,.12);
      transition:transform .24s cubic-bezier(.2,.7,.2,1),box-shadow .24s;will-change:transform;}
    .partner-card img{display:block;width:100%;height:auto;border-radius:20px;}
    .partner-card:hover,.partner-card:focus-visible{transform:translateY(-9px) scale(1.012);
      box-shadow:0 50px 92px -22px rgba(16,38,63,.62),0 14px 30px rgba(16,38,63,.17);outline:none;}
    .partner-card:focus-visible{box-shadow:0 0 0 3px var(--hcps-orange,#F5821F),0 50px 92px -22px rgba(16,38,63,.62);}
    .partner-hint{position:absolute;bottom:14px;right:14px;background:rgba(16,38,63,.85);color:#fff;font-size:12px;font-weight:700;
      letter-spacing:.4px;padding:7px 14px;border-radius:22px;opacity:0;transform:translateY(7px);transition:opacity .2s,transform .2s;pointer-events:none;}
    .partner-card:hover .partner-hint,.partner-card:focus-visible .partner-hint{opacity:1;transform:none;}
    .pcard-lightbox{position:fixed;inset:0;z-index:1200;display:none;align-items:center;justify-content:center;padding:24px;}
    .pcard-lightbox.open{display:flex;}
    .pcard-backdrop{position:absolute;inset:0;background:rgba(9,18,31,.82);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);}
    .pcard-dialog{position:relative;max-width:min(760px,93vw);display:flex;flex-direction:column;align-items:center;animation:pcardIn .28s cubic-bezier(.2,.7,.2,1);}
    @keyframes pcardIn{from{opacity:0;transform:translateY(16px) scale(.96);}to{opacity:1;transform:none;}}
    .pcard-dialog img{width:100%;height:auto;max-height:80vh;object-fit:contain;border-radius:18px;box-shadow:0 40px 90px rgba(0,0,0,.55);background:#fff;}
    .pcard-close{position:absolute;top:-16px;right:-16px;width:42px;height:42px;border-radius:50%;background:#fff;border:0;font-size:22px;line-height:1;
      font-weight:700;color:#10263f;cursor:pointer;box-shadow:0 8px 22px rgba(0,0,0,.4);z-index:2;}
    .pcard-close:hover{background:#f0f3f7;}
    .pcard-learn{margin-top:20px;display:inline-flex;align-items:center;gap:8px;background:var(--hcps-orange,#F5821F);color:#fff;font-weight:800;
      font-size:16px;padding:14px 32px;border-radius:12px;box-shadow:0 14px 32px rgba(245,130,31,.45);text-decoration:none;transition:background .16s,transform .16s;}
    .pcard-learn:hover{background:#d96f14;transform:translateY(-2px);}
    @media(max-width:760px){ .pcard-close{top:6px;right:6px;} }
    @media(prefers-reduced-motion:reduce){.partner-card,.pcard-learn{transition:none;}.pcard-dialog{animation:none;}}
  </style>
  <script>
  (function(){
    var lb=document.getElementById('pcardLightbox');if(!lb)return;
    var img=document.getElementById('pcardImg'),learn=document.getElementById('pcardLearn'),lastFocus=null;
    function open(card){lastFocus=card;img.src=card.getAttribute('data-card');img.alt=card.getAttribute('data-name')+' — HomeCare Provider Services manufacturer partner card';
      learn.href=card.getAttribute('data-url');lb.classList.add('open');lb.setAttribute('aria-hidden','false');document.body.style.overflow='hidden';learn.focus();}
    function close(){lb.classList.remove('open');lb.setAttribute('aria-hidden','true');document.body.style.overflow='';img.src='';if(lastFocus)lastFocus.focus();}
    document.querySelectorAll('#manufacturers .partner-card').forEach(function(c){c.addEventListener('click',function(){open(c);});});
    lb.querySelectorAll('[data-close]').forEach(function(x){x.addEventListener('click',close);});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&lb.classList.contains('open'))close();});
  })();
  </script>
  {% endraw %}
</section>

