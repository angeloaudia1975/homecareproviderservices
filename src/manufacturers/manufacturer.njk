---
layout: layouts/base.njk
pagination:
  data: manufacturers
  size: 1
  alias: manu
permalink: "/manufacturers/{{ manu.id }}/"
eleventyComputed:
  title: "{{ manu.name }}"
  description: "{{ manu.description }}"
---
{% set accent = manu.brand.accent or "#1681c2" %}
{% set dark = manu.brand.dark or "#0b0d0f" %}

{% if manu.sections.length %}
  {% for b in manu.sections %}
    {% include "blocks/" + b.type + ".njk" %}
  {% endfor %}
{% else %}
  {% set b = { headline: manu.name, lead: manu.description } %}
  {% include "blocks/hero.njk" %}
{% endif %}

<section><div class="container">
  <div class="section-head">
    <p class="eyebrow">Documents &amp; Resources</p>
    <h2>{{ manu.name }} literature and forms</h2>
  </div>
  {% set manuDocs = documents.items | byManufacturer(manu.id) %}
  {% if manuDocs.length %}
    <div class="doc-grid">{% for doc in manuDocs %}
      <article class="doc-card">
        <span class="doc-type">{{ doc.type | typeLabel(documents.types) }}</span>
        <h3>{{ doc.title }}</h3><p>{{ doc.description }}</p>
        {% if doc.access == "public" %}
          <a class="doc-link" href="{{ doc.url or doc.file }}" target="_blank" rel="noopener">{% if doc.format == "video" %}Watch video &rarr;{% else %}Download {{ doc.format | upper }} &rarr;{% endif %}</a>
        {% elif doc.access == "dealer" %}<span class="doc-locked">Dealer login required</span>
        {% else %}<span class="doc-locked">Account-specific &mdash; contact your rep</span>{% endif %}
      </article>{% endfor %}</div>
  {% else %}
    <p class="doc-empty">Literature for {{ manu.name }} is being added. Contact
      <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>.</p>
  {% endif %}
</div></section>

<section class="why"><div class="container">
  <div class="section-head center">
    <p class="eyebrow">HCPS Dealer Support</p>
    <h2>Support tools for faster adoption</h2>
  </div>
  <div class="why-grid">{% for t in site.dealer_support_tools %}
    <article><h3>{{ t.title }}</h3><p>{{ t.description }}</p></article>{% endfor %}</div>
</div></section>

<section class="cta"><div class="container cta-grid">
  <div>
    <h2>Ready to build your {{ manu.name }} showroom strategy?</h2>
    <p>Request dealer pricing, product recommendations, showroom planning, or a training session for your team.</p>
  </div>
  <div class="hero-actions">
    <a class="btn primary" href="/contact/?topic=Dealer&manufacturer={{ manu.id }}">Become a Dealer Today</a>
    <a class="btn outline" href="/become-a-dealer/?manufacturer={{ manu.id }}">Contact Your Rep</a>
    <a class="btn outline" href="/manufacturers/">All Manufacturers</a>
  </div>
</div></section>
